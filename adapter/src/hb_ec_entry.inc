/* Raw ARM64EC ingress/egress for this candidate only.
 * Context offsets are asserted in cpu.c. x16/x17 are transition scratch.
 * Every path abandons its emulator C frame before resuming guest/native code;
 * native calls are never made while a suspended emulator frame remains live.
 * No general asynchronous unwind/suspend support is claimed by this fixture. */
__asm__(
    ".text\n"
    ".p2align 2\n"
    ".globl DispatchJump\n"
    "DispatchJump:\n"
    "str x30, [sp, #-8]!\n"
    "b hb_capture_entry\n"
    ".p2align 2\n"
    ".globl ExitToX64\n"
    "ExitToX64:\n"
    "str x30, [sp, #-8]!\n"
    "b hb_capture_entry\n"
    ".p2align 2\n"
    ".globl RetToEntryThunk\n"
    "RetToEntryThunk:\n"
    "mov x9, x30\n"
    "b hb_capture_entry\n"
    ".p2align 2\n"
    "hb_capture_entry:\n"
    "mov x16, sp\n"
    "ldr x17, [x18, #0x1788]\n"
    "ldr x17, [x17, #8]\n"
    "sub x17, x17, #0x400\n"
    "stp x0, x1, [x17, #8]\n"
    "stp x2, x3, [x17, #24]\n"
    "stp x4, x5, [x17, #40]\n"
    "stp x6, x7, [x17, #56]\n"
    "stp x8, x9, [x17, #72]\n"
    "stp x10, x11, [x17, #88]\n"
    "str x12, [x17, #104]\n"
    "str x15, [x17, #128]\n"
    "stp x16, x17, [x17, #136]\n"
    "stp x18, x19, [x17, #152]\n"
    "stp x20, x21, [x17, #168]\n"
    "str x22, [x17, #184]\n"
    "str x25, [x17, #208]\n"
    "stp x26, x27, [x17, #216]\n"
    "str x29, [x17, #240]\n"
    "str x30, [x17, #0xf8]\n"
    "str x16, [x17, #0x100]\n"
    "str x9, [x17, #0x108]\n"
    "stp q0, q1, [x17, #272]\n"
    "stp q2, q3, [x17, #304]\n"
    "stp q4, q5, [x17, #336]\n"
    "stp q6, q7, [x17, #368]\n"
    "stp q8, q9, [x17, #400]\n"
    "stp q10, q11, [x17, #432]\n"
    "stp q12, q13, [x17, #464]\n"
    "stp q14, q15, [x17, #496]\n"
    "mov w16, #7\n"
    "movk w16, #0x40, lsl #16\n"
    "str w16, [x17]\n"
    "mrs x16, nzcv\n"
    "str w16, [x17, #4]\n"
    "mrs x16, fpcr\n"
    "str w16, [x17, #0x310]\n"
    "mrs x16, fpsr\n"
    "str w16, [x17, #0x314]\n"
    "mov sp, x17\n"
    "mov x0, x17\n"
    "b \"#hb_ec_enter\"\n"
    ".p2align 2\n"
    ".globl BeginSimulation\n"
    "BeginSimulation:\n"
    "ldr x16, [x18, #0x1788]\n"
    "ldr x16, [x16, #8]\n"
    "mov sp, x16\n"
    "b \"#hb_simulate\"\n"
);

void __attribute__((naked, noreturn)) WINAPI hb_restore_ec(const ARM64_NT_CONTEXT *context)
{
    __asm__(
    "mov x16, x0\n"
    "ldr w17, [x16, #4]\n"
    "msr nzcv, x17\n"
    "ldr w17, [x16, #0x310]\n"
    "msr fpcr, x17\n"
    "ldr w17, [x16, #0x314]\n"
    "msr fpsr, x17\n"
    "ldp q0, q1, [x16, #272]\n"
    "ldp q2, q3, [x16, #304]\n"
    "ldp q4, q5, [x16, #336]\n"
    "ldp q6, q7, [x16, #368]\n"
    "ldp q8, q9, [x16, #400]\n"
    "ldp q10, q11, [x16, #432]\n"
    "ldp q12, q13, [x16, #464]\n"
    "ldp q14, q15, [x16, #496]\n"
    "ldp x0, x1, [x16, #8]\n"
    "ldp x2, x3, [x16, #24]\n"
    "ldp x4, x5, [x16, #40]\n"
    "ldp x6, x7, [x16, #56]\n"
    "ldp x8, x9, [x16, #72]\n"
    "ldp x10, x11, [x16, #88]\n"
    "ldr x12, [x16, #0x68]\n"
    "ldr x15, [x16, #0x80]\n"
    "ldp x19, x20, [x16, #0xa0]\n"
    "ldp x21, x22, [x16, #0xb0]\n"
    "ldp x25, x26, [x16, #0xd0]\n"
    "ldr x27, [x16, #0xe0]\n"
    "ldp x29, x30, [x16, #0xf0]\n"
    "ldr x17, [x16, #0x100]\n"
    "mov sp, x17\n"
    "ldr x17, [x16, #0x108]\n"
    "br x17\n"
    );
}
