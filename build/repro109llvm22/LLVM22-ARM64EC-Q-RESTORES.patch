+; RUN: llc -mtriple=arm64ec-pc-windows-msvc -verify-machineinstrs %s -o %t.default
+; RUN: llc -mtriple=arm64ec-pc-windows-msvc -verify-machineinstrs -aarch64-arm64ec-split-thunk-q-restores=false %s -o %t.off
+; RUN: diff %t.default %t.off
+; RUN: FileCheck %s --check-prefixes=COMMON,PAIRED < %t.default
+; RUN: llc -mtriple=arm64ec-pc-windows-msvc -verify-machineinstrs -aarch64-arm64ec-split-thunk-q-restores %s -o %t.on
+; RUN: FileCheck %s --check-prefixes=COMMON,SPLIT < %t.on
+; RUN: llc -mtriple=arm64ec-pc-windows-msvc -verify-machineinstrs -aarch64-arm64ec-split-thunk-q-restores -filetype=obj %s -o %t.obj
+; RUN: llvm-readobj --unwind %t.obj > %t.unwind
+; RUN: llc -mtriple=arm64ec-pc-windows-msvc -verify-machineinstrs -aarch64-arm64ec-split-thunk-q-restores -filetype=obj %S/arm64ec-entry-thunks.ll -o %t.signatures.obj
+; RUN: llvm-readobj --unwind %t.signatures.obj > %t.signatures.unwind
+; RUN: llc -mtriple=arm64ec-pc-windows-msvc -verify-machineinstrs -aarch64-arm64ec-split-thunk-q-restores %S/arm64ec-exit-thunks.ll | FileCheck %S/arm64ec-exit-thunks.ll
+; RUN: llc -mtriple=arm64ec-pc-windows-msvc -arm64ec-generate-thunks=false %s -o %t.native-off
+; RUN: llc -mtriple=arm64ec-pc-windows-msvc -arm64ec-generate-thunks=false -aarch64-arm64ec-split-thunk-q-restores %s -o %t.native-on
+; RUN: diff %t.native-off %t.native-on
+; RUN: llc -mtriple=aarch64-pc-windows-msvc %s -o %t.arm64-off
+; RUN: llc -mtriple=aarch64-pc-windows-msvc -aarch64-arm64ec-split-thunk-q-restores %s -o %t.arm64-on
+; RUN: diff %t.arm64-off %t.arm64-on
+
+; The option changes only the Q restores of x64-to-native entry thunks.
+; Spills, GPR restores, native bodies, and non-EC targets are controls.
+; The second signature checks a non-void return; the third keeps a paired
+; vector memory operation in an ordinary native body.
+
+define void @no_op() nounwind {
+; COMMON-LABEL: $ientry_thunk$cdecl$v$v:
+; COMMON:       stp q6, q7, [sp, #-176]!
+; COMMON-NEXT:  .seh_save_any_reg_px q6, 176
+; COMMON-NEXT:  stp q8, q9, [sp, #32]
+; COMMON-NEXT:  .seh_save_any_reg_p q8, 32
+; COMMON-NEXT:  stp q10, q11, [sp, #64]
+; COMMON-NEXT:  .seh_save_any_reg_p q10, 64
+; COMMON-NEXT:  stp q12, q13, [sp, #96]
+; COMMON-NEXT:  .seh_save_any_reg_p q12, 96
+; COMMON-NEXT:  stp q14, q15, [sp, #128]
+; COMMON-NEXT:  .seh_save_any_reg_p q14, 128
+; COMMON:       .seh_startepilogue
+; COMMON-NEXT:  ldp x29, x30, [sp, #160]
+; COMMON-NEXT:  .seh_save_fplr 160
+; PAIRED-NEXT:  ldp q14, q15, [sp, #128]
+; PAIRED-NEXT:  .seh_save_any_reg_p q14, 128
+; PAIRED-NEXT:  ldp q12, q13, [sp, #96]
+; PAIRED-NEXT:  .seh_save_any_reg_p q12, 96
+; PAIRED-NEXT:  ldp q10, q11, [sp, #64]
+; PAIRED-NEXT:  .seh_save_any_reg_p q10, 64
+; PAIRED-NEXT:  ldp q8, q9, [sp, #32]
+; PAIRED-NEXT:  .seh_save_any_reg_p q8, 32
+; PAIRED-NEXT:  ldp q6, q7, [sp], #176
+; PAIRED-NEXT:  .seh_save_any_reg_px q6, 176
+; SPLIT-NEXT:   ldr q14, [sp, #128]
+; SPLIT-NEXT:   .seh_save_any_reg q14, 128
+; SPLIT-NEXT:   ldr q15, [sp, #144]
+; SPLIT-NEXT:   .seh_save_any_reg q15, 144
+; SPLIT-NEXT:   ldr q12, [sp, #96]
+; SPLIT-NEXT:   .seh_save_any_reg q12, 96
+; SPLIT-NEXT:   ldr q13, [sp, #112]
+; SPLIT-NEXT:   .seh_save_any_reg q13, 112
+; SPLIT-NEXT:   ldr q10, [sp, #64]
+; SPLIT-NEXT:   .seh_save_any_reg q10, 64
+; SPLIT-NEXT:   ldr q11, [sp, #80]
+; SPLIT-NEXT:   .seh_save_any_reg q11, 80
+; SPLIT-NEXT:   ldr q8, [sp, #32]
+; SPLIT-NEXT:   .seh_save_any_reg q8, 32
+; SPLIT-NEXT:   ldr q9, [sp, #48]
+; SPLIT-NEXT:   .seh_save_any_reg q9, 48
+; SPLIT-NEXT:   ldr q7, [sp, #16]
+; SPLIT-NEXT:   .seh_save_any_reg q7, 16
+; SPLIT-NEXT:   ldr q6, [sp], #176
+; SPLIT-NEXT:   .seh_save_any_reg_x q6, 176
+; COMMON-NEXT:  .seh_endepilogue
+; COMMON-NEXT:  br x0
+  ret void
+}
+
+define i64 @return_integer(i64 %x) nounwind {
+; COMMON-LABEL: $ientry_thunk$cdecl$i8$i8:
+; COMMON:       .seh_startepilogue
+; COMMON-NEXT:  ldp x29, x30, [sp, #160]
+; COMMON-NEXT:  .seh_save_fplr 160
+; PAIRED-NEXT:  ldp q14, q15, [sp, #128]
+; SPLIT-NEXT:   ldr q14, [sp, #128]
+; SPLIT-NEXT:   .seh_save_any_reg q14, 128
+; SPLIT-NEXT:   ldr q15, [sp, #144]
+; SPLIT-NOT:    ldp q
+; COMMON:       .seh_endepilogue
+  ret i64 %x
+}
+
+define void @copy_vectors(ptr noalias %out, ptr noalias %in) nounwind {
+  %v = load <4 x i64>, ptr %in, align 16
+  store <4 x i64> %v, ptr %out, align 16
+  ret void
+}
+
+declare void @external() nounwind
+
+; This native body has an FPR64 spill/reload across a call. The no-thunks
+; comparison above also checks that ordinary D-register restores are unchanged.
+define double @retain_double(double %x) nounwind {
+  call void @external()
+  ret double %x
+}
