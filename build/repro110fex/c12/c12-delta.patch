index 0000000000000000000000000000000000000000..f660a1446871614a5e71d4a46ac76c47b20f3eaf
--- /dev/null
+++ b/FEXCore/include/FEXCore/Core/MacRunnerWinctx.h
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <cstdlib>
+#include <atomic>
+#include <cstdint>
+namespace FEXCore::Winctx {
+// Virtual AMD-compatible MXCSR: MM17 is implemented and advertised together.
+inline constexpr uint32_t MXCSRMask = 0x2ffffu;
+// Architectural FCW image after all user-mode x87 restore forms.  Reserved
+// bit6 reads one; bits7/13..15 read zero.  Keep exception masks, PC/RC and IC.
+// Measured on AMD by cw-load81 and cw-siblings85; Intel qualification pending.
+inline constexpr uint16_t ControlWordMask = 0x1f3f;
+inline constexpr uint16_t ControlWordFixedBits = 0x0040;
+inline constexpr uint16_t CanonicalControlWord(uint16_t Value) {
+  return (Value & ControlWordMask) | ControlWordFixedBits;
+}
+// Private synchronous-fault cause, not a hardware #GP selector/error code.
+// Windows reports vector alignment #GP as ACCESS_VIOLATION, unlike HLT/#GP.
+inline constexpr unsigned AlignmentGPError = 0x4000;
+// Private native-return transport, mirrored by the versioned FEX/Wine ABI.
+inline constexpr unsigned ReturnFlagsReadyOffset = 0xf20;
+inline constexpr unsigned ReturnPFAFOffset = 0xf24;
+inline constexpr unsigned ReturnNZCVOffset = 0xf2c;
+// Initialized at context creation, before translation/execution and signals.
+// SoftFloat helpers read this byte; no getenv or lazy initialization per op.
+inline std::atomic<bool> Enabled {false};
+inline void Initialize() {
+  const char* Value = std::getenv("MACRUNNER_WINCTX_EXACT");
+  Enabled.store(Value && Value[0] == '1' && !Value[1], std::memory_order_relaxed);
+}
+}
diff --git a/FEXCore/include/FEXCore/Utils/MacRunnerSuspend.h b/FEXCore/include/FEXCore/Utils/MacRunnerSuspend.h
new file mode 100644
index 0000000000000000000000000000000000000000..817a242975cd99749f61f41be02ec884a7ef5108
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/MacRunnerSuspend.h
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: MIT
+// Modifications (c) 2026 MacRunner contributors, MIT
+#pragma once
+#include <cstdlib>
+#include <cstdint>
+
+namespace FEXCore::Utils {
+// Read during IR construction/code generation, never from a signal handler.
+inline unsigned MacRunnerSuspendBackedgeMode() {
+#ifdef ARCHITECTURE_arm64ec
+  static const unsigned Mode = [] {
+    const char* Value = std::getenv("MACRUNNER_FEX_SUSPEND_BACKEDGE64");
+    return Value && (Value[0] == '1' || Value[0] == '2') && !Value[1]
+             ? static_cast<unsigned>(Value[0] - '0') : 0U;
+  }();
+  return Mode;
+#else
+  return 0;
+#endif
+}
+inline bool MacRunnerSuspendBackedgeEnabled() {
+  return MacRunnerSuspendBackedgeMode() != 0;
+}
+// Mode 1 keeps the existing guest-visible flag liveness; mode 2 also retains
+// flags that are dead for the guest but observable in a suspended context.
+inline bool MacRunnerSuspendBackedgeExactFlags() {
+  return MacRunnerSuspendBackedgeMode() == 2;
+}
+// Synthesized blocks inside one x86 instruction have no guest continuation PC.
+// Decoder-created blocks always supply an explicit relative guest address.
+inline constexpr uint32_t NoGuestSuspendBoundary = UINT32_MAX;
+}
