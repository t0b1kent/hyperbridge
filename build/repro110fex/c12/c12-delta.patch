+struct Cost {
+  uint64_t T0 {mrj_now()};
+  ~Cost() { __atomic_fetch_add(&CostTicks, mrj_now() - T0, __ATOMIC_RELAXED); __atomic_fetch_add(&CostCount, 1, __ATOMIC_RELAXED); }
+};
+
+inline mrj_rec* Open(unsigned Type, unsigned Slots, unsigned Flags, int32_t Status, uint32_t Aux, uint64_t& Idx) {
+  Idx = mrj_claim(&Ring, Slots);
+  return mrj_begin(&Ring, Idx, Type, Slots, Flags | MRJ_F_PE, Tid(), Status, Aux);
+}
+
+// Образ из состояния переводчика (то, из чего строится контекст, отдаваемый программе / принимаемый от неё).
+void FromThread(mrj_ctx64& O, FEXCore::Core::InternalThreadState* T) {
+  memset(&O, 0, sizeof O);
+  auto& S = T->CurrentFrame->State;
+  O.flags = 0x10001F; O.mxcsr = S.mxcsr;
+  O.cs = 0x33; O.ds = O.es = O.gs = O.ss = 0x2b; O.fs = 0x53;
+  O.eflags = CTX->ReconstructCompactedEFLAGS(T, false, nullptr, 0);
+  O.rax = S.gregs[FEXCore::X86State::REG_RAX]; O.rcx = S.gregs[FEXCore::X86State::REG_RCX]; O.rdx = S.gregs[FEXCore::X86State::REG_RDX]; O.rbx = S.gregs[FEXCore::X86State::REG_RBX];
+  O.rsp = S.gregs[FEXCore::X86State::REG_RSP]; O.rbp = S.gregs[FEXCore::X86State::REG_RBP]; O.rsi = S.gregs[FEXCore::X86State::REG_RSI]; O.rdi = S.gregs[FEXCore::X86State::REG_RDI];
+  O.r8 = S.gregs[FEXCore::X86State::REG_R8]; O.r9 = S.gregs[FEXCore::X86State::REG_R9]; O.r10 = S.gregs[FEXCore::X86State::REG_R10]; O.r11 = S.gregs[FEXCore::X86State::REG_R11];
+  O.r12 = S.gregs[FEXCore::X86State::REG_R12]; O.r13 = S.gregs[FEXCore::X86State::REG_R13]; O.r14 = S.gregs[FEXCore::X86State::REG_R14]; O.r15 = S.gregs[FEXCore::X86State::REG_R15];
+  O.rip = S.rip;
+  const unsigned Top = S.flags[FEXCore::X86State::X87FLAG_TOP_LOC] & 7;
+  O.x87_cw = S.FCW; O.x87_sw = static_cast<uint16_t>(Top << 11); O.x87_tw = S.AbridgedFTW;
+  alignas(16) __uint128_t Low[16], High[16];
+  CTX->ReconstructXMMRegisters(T, Low, High);
+  O.xmm_fp = mrj_fp(Low, 256);
+  uint8_t St[8][10];
+  for (unsigned I = 0; I < 8; ++I) memcpy(St[I], S.mm[(Top + I) & 7], 10);
+  O.st_fp = mrj_fp(St, 80);
+  O.ymm_fp = (::CPUFeatures && ::CPUFeatures->IsFeaturePresent(PF_AVX2_INSTRUCTIONS_AVAILABLE)) ? mrj_fp(High, 256) : 0;
+}
+
+// Образ из x64 CONTEXT (то, что программа получила или передала).
+void FromContext(mrj_ctx64& O, const CONTEXT& C) {
+  memset(&O, 0, sizeof O);
+  O.flags = C.ContextFlags; O.mxcsr = C.MxCsr;
+  O.cs = C.SegCs; O.ds = C.SegDs; O.es = C.SegEs; O.fs = C.SegFs; O.gs = C.SegGs; O.ss = C.SegSs; O.eflags = C.EFlags;
+  O.dr0 = C.Dr0; O.dr1 = C.Dr1; O.dr2 = C.Dr2; O.dr3 = C.Dr3; O.dr6 = C.Dr6; O.dr7 = C.Dr7;
+  O.rax = C.Rax; O.rcx = C.Rcx; O.rdx = C.Rdx; O.rbx = C.Rbx; O.rsp = C.Rsp; O.rbp = C.Rbp; O.rsi = C.Rsi; O.rdi = C.Rdi;
+  O.r8 = C.R8; O.r9 = C.R9; O.r10 = C.R10; O.r11 = C.R11; O.r12 = C.R12; O.r13 = C.R13; O.r14 = C.R14; O.r15 = C.R15; O.rip = C.Rip;
+  O.x87_cw = C.FltSave.ControlWord; O.x87_sw = C.FltSave.StatusWord; O.x87_tw = C.FltSave.TagWord;
+  O.x87_errop = C.FltSave.ErrorOpcode; O.x87_erroff = C.FltSave.ErrorOffset; O.x87_errsel = C.FltSave.ErrorSelector;
+  O.x87_dataoff = C.FltSave.DataOffset; O.x87_datasel = C.FltSave.DataSelector;
+  O.xmm_fp = mrj_fp(&C.FltSave.XmmRegisters[0], 256);
+  uint8_t St[8][10];
+  for (unsigned I = 0; I < 8; ++I) memcpy(St[I], &C.FltSave.FloatRegisters[I], 10);
+  O.st_fp = mrj_fp(St, 80);
+}
+
+}  // namespace
+
+bool Init(const char* Env) {
+  if (!Env || Env[0] != '1' || Env[1]) return false;
+  mrj_register Reg {};
+  const NTSTATUS Status = NtQuerySystemInformation(static_cast<SYSTEM_INFORMATION_CLASS>(MRJ_CLASS_REGISTER), &Reg, sizeof(Reg), nullptr);
+  if (Status || Reg.version != MRJ_VERSION || !Reg.file_base || !Reg.mask) return false;
+  Ring.f = reinterpret_cast<mrj_file*>(Reg.file_base);
+  Ring.slots = reinterpret_cast<uint8_t*>(Reg.file_base) + MRJ_FILE_HDR;
+  Ring.mask = Reg.mask;
+  __atomic_fetch_or(&Ring.f->halves, 2ULL, __ATOMIC_RELAXED);
+  On = 1;
+  return true;
+}
+
+// X64_ORIGIN47: p0 kind|flags<<32, p1 signal16|trap16|err32,
+// p2 raw guest RIP, p3 full RAX; flags bit0 generated, bit1 consumed service.
+__attribute__((cold, noinline)) void WriteOrigin(uint32_t Kind, uint32_t Flags, uint64_t FaultBits, uint64_t GuestRip, uint64_t Rax, uint32_t Ser) {
+  Cost JCost;
+  uint64_t Idx;
+  auto* Q = Open(MRJ_T_X64_ORIGIN, 1, 0, 0, Ser, Idx);
+  Q->p[0] = static_cast<uint64_t>(Kind) | (static_cast<uint64_t>(Flags) << 32);
+  Q->p[1] = FaultBits; Q->p[2] = GuestRip; Q->p[3] = Rax;
+  mrj_commit(&Ring, Idx);
+}
+
+__attribute__((cold, noinline)) void WriteExc(const EXCEPTION_RECORD& Rec, const ThreadView& View, uint32_t Ser, bool First) {
+  NoteMxcsr(View.Thread, 5);
+  Cost JCost;
+  uint64_t Idx;
+  auto* Q = Open(MRJ_T_X64_EXC, 8, First ? MRJ_F_FIRST : 0, static_cast<int32_t>(Rec.ExceptionCode), Ser, Idx);
+  Q->p[0] = static_cast<uint64_t>(Rec.ExceptionCode) | (static_cast<uint64_t>(Rec.ExceptionFlags) << 32);
+  Q->p[1] = reinterpret_cast<uint64_t>(Rec.ExceptionAddress); Q->p[2] = Rec.NumberParameters; Q->p[3] = Rec.NumberParameters ? Rec.ExceptionInformation[0] : 0;
+  ExtWrite(Idx, 0, &Rec, sizeof(EXCEPTION_RECORD));
+  mrj_ctx64 C; FromThread(C, View.Thread);
+  ExtWrite(Idx, 192, &C, sizeof C);
+  mrj_commit(&Ring, Idx);
+}
+
+__attribute__((cold, noinline)) void WriteGetFP(uint32_t Mxcsr, uint32_t Fcw, uint32_t Fsw, uint32_t Ftw, const uint8_t (*X87)[10], const ThreadView& View) {
+  NoteMxcsr(View.Thread, 6);
+  Cost JCost;
+  uint64_t Idx;
+  auto* Q = Open(MRJ_T_X64_GETCTX, 5, MRJ_F_SELF, 0, 0, Idx);
+  Q->p[0] = Tid(); Q->p[1] = 0x100008ULL | (0x100008ULL << 32);
+  mrj_ctx64 C; FromThread(C, View.Thread);
+  C.flags = 0x100008; C.mxcsr = Mxcsr; C.x87_cw = static_cast<uint16_t>(Fcw); C.x87_sw = static_cast<uint16_t>(Fsw); C.x87_tw = static_cast<uint8_t>(Ftw);
+  C.st_fp = mrj_fp(X87, 80);
+  ExtWrite(Idx, 0, &C, sizeof C);
+  mrj_commit(&Ring, Idx);
+}
+
+__attribute__((cold, noinline)) void WriteAbsorb(uint32_t Reason, uint64_t FaultAddress, uint64_t GuestRip, uint32_t Protect, uint32_t Access, uint32_t Decision) {
+  { auto CA = GetCPUArea(); if (CA.Area) NoteMxcsr(CA.ThreadState(), 4); }
+  Cost JCost;
+  uint64_t Idx;
+  auto* Q = Open(MRJ_T_ABSORB_P, 2, 0, 0, Decision, Idx);
+  Q->p[0] = Reason; Q->p[1] = FaultAddress; Q->p[2] = GuestRip; Q->p[3] = static_cast<uint64_t>(Protect) | (static_cast<uint64_t>(Access) << 32);
+  mrj_commit(&Ring, Idx);
+}
+
+__attribute__((cold, noinline)) void Mark(const char* Tag16, uint32_t Code, bool Sync) {
+  uint64_t Idx;
+  auto* Q = Open(MRJ_T_MARK, 1, 0, 0, static_cast<uint32_t>(CostCount), Idx);
+  Q->p[3] = CostTicks;
+  char Tag[16] {};
+  for (unsigned I = 0; I < 15 && Tag16[I]; ++I) Tag[I] = Tag16[I];
+  memcpy(&Q->p[0], Tag, 16); Q->p[2] = Code;   // p3 = тики CNTVCT, потраченные PE-половиной на записи; aux = число записей
+  mrj_commit(&Ring, Idx);
+  if (Sync) {
+    mrj_sync S {};
+    memcpy(S.tag, Tag, 16); S.code = Code;
+    NtQuerySystemInformation(static_cast<SYSTEM_INFORMATION_CLASS>(MRJ_CLASS_SYNC), &S, sizeof(S), nullptr);
+  }
+}
+
+// ---- контекст применён к потоку (SyncThreadContext): Set / Continue / возобновление. Свой serial — продолжение после исключения (43), иначе Set (41).
+__attribute__((cold, noinline)) void ApplyDone(const mrj_ctx64& Before, const CONTEXT& Given, uint32_t FlagsIn, FEXCore::Core::InternalThreadState* T) {
+  Cost JCost;
+  NoteMxcsr(T, 2);
+  mrj_ctx64 After; FromThread(After, T);
+  After.cs = Given.SegCs; After.ds = Given.SegDs; After.es = Given.SegEs; After.fs = Given.SegFs; After.gs = Given.SegGs; After.ss = Given.SegSs;
+  After.dr0 = Given.Dr0; After.dr1 = Given.Dr1; After.dr2 = Given.Dr2; After.dr3 = Given.Dr3; After.dr6 = Given.Dr6; After.dr7 = Given.Dr7;
+  After.flags = FlagsIn;
+  uint32_t Ser = 0;
+  if (auto* D = GetFrontendThreadData(T)) { Ser = D->JournalSerial; D->JournalSerial = 0; }
+  uint64_t Idx;
+  if (Ser) {
+    Open(MRJ_T_X64_CONT, 5, MRJ_F_SELF, 0, Ser, Idx);
+    ExtWrite(Idx, 0, &After, sizeof After);
+  } else {
+    auto* Q = Open(MRJ_T_X64_SETCTX, 9, MRJ_F_SELF, 0, 0, Idx);
+    Q->p[0] = Tid(); Q->p[1] = FlagsIn;
+    ExtWrite(Idx, 0, &Before, sizeof Before);
+    ExtWrite(Idx, 256, &After, sizeof After);
+  }
+  mrj_commit(&Ring, Idx);
+}
+
+__attribute__((cold, noinline)) void NoteMxcsr(FEXCore::Core::InternalThreadState* T, uint32_t Cause) {
+  if (!On || !T) return;
+  auto* D = GetFrontendThreadData(T);
+  if (!D) return;
+  const auto& F = *T->CurrentFrame;
+  const uint32_t Cur = F.State.mxcsr, Seq = F.MxcsrTraceSeq;
+  const bool First = !D->JournalMxcsrInit;
+  const bool SeqChanged = Seq != D->JournalMxcsrSeq;
+  const bool CtlChanged = ((Cur ^ D->JournalMxcsrSeen) & 0xffc0u) != 0;
+  if (!First && !SeqChanged && !CtlChanged) return;
+  Cost JCost;
+  uint64_t Idx;
+  auto* Q = Open(MRJ_T_X64_MXCSR, 1, MRJ_F_SELF, 0, F.MxcsrTraceOld, Idx);
+  Q->p[0] = static_cast<uint64_t>(First ? 7U : Cause) | (static_cast<uint64_t>(F.MxcsrTraceKind) << 8) | (SeqChanged ? 1ULL << 16 : 0) | (CtlChanged ? 1ULL << 17 : 0) | (static_cast<uint64_t>(F.MxcsrTraceNew) << 32);
+  Q->p[1] = D->JournalMxcsrInit ? D->JournalMxcsrSeen : 0xffffffffULL;
+  Q->p[2] = Cur;
+  Q->p[3] = SeqChanged ? F.MxcsrTraceRip : 0;
+  mrj_commit(&Ring, Idx);
+  D->JournalMxcsrInit = true; D->JournalMxcsrSeen = Cur; D->JournalMxcsrSeq = Seq;
+}
+
+__attribute__((cold, noinline)) void Snapshot(mrj_ctx64& Out, FEXCore::Core::InternalThreadState* T) { NoteMxcsr(T, 1); FromThread(Out, T); }
+
+}  // namespace FEX::Windows::MRJournal
diff --git a/Source/Windows/Common/Winctx.h b/Source/Windows/Common/Winctx.h
new file mode 100644
index 0000000000000000000000000000000000000000..e961b9b7a28689d0937a00cfc5338654a36dddc5
--- /dev/null
+++ b/Source/Windows/Common/Winctx.h
@@ -0,0 +1,130 @@
+/* MacRunner private FEX/Wine context transport. LGPL-2.1-or-later.
+ * Versioned tail of an owned native context/frame; never a Windows ABI field.
+ * The existing context/record offsets and disallowed ARM64EC registers stay intact.
+ */
+#ifndef MACRUNNER_WINCTX_ABI_H
+#define MACRUNNER_WINCTX_ABI_H
+#include <stdint.h>
+#define MR_WINCTX_ARM_FLAG 0x01000000u
+#define MR_WINCTX_TAIL_OFFSET 0x480u
+#define MR_WINCTX_MAGIC UINT64_C(0x315854434e49574d)
+#define MR_WINCTX_VERSION 1u
+#define MR_WINCTX_VALID_CONTROL 1u
+#define MR_WINCTX_VALID_FLOAT 2u
+#define MR_WINCTX_FP_SHADOW_OFFSET 0x800u
+#define MR_WINCTX_FP_SHADOW_MAGIC UINT64_C(0x325450465854434d)
+#define MR_WINCTX_VALID_YMM 4u
+#define MR_WINCTX_FP_QUERY_OFFSET 0x9a0u
+#define MR_WINCTX_FP_QUERY_MAGIC UINT64_C(0x315146505854434d)
+/* Capabilities use the existing reserved uint16 at offset14. Size48 and all
+   callbacks retain ABI4; older kernelbase consumers ignore the new capability. */
+#define MR_WINCTX_FP_QUERY_VERSION 4u
+#define MR_WINCTX_CAP_MISALIGNED_SSE 1u
+#define MR_WINCTX_VIRTUAL_MXCSR_MASK 0x2ffffu
+#define MR_WINCTX_GUEST_ENTRY_RSP_OFFSET 0x9d0u
+#define MR_WINCTX_GUEST_ENTRY_TARGET_OFFSET 0x9d8u
+#define MR_WINCTX_GUEST_ENTRY_XMM_OFFSET 0xa80u /* 0114: XMM0-5 гостя на входе в родной вызов, 6x16 байт; до 0xae0 (DEBUG кончается на 0xa50, NV_EDIT_MASK с 0xb00) */
+#define MR_WINCTX_CLOSE_RETURN_PENDING_OFFSET 0xf10u
+#define MR_WINCTX_CLOSE_RETURN_TARGET_OFFSET 0xf18u
+#define MR_WINCTX_RETURN_FLAGS_READY_OFFSET 0xf20u
+#define MR_WINCTX_RETURN_PFAF_OFFSET 0xf24u
+#define MR_WINCTX_RETURN_NZCV_OFFSET 0xf2cu
+/* Explicit AMD64 continuation edits must survive the compiler's native
+ * ARM64EC entry-thunk epilogue. It restores x29 and q6..q15 from its own
+ * earlier spills. Keep this payload outside native CONTEXT register aliases;
+ * FEX imports it only after that epilogue, on a return to guest code. */
+#define MR_WINCTX_NV_RETURN_OFFSET 0xc00u
+#define MR_WINCTX_NV_EDIT_MASK_OFFSET 0xb00u
+#define MR_WINCTX_NV_EDIT_MASK_VALID 0x80000000u
+#define MR_WINCTX_NV_RETURN_MAGIC UINT64_C(0x31564e585443524d)
+#define MR_WINCTX_NV_INTEGER 1u
+#define MR_WINCTX_NV_FLOAT 0x7feu /* individual bits1..10: XMM6..15 */
+struct mr_winctx_nv_return
+{
+    uint64_t magic;
+    uint32_t size;
+    uint16_t version;
+    uint16_t valid;
+    uint64_t native_sp; /* nested entry thunks below this frame cannot consume */
+    uint64_t rbp;
+    uint8_t xmm[10][16]; /* low 128 bits of XMM6..15 */
+};
+/* Stack-owned snapshot: x87 slots use logical ST(0)..ST(7), ten significant
+ * bytes and zero padding. No native ARM64EC register aliases are present. */
+struct mr_winctx_fp_snapshot
+{
+    uint32_t mxcsr;
+    uint16_t fcw;
+    uint16_t fsw;
+    uint8_t ftw;
+    uint8_t reserved[7];
+    uint8_t x87[8][16];
+};
+/* Initialized once by ThreadInit, outside signal dispatch.  The native leaf
+ * reads current virtual FP control; UINT32_MAX means no current guest state. */
+struct mr_winctx_fp_query
+{
+    uint64_t magic;
+    uint32_t size;
+    uint16_t version;
+    uint16_t capabilities;
+    uint64_t current_fcw;
+    uint64_t current_mxcsr;
+    uint64_t capture_fp;
+    uint64_t current_rsp;
+};
+struct mr_winctx_fp_shadow
+{
+    uint64_t magic;
+    uint32_t size;
+    uint16_t version;
+    uint16_t valid; /* release-published, consumed once by the same thread */
+    uint32_t mxcsr;
+    uint16_t fcw;
+    uint16_t fsw;
+    uint8_t ftw;
+    uint8_t reserved[7];
+    uint8_t x87[8][16];
+    uint8_t ymm[16][16];
+};
+/* Guest AMD64 DR state in the already owned first CHPE page.  Never ARM
+ * hardware breakpoints. Native server BVR/BCR arrays carry the same six words
+ * while a target is suspended or has not entered FEX yet. */
+#define MR_WINCTX_DEBUG_OFFSET 0xa00u
+#define MR_WINCTX_DEBUG_MAGIC UINT64_C(0x314742445854434d)
+#define MR_WINCTX_DEBUG_ARM_MAGIC 0x58444231u
+#define MR_WINCTX_DEBUG_VERSION 1u
+/* FEX-only continuation bookkeeping after the unchanged 64-byte wire state. */
+#define MR_WINCTX_DEBUG_SKIP_RIP_OFFSET 0xa40u
+#define MR_WINCTX_DEBUG_RF_PENDING_OFFSET 0xa48u
+struct mr_winctx_debug_state
+{
+    uint64_t magic;
+    uint32_t size;
+    uint16_t version;
+    uint16_t valid;
+    uint64_t dr[6]; /* DR0, DR1, DR2, DR3, DR6, DR7 */
+};
+
+/* Observed on both Windows AMD references in v5c80: a DEBUG Set with
+ * DR7==0 ignores DR0..3. Do not generalize to other reserved/control bits
+ * before the Windows policy matrix has been measured. */
+static inline void mr_winctx_debug_disabled_policy(uint64_t dr[6])
+{
+    if (dr[5] == 0) dr[0] = dr[1] = dr[2] = dr[3] = 0;
+}
+
+struct mr_winctx_tail
+{
+    uint64_t magic;
+    uint32_t size;
+    uint16_t version;
+    uint16_t valid;
+    uint32_t eflags;
+    uint32_t mxcsr;
+    uint16_t fcw;
+    uint16_t fsw;
+    uint8_t ftw;
+    uint8_t reserved[3];
+};
+#endif
diff --git a/Source/Windows/Common/macrunner_journal.h b/Source/Windows/Common/macrunner_journal.h
new file mode 100644
index 0000000000000000000000000000000000000000..784366451651043af8b6dff7032e1e9883a5e82b
--- /dev/null
+++ b/Source/Windows/Common/macrunner_journal.h
@@ -0,0 +1,169 @@
+/*
+ * MacRunner API journal — общий заголовок формата полного журнала (версия 1), 10.10.2026, CLAUDE-WW.
+ * Подключается ОДНИМ файлом и unix-частью ntdll (C), и PE-переводчиком xtajit64 (C++ ARM64EC): только <stdint.h>, никаких зависимостей от Wine/Windows.
+ *
+ * ЖУРНАЛ = файл-кольцо в каталоге MACRUNNER_API_JOURNAL_DIR, отображённый в память MAP_SHARED:
+ *   journal-<pid>-<имя образа>.ring ; 16 КБ заголовка (struct mrj_file) + кольцо из 2^k слотов по 64 байта.
+ *   Запись — обычные store в отображённую память + один атомарный счётчик: ни печати, ни системных вызовов. Данные принадлежат страничному кешу ядра,
+ *   поэтому ПЕРЕЖИВАЮТ падение и kill -9 процесса; сброс на диск делает ядро, отдельный поток раз в N секунд только просит msync(MS_ASYNC), при выходе/NoExec — MS_SYNC.
+ *   Кольцо хранит последние nslots*64 байт; head — живой указатель, поэтому файл разбирается в любой момент.
+ * ЗАПИСЬ состоит из 1..255 слотов; первый слот начинается с struct mrj_rec (32 байта заголовка + 32 байта данных p[4]); остальные слоты — сырые 64 байта e[8].
+ * Записи не пересекают конец кольца «целиком»: слот k записи лежит в (idx+k) & mask (оборот допустим внутри записи).
+ * ПУБЛИКАЦИЯ: пишущий делает fetch_add(head, n), заполняет ВСЕ слоты (неиспользуемые слова — нулём), и ПОСЛЕДНИМ release-ом пишет commit = idx+1 в первом слоте.
+ * Читатель принимает запись, только если commit == idx+1 (иначе запись не опубликована или перезаписана следующим оборотом).
+ */
+#ifndef MACRUNNER_JOURNAL_H
+#define MACRUNNER_JOURNAL_H
+#include <stdint.h>
+
+#define MRJ_VERSION     1u
+#define MRJ_SLOT        64u
+#define MRJ_FILE_HDR    16384u
+#define MRJ_MAGIC       0x31524a52434d524dULL   /* "MRCMRJR1" в порядке little-endian */
+
+/* Протокол между половинами (через NtQuerySystemInformation с номером класса, как у переписи; без ключа unix-часть вернёт STATUS_INVALID_INFO_CLASS) */
+#define MRJ_CLASS_REGISTER 0x4d524301u   /* PE -> unix: получить кольцо; struct mrj_register */
+#define MRJ_CLASS_SYNC     0x4d524302u   /* PE -> unix: msync(MS_SYNC) сейчас (NoExec / фатальный путь); info — необязательная метка (struct mrj_sync) */
+
+struct mrj_file {                        /* 16 КБ в начале файла */
+    uint64_t magic;
+    uint32_t version, slot_size;         /* MRJ_VERSION, 64 */
+    uint64_t nslots;                     /* число слотов кольца, степень двойки */
+    uint64_t head;                       /* ЖИВОЙ указатель: индекс следующего слота; обновлять только __atomic_fetch_add */
+    uint64_t cntfrq;                     /* частота CNTVCT_EL0, Гц */
+    uint64_t t0_cntvct;                  /* CNTVCT_EL0 при создании кольца */
+    uint64_t t0_unix_ns;                 /* время Unix (нс) при создании кольца */
+    uint32_t pid, ring_offset;           /* ring_offset = MRJ_FILE_HDR */
+    uint64_t halves;                     /* биты: 1 — писала unix-часть, 2 — PE-половина (ставит каждая при регистрации) */
+    uint64_t dropped;                    /* записи, потерянные из-за недоступного кольца */
+    char     proc[64];                   /* имя образа процесса */
+    uint8_t  pad[MRJ_FILE_HDR - 144];    /* до 16 КБ (размер проверяется ниже) */
+};
+
+struct mrj_register {                    /* ответ unix-части на MRJ_CLASS_REGISTER (PE выделяет и передаёт) */
+    uint64_t file_base;                  /* адрес struct mrj_file в этом же процессе (PE пишет в кольцо сам, без вызовов) */
+    uint64_t nslots, mask;
+    uint32_t version, tid_is_windows;
+};
+struct mrj_sync { char tag[16]; uint32_t code, pad; };
+
+struct mrj_rec {                         /* первый слот записи, 64 байта */
+    uint64_t commit;                     /* idx+1; пишется ПОСЛЕДНИМ (release) */
+    uint64_t t;                          /* CNTVCT_EL0 */
+    uint32_t tid;                        /* Windows TID потока (TEB->ClientId.UniqueThread) */
+    int32_t  status;                     /* NTSTATUS результата (0 — успех; для событий без результата 0) */
+    uint16_t type;                       /* MRJ_T_* */
+    uint8_t  nslots;                     /* число слотов записи, включая этот */
+    uint8_t  flags;                      /* MRJ_F_* */
+    uint32_t aux;                        /* зависит от типа (pid цели, серийный номер исключения, ...) */
+    uint64_t p[4];                       /* данные типа (см. таблицу) */
+};
+#define MRJ_F_SELF   0x01   /* вызов в СВОЙ процесс / поток */
+#define MRJ_F_PE     0x80   /* записала PE-половина (иначе unix-часть ntdll) */
+#define MRJ_F_FIRST  0x02   /* первый шанс (для исключений) */
+
+/* Образ контекста x64: ровно 256 байт, одинаков для Get/Set/Continue/исключений. Заполняет PE-половина (там лежит x64-состояние гостя). */
+struct mrj_ctx64 {
+    uint32_t flags, mxcsr;
+    uint16_t cs, ds, es, fs, gs, ss; uint32_t eflags;
+    uint64_t dr0, dr1, dr2, dr3, dr6, dr7;
+    uint64_t rax, rcx, rdx, rbx, rsp, rbp, rsi, rdi, r8, r9, r10, r11, r12, r13, r14, r15, rip;
+    uint16_t x87_cw, x87_sw; uint8_t x87_tw, x87_pad; uint16_t x87_errop; uint32_t x87_erroff; uint16_t x87_errsel, x87_pad2; uint32_t x87_dataoff; uint16_t x87_datasel, x87_pad3;
+    uint64_t xmm_fp;                     /* CRC32C-отпечаток XMM0-15 (256 байт) */
+    uint64_t st_fp;                      /* отпечаток ST0-7 (8 x 10 байт) */
+    uint64_t ymm_fp;                     /* отпечаток верхних половин YMM0-15, 0 если AVX-состояния нет */
+};
+
+/*  ТИПЫ ЗАПИСЕЙ. p0..p3 — данные первого слота, e[k] — сырые слоты после первого (8 слов). «in» — на входе, «out» — на выходе.
+ *  --- unix-часть ntdll (флаг PE снят) ---
+ *   1 PROTECT   (2 слота)  p0 base_in p1 size_in p2 new_prot|old_prot<<32 p3 size_out ; e0[0] base_out, e0[1] target pid (0 — свой)
+ *   2 ALLOC     (2)        p0 base_in p1 size_in(RegionSize) p2 type|prot<<32 p3 zero_bits ; e0[0] base_out e0[1] size_out e0[2] target pid
+ *   3 FREE      (1)        p0 base p1 size p2 type p3 base_out ; aux = size_out низ 32
+ *   4 QVM       (2 если class 0, иначе 1) p0 addr p1 class|len<<32 p2 retlen ; class 0: e0[0] BaseAddress e0[1] AllocationBase e0[2] RegionSize e0[3] AllocProtect|State<<32 e0[4] Protect|Type<<32
+ *   5 GETCTX    (1)        p0 target_tid p1 flags_in|flags_out<<32 p2 pc_arm64 p3 sp_arm64 ; F_SELF — свой поток
+ *   6 SETCTX    (1)        то же (контекст — ARM64 хоста; полный x64 пишет PE-половина записью 41)
+ *   7 CONTINUE  (1)        p0 flags|test_alert<<32 p1 pc p2 sp
+ *   8 RVM       (1)        p0 addr p1 size p2 retsize          aux = pid цели (0 — свой)
+ *   9 WVM       (1)        то же
+ *  10 FLUSH     (1)        p0 addr p1 size
+ *  11 QIP 12 QIT 13 SIT 14 QSI 15 QSX (1)  p0 class p1 len p2 retlen p3 handle_or_tid
+ *  16 CREATE_THREAD (1)    p0 start p1 param p2 flags p3 new_tid
+ *  17 SUSPEND 18 RESUME (1) p0 target_tid p1 prev_count
+ *  19 CLOSE_ERR (1)        p0 handle                           (status — в заголовке)
+ *  20 RAISE     (4)        p0 first_chance p1 context_ptr ; e0.. = EXCEPTION_RECORD (152 байт) копией
+ *  21 MAP 22 UNMAP (2)     p0 handle p1 base_in p2 size_in p3 prot ; e0[0] base_out e0[1] size_out
+ *  23 HOSTSIG   (1)        p0 sig|code<<32 p1 fault_addr p2 pc p3 esr          (хозяйский сигнал в листовом обработчике unix)
+ *  24 ABSORB_U  (1)        p0 reason p1 fault_addr p2 pc p3 guest_vprot|access<<32 ; aux = решение (0 поглощено, 1 передано дальше)
+ *      reason: 1 cw_write 2 cw_exec 3 jit_wx 4 stack 5 write_watch 6 fwd_smc 7 fwd_av 8 guard_violation
+ *  25 SYSCALL_FAULT(1)     резерв
+ *  --- PE-половина (переводчик xtajit64; флаг PE взведён); типы 40-59, согласованы с CLAUDE-EXC ---
+ *  40 X64_GETCTX (5)       p0 target_tid p1 flags_in|flags_out<<32 ; e0.. = mrj_ctx64 ПОСЛЕ вызова (то, что получила программа)
+ *  41 X64_SETCTX (9)       p0 target_tid p1 flags_in ; e0.. = mrj_ctx64 ДО (состояние потока), затем mrj_ctx64 ПОСЛЕ (применённое)
+ *  42 X64_EXC    (8)       p0 code|flags<<32 p1 address p2 nparams p3 info0 ; aux = серийный номер исключения потока ; e0.. = EXCEPTION_RECORD (152) + mrj_ctx64 как отдан обработчику
+ *  43 X64_CONT   (5)       aux = серийный номер исключения ; e0.. = mrj_ctx64, с которым исполнение ПРОДОЛЖЕНО
+ *  44 ABSORB_P   (2)       p0 reason(t_*) p1 fault_addr p2 guest_rip p3 guest_prot_4k|access<<32 ; aux — решение; e0.. резерв
+ *      reason: 1 smc 2 smc_inline 3 suspend_trap 4 suspend 5 callret 6 jitguard 7 unaligned 8 overcommit 9 pass(повторный визит)
+ *  46 X64_MXCSR  (1)       p0 cause|trace_kind<<8|seq_changed<<16|control_bits_changed<<17|trace_new<<32 ; p1 old (прежнее наблюдение State.mxcsr) ; p2 new (State.mxcsr сейчас) ; p3 rip последней записи MXCSR кодом гостя (0 — нет) ; aux = trace_old (значение до последней записи гостя)
+ *      cause: 1 до применения контекста 2 после применения 3 системный вызов 4 поглощение (ABSORB_P) 5 исключение 6 GetThreadContext 7 первое наблюдение потока; trace_kind: 1 ldmxcsr 2 fxrstor 3 xrstor (MACRUNNER_MXCSR_TRACE=1)
+ *  45 MARK       (1)       p0..p1 = метка ASCII 16 байт (NOEXEC, FATAL, ...) p2 код ; пишут обе половины
+ *  Разбор: tools journal_extract.py (census/journal/). Все адреса — как есть; журнал остаётся на машине.
+ */
+enum mrj_type {
+    MRJ_T_PROTECT = 1, MRJ_T_ALLOC, MRJ_T_FREE, MRJ_T_QVM, MRJ_T_GETCTX, MRJ_T_SETCTX, MRJ_T_CONTINUE, MRJ_T_RVM, MRJ_T_WVM, MRJ_T_FLUSH,
+    MRJ_T_QIP, MRJ_T_QIT, MRJ_T_SIT, MRJ_T_QSI, MRJ_T_QSX, MRJ_T_CREATE_THREAD, MRJ_T_SUSPEND, MRJ_T_RESUME, MRJ_T_CLOSE_ERR, MRJ_T_RAISE,
+    MRJ_T_MAP, MRJ_T_UNMAP, MRJ_T_HOSTSIG, MRJ_T_ABSORB_U,
+    MRJ_T_X64_GETCTX = 40, MRJ_T_X64_SETCTX, MRJ_T_X64_EXC, MRJ_T_X64_CONT, MRJ_T_ABSORB_P, MRJ_T_MARK, MRJ_T_X64_MXCSR, MRJ_T_X64_ORIGIN = 47
+};
+
+struct mrj_ring { struct mrj_file *f; uint8_t *slots; uint64_t mask; };
+
+static inline uint64_t mrj_now(void)
+{
+#if defined(__aarch64__) || defined(_M_ARM64) || defined(__arm64ec__)
+    uint64_t v; __asm__ volatile("mrs %0, cntvct_el0" : "=r"(v)); return v;
+#else
+    return 0;
+#endif
+}
+static inline struct mrj_rec *mrj_slot0(const struct mrj_ring *r, uint64_t idx) { return (struct mrj_rec *)(r->slots + (idx & r->mask) * MRJ_SLOT); }
+static inline uint64_t *mrj_ext(const struct mrj_ring *r, uint64_t idx, unsigned k) { return (uint64_t *)(r->slots + ((idx + k) & r->mask) * MRJ_SLOT); }
+/* занять n слотов; возвращает индекс первого */
+static inline uint64_t mrj_claim(const struct mrj_ring *r, unsigned n) { return __atomic_fetch_add(&r->f->head, (uint64_t)n, __ATOMIC_RELAXED); }
+/* обнулить все слова слота (кроме commit первого слота — его пишет mrj_commit) */
+static inline void mrj_zero(const struct mrj_ring *r, uint64_t idx, unsigned n)
+{
+    unsigned k, w;
+    for (k = 0; k < n; k++) { uint64_t *s = (uint64_t *)(r->slots + ((idx + k) & r->mask) * MRJ_SLOT); for (w = 0; w < 8; w++) s[w] = 0; }
+}
+static inline void mrj_commit(const struct mrj_ring *r, uint64_t idx) { __atomic_store_n(&mrj_slot0(r, idx)->commit, idx + 1, __ATOMIC_RELEASE); }
+/* заголовок записи: после него заполнить p[]/e[] и вызвать mrj_commit */
+static inline struct mrj_rec *mrj_begin(const struct mrj_ring *r, uint64_t idx, unsigned type, unsigned nslots, unsigned flags, uint32_t tid, int32_t status, uint32_t aux)
+{
+    struct mrj_rec *q = mrj_slot0(r, idx);
+    mrj_zero(r, idx, nslots);
+    q->t = mrj_now(); q->tid = tid; q->status = status; q->type = (uint16_t)type; q->nslots = (uint8_t)nslots; q->flags = (uint8_t)flags; q->aux = aux;
+    return q;
+}
+/* отпечаток CRC32C для XMM/ST: 2 независимые цепочки, 64 бита */
+static inline uint64_t mrj_fp(const void *p, unsigned bytes)
+{
+#if defined(__ARM_FEATURE_CRC32)
+    const uint64_t *w = (const uint64_t *)p; uint32_t a = 0xffffffffu, b = 0x9e3779b9u; unsigned i;
+    for (i = 0; i < bytes / 8; i++) { a = __builtin_arm_crc32cd(a, w[i]); b = __builtin_arm_crc32cd(b, w[i] ^ 0x5851f42d4c957f2dULL); }
+    return ((uint64_t)a << 32) | b;
+#else
+    const uint64_t *w = (const uint64_t *)p; uint64_t h = 1469598103934665603ULL; unsigned i;
+    for (i = 0; i < bytes / 8; i++) { h ^= w[i]; h *= 1099511628211ULL; }
+    return h;
+#endif
+}
+#ifdef __cplusplus
+static_assert(sizeof(struct mrj_rec) == 64, "mrj_rec != 64");
+static_assert(sizeof(struct mrj_ctx64) == 256, "mrj_ctx64 != 256");
+static_assert(sizeof(struct mrj_file) == MRJ_FILE_HDR, "mrj_file != 16 KiB");
+#else
+_Static_assert(sizeof(struct mrj_rec) == 64, "mrj_rec != 64");
+_Static_assert(sizeof(struct mrj_ctx64) == 256, "mrj_ctx64 != 256");
+_Static_assert(sizeof(struct mrj_file) == MRJ_FILE_HDR, "mrj_file != 16 KiB");
+#endif
+#endif
