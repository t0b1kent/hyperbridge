+  const bool Single = ElementSize == OpSize::i32Bit;
+  auto AbsMask = _VDupFromGPR(Size, ElementSize, Constant(Single ? 0x7FFFFFFFULL : 0x7FFFFFFFFFFFFFFFULL));
+  auto Infinity = _VDupFromGPR(Size, ElementSize, Constant(Single ? 0x7F800000ULL : 0x7FF0000000000000ULL));
+  auto MinNormal = _VDupFromGPR(Size, ElementSize, Constant(Single ? 0x00800000ULL : 0x0010000000000000ULL));
+  auto Zero = _VDupFromGPR(Size, ElementSize, Constant(0));
+  auto Abs1 = _VAnd(Size, Src1, AbsMask);
+  auto Abs2 = _VAnd(Size, Src2, AbsMask);
+  auto TinyNonZero = [&](Ref Abs) {
+    return _VAnd(Size, _VCMPGT(Size, ElementSize, MinNormal, Abs), _VCMPGT(Size, ElementSize, Abs, Zero));
+  };
+  Ref NaN = _VCMPGT(Size, ElementSize, Abs2, Infinity);
+  Ref Denormal = TinyNonZero(Abs2);
+  if (!Unary) {
