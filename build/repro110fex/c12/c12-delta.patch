+    Denormal = _VOr(Size, Denormal, TinyNonZero(Abs1));
+  }
+  Denormal = _VAnd(Size, Denormal, _VNot(Size, NaN));
+  auto ReduceMask = [&](Ref Mask) {
+    Ref Any = Constant(0);
+    const unsigned Lanes = Scalar ? 1 : IR::OpSizeAsBits(Size) / IR::OpSizeAsBits(ElementSize);
+    for (unsigned Lane = 0; Lane < Lanes; ++Lane) {
+      Any = _Or(OpSize::i64Bit, Any, _VExtractToGPR(ElementSize, ElementSize, Mask, Lane));
+    }
+    return _And(OpSize::i32Bit, Any, Constant(1));
