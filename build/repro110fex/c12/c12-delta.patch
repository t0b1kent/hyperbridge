@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: MIT
+// Modifications (c) 2026 MacRunner contributors, MIT
+#pragma once
+#include "Common/SoftFloat.h"
+#include "Interface/Core/HBX87StateGates.h"
+#include <FEXCore/Core/CoreState.h>
+#include <bit>
+
+namespace FEXCore::HBX87 {
+// FSCALE is exponent adjustment in ext80, not exp2 followed by a multiply.
+// PC does not reduce the significand; RC applies only at the exponent limits.
+FEXCORE_PRESERVE_ALL_ATTR inline bool TryScale(
+  uint16_t FCW, VectorRegType Lhs, VectorRegType Rhs,
+  FEXCore::Core::CpuStateFrame* Frame, VectorRegType& Result) {
+  if (!StateFix::Scale() || (FCW & 0x3f) != 0x3f ||
+      (FCW & 0x300) == 0x100 || Frame->State.flags[FEXCore::X86State::X87FLAG_ES_LOC]) {
+    return false; // Unmasked traps retain the existing path.
+  }
+  const X80SoftFloat A {Lhs}, B {Rhs};
+  const auto Unsupported = [](const X80SoftFloat& V) {
+    return V.Top.Exponent && !(V.Significand >> 63);
+  };
+  const auto IsNaN = [](const X80SoftFloat& V) {
+    return V.Top.Exponent == 0x7fff && (V.Significand & 0x7fffffffffffffffULL);
+  };
+  const auto IsInf = [](const X80SoftFloat& V) {
+    return V.Top.Exponent == 0x7fff && V.Significand == 0x8000000000000000ULL;
+  };
+  auto& Flags = Frame->State.flags;
+  bool IE = false, DE = false, OE = false, UE = false, PE = false, C1 = false;
+  X80SoftFloat Value {};
+  if (Unsupported(A) || Unsupported(B)) {
+    IE = true;
+    Value = X80SoftFloat {1, 0x7fff, 0xc000000000000000ULL};
+  } else if (IsNaN(A) || IsNaN(B)) {
+    const bool SignalingA = IsNaN(A) && !(A.Significand & 0x4000000000000000ULL);
+    const bool SignalingB = IsNaN(B) && !(B.Significand & 0x4000000000000000ULL);
+    IE = SignalingA || SignalingB;
+    Value = A;
+    if (!IsNaN(A) || (IsNaN(B) &&
+        ((SignalingA && !SignalingB) ||
+         (SignalingA == SignalingB &&
+          (B.Significand > A.Significand ||
+           (B.Significand == A.Significand && B.Top.Sign < A.Top.Sign)))))) {
+      Value = B;
+    }
+    Value.Significand |= 0x4000000000000000ULL;
+  } else {
+    DE = (!A.Top.Exponent && A.Significand) || (!B.Top.Exponent && B.Significand);
+    if (IsInf(B)) {
+      if ((!B.Top.Sign && !A.Top.Exponent && !A.Significand) || (B.Top.Sign && IsInf(A))) {
+        IE = true;
+        DE = false;
+        Value = X80SoftFloat {1, 0x7fff, 0xc000000000000000ULL};
+      } else {
+        Value = X80SoftFloat {A.Top.Sign, static_cast<uint16_t>(B.Top.Sign ? 0 : 0x7fff),
+                             B.Top.Sign ? 0ULL : 0x8000000000000000ULL};
+      }
+    } else if (IsInf(A)) {
+      Value = A;
+    } else {
+      int Scale = 0;
+      // Any magnitude >= 2^16 is beyond both ext80 exponent limits,
+      // including the least subnormal. Saturation preserves all outcomes.
+      const int BExponent = B.Top.Exponent ? static_cast<int>(B.Top.Exponent) - 16383 : -16382;
+      if (BExponent >= 0) {
+        Scale = BExponent > 15 ? 65536 : static_cast<int>(B.Significand >> (63 - BExponent));
+      }
+      if (B.Top.Sign) {
+        Scale = -Scale; // Truncate ST1 toward zero, independently of RC.
+      }
+      uint64_t Sig = A.Significand;
+      int Exponent = A.Top.Exponent;
+      Value.Top.Sign = A.Top.Sign;
+      if (Sig) {
+        if (!Exponent) {
+          const unsigned Shift = std::countl_zero(Sig);
+          Sig <<= Shift;
+          Exponent = 1 - static_cast<int>(Shift); // Also canonicalizes pseudo-denormals.
+        }
+        Exponent += Scale;
+        const unsigned RC = (FCW >> 10) & 3;
+        if (Exponent >= 0x7fff) {
+          const bool ToInfinity = RC == 0 || (RC == 1 && A.Top.Sign) || (RC == 2 && !A.Top.Sign);
+          OE = PE = true;
+          C1 = ToInfinity;
+          Exponent = ToInfinity ? 0x7fff : 0x7ffe;
+          Sig = ToInfinity ? 0x8000000000000000ULL : UINT64_MAX;
+        } else if (Exponent <= 0) {
+          const unsigned Shift = 1 - Exponent;
+          const uint64_t Kept = Shift < 64 ? Sig >> Shift : 0;
+          const uint64_t Lost = Shift < 64 ? Sig & ((uint64_t {1} << Shift) - 1) : Sig;
+          bool Increment = false;
+          if (Lost) {
+            if (RC == 0 && Shift <= 64) {
+              const uint64_t Half = uint64_t {1} << (Shift - 1);
+              Increment = Lost > Half || (Lost == Half && (Kept & 1));
+            } else if (RC == 1) {
+              Increment = A.Top.Sign;
+            } else if (RC == 2) {
+              Increment = !A.Top.Sign;
+            }
+            UE = PE = true;
+          }
+          Sig = Kept + Increment;
+          C1 = Increment;
+          Exponent = Sig >> 63 ? 1 : 0;
+        }
+        Value.Top.Exponent = Exponent;
+        Value.Significand = Sig;
+      }
+    }
+  }
+  Result = Value.ToVector();
+  Flags[FEXCore::X86State::X87FLAG_C1_LOC] = C1;
+  if (IE) Flags[FEXCore::X86State::X87FLAG_IE_LOC] = 1;
+  if (DE) Flags[FEXCore::X86State::X87FLAG_DE_LOC] = 1;
+  if (OE) Flags[FEXCore::X86State::X87FLAG_OE_LOC] = 1;
+  if (UE) Flags[FEXCore::X86State::X87FLAG_UE_LOC] = 1;
+  if (PE) Flags[FEXCore::X86State::X87FLAG_PE_LOC] = 1;
+  return true;
+}
+}
