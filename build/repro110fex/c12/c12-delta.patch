+  auto OldFPSR = _PushFPSR();
+  Ref Result;
+  if (Unary) {
+    if (Scalar) {
+      DeriveOp(ALUOp, IROp, _VFSqrtScalarInsert(Size, ElementSize, Src1, Src2, ZeroUpperBits));
+      Result = ALUOp;
+    } else {
+      DeriveOp(ALUOp, IROp, _VFSqrt(Size, ElementSize, Src2));
+      Result = ALUOp;
+    }
+  } else if (Scalar) {
+    DeriveOp(ALUOp, IROp, _VFAddScalarInsert(Size, ElementSize, Src1, Src2, ZeroUpperBits));
+    Result = ALUOp;
+  } else {
+    DeriveOp(ALUOp, IROp, _VFAdd(Size, ElementSize, Src1, Src2));
+    Result = ALUOp;
+  }
+  // The dependency keeps the status read after the arithmetic. Restore the host
+  // status afterwards; unrelated native arithmetic must never enter guest MXCSR.
+  auto FPSR = _GetFPSR(Result);
+  _PopFPSR(OldFPSR);
+  _PopRoundingMode(OldFPCR);
