+  auto Flushed = _And(OpSize::i32Bit, ReduceMask(TinyResult), _Bfe(OpSize::i32Bit, 1, 15, MXCSR));
+  auto FTZFlags = _And(OpSize::i32Bit, _Sub(OpSize::i32Bit, Constant(0), Flushed), Constant(0x30));
