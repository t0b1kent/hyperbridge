+Ref OpDispatchBuilder::SSEArithmeticExact(IROps IROp, OpSize Size, OpSize ElementSize, Ref Src1, Ref Src2,
+                                         bool Scalar, bool Unary, bool ZeroUpperBits) {
+  auto MXCSR = _LoadContextGPR(OpSize::i32Bit, offsetof(FEXCore::Core::CPUState, mxcsr));
+  // DAZ affects only active input lanes. In particular, a scalar operation must
+  // preserve all inherited destination bits, even when those bits are denormal.
+  if (!Unary) {
+    auto Effective1 = SSEApplyDAZ(Size, ElementSize, Src1, MXCSR);
+    Src1 = Scalar ? _VInsElement(Size, ElementSize, 0, 0, Src1, Effective1) : Effective1;
+  }
+  auto Effective2 = SSEApplyDAZ(Size, ElementSize, Src2, MXCSR);
+  Src2 = Scalar ? _VInsElement(Size, ElementSize, 0, 0, Src2, Effective2) : Effective2;
