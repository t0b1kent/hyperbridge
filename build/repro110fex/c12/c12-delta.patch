+// SPDX-License-Identifier: MIT
+// MacRunner CLAUDE-EXC 11.10.2026: реализация PE-половины журнала. Включается ОДИН раз в КОНЦЕ Module.cpp (нужны CTX, GetFrontendThreadData, Exception::...).
+// Все функции — cold (на горячем пути только проверка MRJournal::On); без печати, выделений и загрузчика.
+namespace FEX::Windows::MRJournal {
+namespace {
+
+inline void ExtWrite(uint64_t Idx, unsigned Off, const void* Src, size_t Bytes) {
+  const auto* S = static_cast<const uint8_t*>(Src);
+  while (Bytes) {
+    const unsigned Slot = 1 + Off / MRJ_SLOT, In = Off % MRJ_SLOT;
+    const size_t N = Bytes < MRJ_SLOT - In ? Bytes : MRJ_SLOT - In;
+    memcpy(reinterpret_cast<uint8_t*>(mrj_slot0(&Ring, Idx + Slot)) + In, S, N);
+    S += N; Off += static_cast<unsigned>(N); Bytes -= N;
+  }
+}
