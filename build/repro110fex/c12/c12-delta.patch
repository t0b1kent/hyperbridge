diff --git a/FEXCore/Source/Interface/Core/HBX87OrdinaryRemainder.h b/FEXCore/Source/Interface/Core/HBX87OrdinaryRemainder.h
new file mode 100644
index 0000000000000000000000000000000000000000..134110818beb007b488f55a3d2e50b79fe974bbb
--- /dev/null
+++ b/FEXCore/Source/Interface/Core/HBX87OrdinaryRemainder.h
@@ -0,0 +1,195 @@
+// SPDX-License-Identifier: MIT
+// Modifications (c) 2026 MacRunner contributors, MIT
+#pragma once
+#include "Common/SoftFloat.h"
+#include "Interface/Core/HBX87StateGates.h"
+#include <FEXCore/Core/CoreState.h>
+#include <bit>
+
+namespace FEXCore::HBX87 {
+struct OrdinaryRemInput {
+  uint64_t Sig {};
+  int Exponent {};
+  bool Sign {};
+  bool Denormal {};
+};
+inline bool UnpackOrdinaryRem(VectorRegType Raw, OrdinaryRemInput& Out, bool AllowPseudo = false) {
+  const X80SoftFloat Value {Raw};
+  Out.Sign = Value.Top.Sign;
+  Out.Sig = Value.Significand;
+  Out.Exponent = Value.Top.Exponent;
+  if (!Out.Exponent) {
+    if (!Out.Sig) {
+      return true;
+    }
+    if (Out.Sig >> 63) {
+      if (!AllowPseudo) return false;
+      // Raw exponent zero is a denormal operand (DE), but its integer bit
+      // makes its numeric value identical to canonical exponent one.
+      Out.Denormal = true;
+      Out.Exponent = 1;
+      return true;
+    }
+    Out.Denormal = true;
+    const unsigned Shift = std::countl_zero(Out.Sig);
+    Out.Sig <<= Shift;
+    Out.Exponent = 1 - static_cast<int>(Shift);
+    return true;
+  }
+  return Out.Exponent != 0x7fff && (Out.Sig >> 63);
+}
+
+// Full significands, not host double. Integer residue is exact and independent
+// of FCW PC/RC. No rounded divide/multiply/subtract intermediates are exposed.
+FEXCORE_PRESERVE_ALL_ATTR inline bool TryOrdinaryRemainder(
+  uint16_t FCW, VectorRegType Lhs, VectorRegType Rhs, bool NearestEven,
+  FEXCore::Core::CpuStateFrame* Frame, VectorRegType& Result) {
+  if ((!StateFix::OrdinaryRemainder() && !StateFix::PartialRemainder()) || (FCW & 0x3f) != 0x3f ||
+      (FCW & 0x300) == 0x100 || Frame->State.flags[FEXCore::X86State::X87FLAG_ES_LOC]) {
+    return false; // Unmasked trap delivery retains the old path.
+  }
+  const bool EncodingFix = StateFix::PartialRemainder();
+  const X80SoftFloat RawA {Lhs}, RawB {Rhs};
+  const auto Unsupported = [](const X80SoftFloat& V) {
+    return V.Top.Exponent && !(V.Significand >> 63);
+  };
+  const auto IsNaN = [](const X80SoftFloat& V) {
+    return V.Top.Exponent == 0x7fff && (V.Significand & 0x7fffffffffffffffULL);
+  };
+  const auto IsInf = [](const X80SoftFloat& V) {
+    return V.Top.Exponent == 0x7fff && V.Significand == 0x8000000000000000ULL;
+  };
+  const auto IsPseudo = [](const X80SoftFloat& V) {
+    return !V.Top.Exponent && (V.Significand >> 63);
+  };
+  if (EncodingFix && (Unsupported(RawA) || Unsupported(RawB) ||
+                      IsPseudo(RawA) || IsPseudo(RawB) || IsNaN(RawA) || IsNaN(RawB) ||
+                      IsInf(RawA) || IsInf(RawB) || !RawB.Significand)) {
+    bool Handled = true, IE = false, DE = false, Exception = false;
+    X80SoftFloat Value {};
+    if (Unsupported(RawA) || Unsupported(RawB)) {
+      IE = Exception = true;
+      Value = X80SoftFloat {1, 0x7fff, 0xc000000000000000ULL};
+    } else if (IsNaN(RawA) || IsNaN(RawB)) {
+      const bool SignalingA = IsNaN(RawA) && !(RawA.Significand & 0x4000000000000000ULL);
+      const bool SignalingB = IsNaN(RawB) && !(RawB.Significand & 0x4000000000000000ULL);
+      IE = SignalingA || SignalingB;
+      Exception = true;
+      Value = RawA;
+      if (!IsNaN(RawA) || (IsNaN(RawB) &&
+          ((SignalingA && !SignalingB) ||
+           (SignalingA == SignalingB &&
+            (RawB.Significand > RawA.Significand ||
+             (RawB.Significand == RawA.Significand && RawB.Top.Sign < RawA.Top.Sign)))))) {
+        Value = RawB;
+      }
+      Value.Significand |= 0x4000000000000000ULL;
+      // NaN handling precedes denormal recognition: no new DE or invalid
+      // from its finite denormal sibling. sNaN alone contributes IE.
+    } else if (IsInf(RawA) || !RawB.Significand) {
+      IE = Exception = true;
+      Value = X80SoftFloat {1, 0x7fff, 0xc000000000000000ULL};
+    } else if (IsInf(RawB)) {
+      Value = RawA;
+      if (IsPseudo(Value)) Value.Top.Exponent = 1;
+      DE = (!RawA.Top.Exponent && RawA.Significand) || (!RawB.Top.Exponent && RawB.Significand);
+    } else {
+      Handled = false; // Finite operands use the exact integer residue below.
+    }
+    if (Handled) {
+      auto& Flags = Frame->State.flags;
+      Flags[FEXCore::X86State::X87FLAG_C1_LOC] = 0;
+      Flags[FEXCore::X86State::X87FLAG_C2_LOC] = 0;
+      if (!Exception) {
+        Flags[FEXCore::X86State::X87FLAG_C0_LOC] = 0;
+        Flags[FEXCore::X86State::X87FLAG_C3_LOC] = 0;
+      }
+      if (IE) Flags[FEXCore::X86State::X87FLAG_IE_LOC] = 1;
+      if (DE) Flags[FEXCore::X86State::X87FLAG_DE_LOC] = 1;
+      Result = Value.ToVector();
+      return true;
+    }
+  }
+  OrdinaryRemInput A {}, B {};
+  if (!UnpackOrdinaryRem(Lhs, A, EncodingFix) || !UnpackOrdinaryRem(Rhs, B, EncodingFix) || !B.Sig) {
+    return false;
+  }
+  const int Gap = A.Exponent - B.Exponent;
+  const bool Partial = A.Sig && Gap >= 64;
+  if (Partial && !StateFix::PartialRemainder()) {
+    return false;
+  }
+
+  uint64_t Quotient = 0, Residue = A.Sig;
+  int BaseExponent = A.Exponent;
+  bool Sign = A.Sign;
+  using Wide = unsigned __int128;
+  if (Partial) {
+    // Intel-compatible single partial step. N is in the architectural 32..63
+    // range; its low-order alignment matches the accepted Intel/AMD grid.
+    // Both FPREM and FPREM1 truncate the partial quotient. Only the final
+    // (Gap < 64) FPREM1 step uses nearest-even. The 127-bit numerator fits Wide.
+    const unsigned N = 32 + (static_cast<unsigned>(Gap) & 31);
+    Residue = static_cast<uint64_t>((Wide {A.Sig} << N) % B.Sig);
+    BaseExponent = A.Exponent - static_cast<int>(N);
+  } else if (A.Sig && Gap >= 0) {
+    const Wide Numerator = Wide {A.Sig} << Gap;
+    Quotient = static_cast<uint64_t>(Numerator / B.Sig);
+    Residue = static_cast<uint64_t>(Numerator % B.Sig);
+    BaseExponent = B.Exponent;
+    if (NearestEven && (Wide {Residue} * 2 > B.Sig ||
+                        (Wide {Residue} * 2 == B.Sig && (Quotient & 1)))) {
+      // Unsigned wrap at 2^64 is intentional: only quotient low3 are used.
+      ++Quotient;
+      Residue = B.Sig - Residue;
+      Sign = !Sign;
+    }
+  } else if (A.Sig && Gap == -1 && NearestEven && A.Sig > B.Sig) {
+    Quotient = 1;
+    Residue = static_cast<uint64_t>(Wide {B.Sig} * 2 - A.Sig);
+    Sign = !Sign;
+  }
+
+  X80SoftFloat Value {};
+  Value.Top.Sign = Sign;
+  if (Residue) {
+    const unsigned Shift = std::countl_zero(Residue);
+    Residue <<= Shift;
+    BaseExponent -= static_cast<int>(Shift);
+    if (BaseExponent <= 0) {
+      const unsigned SubnormalShift = 1 - BaseExponent;
+      // This cannot discard bits for exact supported x87 inputs. Keep a
+      // runtime guard nevertheless; no architectural state was touched yet.
+      if (SubnormalShift >= 64 || (Residue & ((uint64_t {1} << SubnormalShift) - 1))) {
+        return false;
+      }
+      Residue >>= SubnormalShift;
+      BaseExponent = 0;
+    }
+    if (BaseExponent >= 0x7fff) {
+      return false;
+    }
+    Value.Significand = Residue;
+    Value.Top.Exponent = BaseExponent;
+  }
+  Result = Value.ToVector();
+  auto& Flags = Frame->State.flags;
+  Flags[FEXCore::X86State::X87FLAG_C2_LOC] = Partial;
+  if (Partial) {
+    // AMD specifies zero and the accepted Intel probe agrees for every
+    // initial C0/C1/C2/C3 combination. C2 remains set even for zero residue.
+    Flags[FEXCore::X86State::X87FLAG_C0_LOC] = 0;
+    Flags[FEXCore::X86State::X87FLAG_C1_LOC] = 0;
+    Flags[FEXCore::X86State::X87FLAG_C3_LOC] = 0;
+  } else {
+    // Hardware quotient flags encode magnitude low3, not signed two's complement.
+    Flags[FEXCore::X86State::X87FLAG_C0_LOC] = (Quotient >> 2) & 1;
+    Flags[FEXCore::X86State::X87FLAG_C1_LOC] = Quotient & 1;
+    Flags[FEXCore::X86State::X87FLAG_C3_LOC] = (Quotient >> 1) & 1;
+  }
+  if (A.Denormal || B.Denormal) {
+    Flags[FEXCore::X86State::X87FLAG_DE_LOC] = 1;
+  }
+  return true;
+}
+}
