+                       _Lshl(OpSize::i32Bit, _And(OpSize::i32Bit, FPSR, Constant(0x1E)), Constant(1)));
+  auto Flags = _Or(OpSize::i32Bit, HostFlags, _Or(OpSize::i32Bit, DE, FTZFlags));
+  _StoreContextGPR(OpSize::i32Bit, _Or(OpSize::i32Bit, MXCSR, Flags), offsetof(FEXCore::Core::CPUState, mxcsr));
+  auto FlushedResult = SSEApplyFTZ(Size, ElementSize, Result, MXCSR);
+  Result = Scalar ? _VInsElement(Size, ElementSize, 0, 0, Result, FlushedResult) : FlushedResult;
