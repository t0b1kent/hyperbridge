+// ★ MacRunner QPCJIT compact form (keys 5, 6, 7): the same value as MacRunnerQpcValue, constants from Entries[Idx] (one 3-mov address
+// per block): ldp base-address/magic; base loaded through it; x*(2^k+1) as add-shift, x*2^k as shift, other multipliers loaded.
+Ref OpDispatchBuilder::MacRunnerQpcValueCompact(unsigned Idx, const FEXCore::Utils::MRQpcInline::Scale& S) {
+  namespace Q = FEXCore::Utils::MRQpcInline;
+  const auto& P = Q::G;
+  Ref E = Constant(reinterpret_cast<uint64_t>(&Q::Entries[Idx]));
+  auto BM = LoadMemPair(RegClass::GPR, OpSize::i64Bit, E, offsetof(Q::SiteEntry, BaseAddr));
+  Ref Ticks = _MRHostCounter(P.Kind);
+  Ref Base = _LoadMem(RegClass::GPR, OpSize::i64Bit, BM.Low, Invalid(), OpSize::i8Bit, MemOffsetType::SXTX, 1);
+  Ref X = _Add(OpSize::i64Bit, Ticks, Base);
+  Ref Y = X;
+  const uint64_t M = S.Mul;
+  if (M != 1) {
+    if ((M & (M - 1)) == 0) {
+      Y = _Lshl(OpSize::i64Bit, X, Constant(__builtin_ctzll(M)));
+    } else if (((M - 1) & (M - 2)) == 0) {
+      Y = _AddShift(OpSize::i64Bit, X, X, ShiftType::LSL, static_cast<uint8_t>(__builtin_ctzll(M - 1)));
+    } else {
+      Y = _Mul(OpSize::i64Bit, X,
+               _LoadMem(RegClass::GPR, OpSize::i64Bit, E, _InlineConstant(offsetof(Q::SiteEntry, Mul)), OpSize::i8Bit, MemOffsetType::SXTX, 1));
+    }
+  }
+  Ref V = Y;
+  using FEXCore::Utils::MRQpcInline::ScaleForm;
+  if (S.Form == ScaleForm::Shift) {
+    V = _Lshr(OpSize::i64Bit, Y, Constant(S.Shift));
+  } else if (S.Form == ScaleForm::MulHigh) {
+    V = _UMulH(OpSize::i64Bit, Y, BM.High);
+    if (S.Shift) {
+      V = _Lshr(OpSize::i64Bit, V, Constant(S.Shift));
+    }
+  }
+  return V;
+}
