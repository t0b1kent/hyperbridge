+// What the emitted code computes (used by the init self-test against direct division).
+inline uint64_t ApplyScale(const Scale& S, uint64_t x) {
+  const uint64_t y = x * S.Mul;
+  switch (S.Form) {
+  case ScaleForm::Identity: return y;
+  case ScaleForm::Shift: return y >> S.Shift;
+  case ScaleForm::MulHigh: return static_cast<uint64_t>((static_cast<unsigned __int128>(y) * S.Magic) >> 64) >> S.Shift;
+  default: return 0;
+  }
+}
