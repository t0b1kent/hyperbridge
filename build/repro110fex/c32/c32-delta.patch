+// SPDX-License-Identifier: MIT
+// MacRunner: sparse committed call/return stack; the native stand has no hook.
+#pragma once
+#include <FEXCore/Debug/InternalThreadState.h>
+#include <FEXCore/Utils/AllocatorHooks.h>
+#include <atomic>
+#include <cstdint>
+namespace MRCallRet {
+using ZeroHookFn = bool (*)(FEXCore::Core::InternalThreadState*);
+extern std::atomic<ZeroHookFn> ZeroHook;
+extern std::atomic<uint64_t> Grows;
+inline bool TryZero(FEXCore::Core::InternalThreadState* Thread) {
+  if (!Thread || !Thread->CallRetStackBase) return true; // validation-only thread: no stack to clear
+  const auto Hook = ZeroHook.load(std::memory_order_acquire);
+  return Hook && Hook(Thread);
+}
+inline void Zero(FEXCore::Core::InternalThreadState* Thread) {
+  if (TryZero(Thread)) return;
+  FEXCore::Allocator::VirtualDontNeed(Thread->CallRetStackBase, FEXCore::Core::InternalThreadState::CALLRET_STACK_SIZE);
+}
