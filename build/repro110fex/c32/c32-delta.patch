+// SPDX-License-Identifier: MIT
+// Modifications (c) 2026 MacRunner contributors, MIT
+// ★ MacRunner QPCJIT (03.11.2026): MACRUNNER_FEX_QPC_INLINE — QueryPerformanceCounter of x64 code without the x64 -> ARM64EC transition.
+//
+// Every x64 path to QPC ends in the x64 fast-forward sequence (FFS) of ntdll's hybrid export RtlQueryPerformanceCounter
+// (.hexpthk: `mov rax,rsp; mov [rax+20h],rbx; push rbp; pop rbp; jmp <EC body>`): kernel32!QueryPerformanceCounter is
+// `jmp [aux IAT]` to it, kernelbase / api-ms-win-core-profile forward to it, GetProcAddress(ntdll) returns it. FEX translates the
+// FFS like any x64 code. Under the key, the translation of the FFS's FIRST instruction begins with:
+//
+//     if (macrunner_ntdll_fast.qpc_enabled == 0) -> the unchanged translation of the FFS (jmp to the EC body = the old path)
+//     else: [rcx] = (counter + *base) * mul / div;  rax = 1;  ret
+//
+// with exactly the data PE ntdll's RtlQueryPerformanceCounter uses under MACRUNNER_QPC_FAST (QPC lane patch 0001: the EC half's
+// export `macrunner_ntdll_fast`, filled once by the unix side at load). The flag is read on every call, so the inline path is on
+// exactly when ntdll's own fast path is on (also under the hot switch) and the value is the one ntdll would compute: the same
+// counter register, the same commpage base (read every call: it moves on sleep / wake), the same 64-bit floor of x*mul/div
+// (as umulh by a magic constant, proven exact on ntdll's whole non-wrapping domain, see ComputeScale).
+//
+// Recognition is by address AND bytes: the block entry is the FFS address resolved from ntdll's export at process init, its 14 bytes
+// equal those seen at init (canonical FFS whose jmp lands on the EC body found through the CHPE redirection table), the EC body's
+// first 16 bytes are unchanged, and the page is not writable (FEX's write tracking then invalidates the block on any later patch).
+// A hooked IAT never reaches the FFS; a patched FFS fails the byte check; both take the old path.
+//
+// Keys (read once in ProcessInit): 0 (default) = nothing changes (no IR differs, the plan is never armed); 1 = on; 2 = on + count
+// inlined calls (one atomic add, printed at process / thread end); 9 = TEST ONLY: deliberately wrong scale (divisor + 1).
+//
+// Stage 3 (keys 3, 4, 8; QPCJIT 03.11 by the curator's word): additionally at the CALL SITE. A `call qword [rip+disp]` /
+// `jmp qword [rip+disp]` whose slot, when the block is compiled, holds the FFS or an x64 thunk `jmp [aux]` whose aux holds the FFS
+// (kernel32!QueryPerformanceCounter is exactly that) gets, before the unchanged call / jump:
+//     if (slot value == that target  &&  thunk 8 bytes, aux value, FFS 16 bytes == as now  &&  qpc_enabled == 1)
+//         [rcx] = value; rax = 1; continue after the call (jmp: return to the caller)   — no call, no thunk, no FFS, no ret
+// Every condition is re-checked on every execution (a hooked IAT, thunk, aux slot or FFS takes the unchanged path at once), so
+// the site path never depends on FEX invalidation. 3 = sites + FFS; 4 = 3 + counts; 8 = TEST ONLY: wrong scale on the site path
+// only (the FFS path stays exact) — a probe that passes under 8 did not go through the site path.
+//
+// Compact form (keys 5, 6, 7; curator 03.11 15:5x — the same paths as 3/4, fewer instructions): every constant of a path lives in a
+// 16-byte-aligned entry of the table below; an IR block materialises only the entry address (3 mov) and reads the rest with ldp/ldr
+// (addresses, expected bytes, magic). x*5 becomes add x, x, x, lsl #2. 5 = compact sites + compact FFS path; 6 = 5 + counts;
+// 7 = TEST ONLY: deliberately wrong scale on BOTH compact paths.
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+namespace FEXCore::Utils::MRQpcInline {
+
+// Mirror of struct macrunner_ntdll_fast (wine dlls/ntdll/unixlib.h, QPC lane patch 0001). Layout checked by static_assert in Module.cpp.
+struct NtdllFast {
+  volatile uint32_t qpc_enabled;
+  uint32_t qpc_counter;
+  uint64_t qpc_base_addr;
+  uint64_t qpc_mul;
+  uint64_t qpc_div;
+  volatile uint32_t waitaddr_direct;
+  volatile uint32_t qpc_count;
+  uint32_t reserved[2];
+};
+
+enum class ScaleForm : uint8_t { None = 0, Identity = 1, Shift = 2, MulHigh = 3 };
+
+struct Scale {
+  uint64_t Mul {};    // reduced numerator (numer / gcd)
+  uint64_t Magic {};  // MulHigh: q = umulh(x * Mul, Magic) >> Shift
+  uint8_t Shift {};
+  ScaleForm Form {ScaleForm::None};
+};
+
+// floor(x * Numer / Div) for every x in [0, UINT64_MAX / Numer] — the domain where ntdll's own 64-bit product x*Numer does not
+// wrap (ntdll refuses the fast path at load unless x < UINT64_MAX / Numer / 2). With g = gcd, M = Numer/g, D = Div/g:
+// floor(x*Numer/Div) = floor(y/D), y = x*M <= YMax = (UINT64_MAX / Numer) * M. For s >= 64, m = ceil(2^s / D) < 2^64 and
+// e = m*D - 2^s: if e * YMax < 2^s then floor(y*m / 2^s) = floor(y/D) for all 0 <= y <= YMax (Granlund–Montgomery: the error
+// y*e/(D*2^s) is below 1/D, and frac(y/D) <= (D-1)/D, so no integer is crossed). Returns Form None if no such s exists.
+inline uint64_t Gcd(uint64_t a, uint64_t b) {
+  while (b) {
+    const uint64_t t = a % b;
+    a = b;
+    b = t;
+  }
+  return a;
+}
+
+inline Scale ComputeScale(uint64_t Numer, uint64_t Div) {
+  Scale S {};
+  if (!Numer || !Div) {
+    return S;
+  }
+  const uint64_t G = Gcd(Numer, Div);
+  const uint64_t M = Numer / G, D = Div / G;
+  const uint64_t XMax = UINT64_MAX / Numer;
+  const unsigned __int128 YMax = static_cast<unsigned __int128>(XMax) * M;
+  S.Mul = M;
+  if (D == 1) {
+    S.Form = ScaleForm::Identity;
+    return S;
+  }
+  if ((D & (D - 1)) == 0) {
+    S.Form = ScaleForm::Shift;
+    S.Shift = static_cast<uint8_t>(__builtin_ctzll(D));
+    return S;
+  }
+  for (unsigned s = 64; s < 128; ++s) {
+    const unsigned __int128 P = static_cast<unsigned __int128>(1) << s;
+    const unsigned __int128 m = (P + (D - 1)) / D;
+    if (m >> 64) {
+      break;
+    }
+    const unsigned __int128 e = m * D - P;
+    // e < D < 2^64 and YMax < 2^64: the product fits in 128 bits.
+    if (e * YMax < P) {
