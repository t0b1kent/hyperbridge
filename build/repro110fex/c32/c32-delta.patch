+Ref OpDispatchBuilder::LazyQuietFCMP(OpSize CmpSize, OpSize LogicSize, IR::OpSize ElementSize, Ref Src1, Ref Src2, uint8_t CompType) {
+  // fcmeq x,x is quiet (IOC only for SNaN) and true exactly for non-NaN lanes. The ordering
+  // compare then runs on NaN-free copies (NaN lanes zeroed) and is masked by the order.
+  Ref Ord1 = _VFCMPEQ(CmpSize, ElementSize, Src1, Src1);
+  Ref Ord2 = _VFCMPEQ(CmpSize, ElementSize, Src2, Src2);
+  Ref Ordered = _VAnd(LogicSize, Ord1, Ord2);
+  const auto Type = static_cast<VectorCompareType>(CompType);
+  if (Type == VectorCompareType::ORD_Q) return Ordered;
+  if (Type == VectorCompareType::UNORD_Q) return _VNot(LogicSize, Ordered);
+  Ref A = _VAnd(LogicSize, Src1, Ord1);
+  Ref B = _VAnd(LogicSize, Src2, Ord2);
+  Ref Result {};
+  bool Invert = false;
+  switch (Type) {
+  case VectorCompareType::LT_OQ: Result = _VFCMPLT(CmpSize, ElementSize, A, B); break;
+  case VectorCompareType::LE_OQ: Result = _VFCMPLE(CmpSize, ElementSize, A, B); break;
+  case VectorCompareType::GT_OQ: Result = _VFCMPLT(CmpSize, ElementSize, B, A); break;
+  case VectorCompareType::GE_OQ: Result = _VFCMPLE(CmpSize, ElementSize, B, A); break;
+  case VectorCompareType::NLT_UQ: Result = _VFCMPLT(CmpSize, ElementSize, A, B); Invert = true; break;
+  case VectorCompareType::NLE_UQ: Result = _VFCMPLE(CmpSize, ElementSize, A, B); Invert = true; break;
+  case VectorCompareType::NGT_UQ: Result = _VFCMPLT(CmpSize, ElementSize, B, A); Invert = true; break;
+  case VectorCompareType::NGE_UQ: Result = _VFCMPLE(CmpSize, ElementSize, B, A); Invert = true; break;
+  default: FEX_UNREACHABLE;
+  }
+  Result = _VAnd(LogicSize, Result, Ordered);
+  return Invert ? _VNot(LogicSize, Result) : Result;
