+// SPDX-License-Identifier: MIT
+#pragma once
+#include <FEXCore/Core/MacRunnerWinctx.h>
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+
+// MacRunner LAZY-FLAGS (15.10.2026): lazy SSE exception status (MXCSR IE/ZE/OE/UE/PE).
+// MACRUNNER_FEX_LAZY_MXCSR=1: guest SSE arithmetic runs on the host FP unit and the host
+// FPSR accumulates IOC/DZC/OFC/UFC/IXC by itself, so no per-operation code is emitted.
+// Architectural status = (CPUState.mxcsr & 0x3F) | ToMXCSR(FPSR of the guest thread).
+// Readers (STMXCSR/FXSAVE/XSAVE, context capture) fold; writers (LDMXCSR/FXRSTOR/XRSTOR)
+// move the status into FPSR. DE has no host source (AArch64 IDC means "input flushed"),
+// it lives in the shadow only. MACRUNNER_WINCTX_EXACT has priority (oracle path).
+namespace FEXCore::LazyMXCSR {
+// Initialized at context creation, after Winctx::Initialize, before translation.
+// Level 1: accumulate in FPSR, fold/seed, zero/near-zero cost form fixes.
+// Level 2: additionally discard the host status of RCP/RSQRT (x86 raises nothing for them;
+// the host computes them with FDIV/FSQRT) with an FPSR save/restore (~7.6 ns on M1 Pro).
+inline std::atomic<bool> Enabled {false};
+inline std::atomic<bool> FixEstimates {false};
+inline void Initialize() {
+  const char* Value = std::getenv("MACRUNNER_FEX_LAZY_MXCSR");
+  const bool Valid = Value && (Value[0] == '1' || Value[0] == '2') && !Value[1];
+  const bool On = Valid && !FEXCore::Winctx::Enabled.load(std::memory_order_relaxed);
+  Enabled.store(On, std::memory_order_relaxed);
+  FixEstimates.store(On && Value[0] == '2', std::memory_order_relaxed);
+}
+// FPSR IOC(0) DZC(1) OFC(2) UFC(3) IXC(4) -> MXCSR IE(0) ZE(2) OE(3) UE(4) PE(5).
+// The same table as Wine dlls/ntdll/unwind.h fpcsr_to_mxcsr, without IDC->DE.
+inline constexpr uint32_t ToMXCSR(uint32_t Fpsr) {
+  return (Fpsr & 1U) | ((Fpsr & 0x1EU) << 1);
+}
+// Inverse for the five host-produced bits; MXCSR DE (bit 1) is not seeded into FPSR.
+inline constexpr uint32_t ToFPSR(uint32_t Mxcsr) {
+  return (Mxcsr & 1U) | ((Mxcsr >> 1) & 0x1EU);
+}
+// Transport form for packed ARM64EC contexts: Wine maps FPSR.IDC(7) <-> MXCSR.DE.
+inline constexpr uint32_t ToFPSRWithDE(uint32_t Mxcsr) {
+  return ToFPSR(Mxcsr) | ((Mxcsr & 2U) << 6);
+}
+// Translator-internal host code (block compiler, linker) may execute host FP arithmetic of
+// its own (load-factor math in hash tables, statistics). Under the lazy key the host FPSR
+// belongs to the guest, so such entry points preserve it.
+struct ScopedHostFPSR {
+  uint64_t Saved {};
+  bool Active;
+  ScopedHostFPSR()
+    : Active(Enabled.load(std::memory_order_relaxed)) {
+#if defined(__aarch64__) || defined(__arm64ec__) || defined(_M_ARM64) || defined(_M_ARM64EC)
+    if (Active) {
+      __asm__ __volatile__("mrs %0, fpsr" : "=r"(Saved) : : "memory");
+    }
+#endif
+  }
+  ~ScopedHostFPSR() {
+#if defined(__aarch64__) || defined(__arm64ec__) || defined(_M_ARM64) || defined(_M_ARM64EC)
+    if (Active) {
+      __asm__ __volatile__("msr fpsr, %0" : : "r"(Saved) : "memory");
+    }
+#endif
+  }
+  ScopedHostFPSR(const ScopedHostFPSR&) = delete;
+  ScopedHostFPSR& operator=(const ScopedHostFPSR&) = delete;
+};
+static_assert(ToMXCSR(0x1F) == 0x3D && ToFPSR(0x3D) == 0x1F && ToFPSR(0x02) == 0 && ToFPSRWithDE(0x02) == 0x80);
+} // namespace FEXCore::LazyMXCSR
