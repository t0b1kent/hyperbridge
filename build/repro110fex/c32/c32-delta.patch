+static void MRFloatSaveToXSave(const WOW64_FLOATING_SAVE_AREA& F, XSAVE_FORMAT* X) {
+  X->ControlWord = static_cast<uint16_t>(F.ControlWord);
+  X->StatusWord = static_cast<uint16_t>(F.StatusWord);
