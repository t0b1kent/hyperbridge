+// first instruction of ntdll's RtlQueryPerformanceCounter FFS, once Core.cpp has checked address, bytes and page protection:
+//   flag = ntdll.macrunner_ntdll_fast.qpc_enabled            (ntdll's own switch, read on every call: hot switch included)
+//   flag == 0 -> SlowBlock: the FFS translated as before (jmp to the EC body: ntdll's syscall path)
+//   flag != 0 -> [rcx] = floor((counter + *base) * mul / div); rax = 1; ret — the value ntdll's fast path computes, from the same data.
+// Guest state touched: memory [rcx] (8 bytes, the same store an x64 `mov [rcx], rax` does), rax, rsp (+8 by the return), rip.
+// Flags, every other GPR and every vector register keep their values (the call may clobber far more). A fault on [rcx] is raised
+// at the FFS entry with the guest state of the call (rax / rsp still unchanged): the store precedes every register write.
+// ★ MacRunner QPCJIT: (counter + *base) * mul / div exactly as ntdll's fast path, emitted in the current block (MacRunnerQpcInline.h).
+Ref OpDispatchBuilder::MacRunnerQpcValue(const FEXCore::Utils::MRQpcInline::Scale& S) {
+  const auto& P = FEXCore::Utils::MRQpcInline::G;
+  Ref Ticks = _MRHostCounter(P.Kind);
+  Ref Base = _LoadMem(RegClass::GPR, OpSize::i64Bit, Constant(P.BaseAddr), Invalid(), OpSize::i8Bit, MemOffsetType::SXTX, 1);
+  Ref X = _Add(OpSize::i64Bit, Ticks, Base);
+  Ref Y = S.Mul == 1 ? X : _Mul(OpSize::i64Bit, X, Constant(S.Mul));
+  Ref Q = Y;
+  using FEXCore::Utils::MRQpcInline::ScaleForm;
+  if (S.Form == ScaleForm::Shift) {
+    Q = _Lshr(OpSize::i64Bit, Y, Constant(S.Shift));
+  } else if (S.Form == ScaleForm::MulHigh) {
+    Q = _UMulH(OpSize::i64Bit, Y, Constant(S.Magic));
+    if (S.Shift) {
+      Q = _Lshr(OpSize::i64Bit, Q, Constant(S.Shift));
+    }
+  }
+  return Q;
+}
