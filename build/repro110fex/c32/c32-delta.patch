+enum class LazyCompareFix { None, AddSignaling, AddQuiet, Quiet };
+static LazyCompareFix LazyCompareFixFor(uint8_t CompType) {
+  switch (static_cast<VectorCompareType>(CompType)) {
+  case VectorCompareType::EQ_OS:
+  case VectorCompareType::NEQ_US:
+  case VectorCompareType::EQ_US:
+  case VectorCompareType::NEQ_OS:
+  case VectorCompareType::FALSE_OS:
+  case VectorCompareType::TRUE_US: return LazyCompareFix::AddSignaling;
+  case VectorCompareType::FALSE_OQ:
+  case VectorCompareType::TRUE_UQ: return LazyCompareFix::AddQuiet;
+  case VectorCompareType::UNORD_Q:
+  case VectorCompareType::ORD_Q:
+  case VectorCompareType::LT_OQ:
+  case VectorCompareType::LE_OQ:
+  case VectorCompareType::NLT_UQ:
+  case VectorCompareType::NLE_UQ:
+  case VectorCompareType::NGE_UQ:
+  case VectorCompareType::NGT_UQ:
+  case VectorCompareType::GE_OQ:
+  case VectorCompareType::GT_OQ: return LazyCompareFix::Quiet;
+  default: return LazyCompareFix::None;
