+// Entry for sites through the thunk T (compact form): found or published once; 0 = table full (the caller emits the stage-3 form).
+static unsigned MacRunnerQpcThunkEntry(uint64_t T, uint64_t Thunk8, uint64_t Aux) {
+  namespace Q = FEXCore::Utils::MRQpcInline;
+  static std::mutex EntryLock;
+  std::scoped_lock Lock(EntryLock);
+  const unsigned N = Q::EntryCount.load(std::memory_order_acquire);
+  for (unsigned i = 2; i < N; ++i) {
+    if (Q::Entries[i].T == T && Q::Entries[i].Thunk8 == Thunk8 && Q::Entries[i].AuxAddr == Aux) {
+      return i;
+    }
+  }
+  if (N < 2 || N >= Q::MaxSiteEntries) {
+    return 0;
+  }
+  auto& E = Q::Entries[N];
+  E = Q::Entries[1]; // FFS, flag, FFS bytes, base, site scale
+  E.T = T;
+  E.AuxAddr = Aux;
+  E.Thunk8 = Thunk8;
+  Q::EntryCount.store(N + 1, std::memory_order_release);
+  return N;
+}
