+// SPDX-License-Identifier: MIT
+// Modifications (c) 2026 MacRunner contributors, MIT
+// ★ MacRunner SYNC (03.11.2026): length of the x86 PAUSE (F3 90) in translated code. Private MacRunner fork, not for upstream FEX-Emu.
+// MACRUNNER_FEX_PAUSE (read once, ARM64EC only; the WOW64 translator and the Linux frontends keep the previous code):
+//   0 / unset / anything else = the previous code: one `yield` (on Apple M1 `yield` retires like `nop`, 0.16 cycles: a guest
+//       spin of N x PAUSE calibrated for x86, where PAUSE is ~10-140 cycles, ends ~100x sooner and the guest parks instead);
+//   isb = one `isb` (28 cycles on M1 Pro, measured with the rusage cycle counter; the choice of Rust core::hint::spin_loop and
+//       OpenJDK -XX:OnSpinWaitInst=isb on aarch64);
+//   1..16 = that many `isb` (5 ~ 140 cycles ~ one Skylake-class PAUSE).
+// The PAUSE has no architectural effect on x86 (a hint), so only the time a spin takes changes.
+#pragma once
+#include <cstdlib>
+#include <cstring>
+
+namespace FEXCore::Utils {
+inline unsigned MacRunnerPauseIsbCount() {
+#ifdef ARCHITECTURE_arm64ec
+  static const unsigned Count = [] {
+    const char* Value = std::getenv("MACRUNNER_FEX_PAUSE");
+    if (!Value) return 0u;
+    if (!std::strcmp(Value, "isb")) return 1u;
+    char* End = nullptr;
+    const unsigned long N = std::strtoul(Value, &End, 10);
+    if (End == Value || *End || N > 16) return 0u;
+    return static_cast<unsigned>(N);
+  }();
+  return Count;
+#else
+  return 0;
+#endif
+}
+} // namespace FEXCore::Utils
