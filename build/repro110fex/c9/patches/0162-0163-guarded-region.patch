+#include "Interface/IR/PassManager.h"
+#include "Interface/GDBJIT/GDBJIT.h"
+extern "C" {
+#include <SoftFloat-3e/platform.h>
+#include <SoftFloat-3e/softfloat.h>
+}
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <span>
+static_assert(offsetof(extFloat80_t, signif) == 0 && offsetof(extFloat80_t, signExp) == 8);
+
+using namespace FEXCore::Core;
+using namespace FEXCore::Core::X87Region;
+using Backend = FEXCore::CPU::CPUBackend;
+unsigned Failures {}, WidenCases {}, RecoveryCases {}, NegativeCases {};
+unsigned GuardCases {}, GuardAccepted {}, GuardOperations {}, GuardRejected {};
+void Check(bool Equal, const char* Name) {
+  if (!Equal) { if (Failures < 8) std::fprintf(stderr,"FAILED %s\n",Name); ++Failures; }
+}
+uint64_t Random(uint64_t& State) {
+  State ^= State << 13; State ^= State >> 7; State ^= State << 17; return State;
+}
+void WidenTest(uint64_t Bits, Format Precision) {
+  const bool Wide = Precision == Format::Binary53;
+  const unsigned F = Wide ? 52 : 23, E = Wide ? 11 : 8;
+  const bool Finite = ((Bits >> F) & ((uint64_t {1} << E)-1)) != ((uint64_t {1} << E)-1);
+  Raw80 Out {0x1234,0x5678};
+  const bool Accepted = Widen(Bits,Precision,Out);
+  Check(Accepted == Finite,"finite admission");
+  if (Finite) {
+    softfloat_state State {};
+    const auto Ref = Wide ? f64_to_extF80(&State,float64_t{Bits}) : f32_to_extF80(&State,float32_t{uint32_t(Bits)});
+    Check(Out.Significand == Ref.signif && Out.SignExponent == Ref.signExp,"SoftFloat exact widening");
+  } else {
+    Check(Out.Significand == 0x1234 && Out.SignExponent == 0x5678,"rejected widening unchanged");
+  }
+  ++WidenCases;
+}
