+template<class T> uint64_t HostArithmetic(Arithmetic Op, uint64_t A, uint64_t B) {
+  T X, Y, Z;
+  if constexpr (sizeof(T)==8) {X=std::bit_cast<double>(A); Y=std::bit_cast<double>(B);}
+  else {X=std::bit_cast<float>(uint32_t(A)); Y=std::bit_cast<float>(uint32_t(B));}
+  if constexpr (sizeof(T)==8) {
+    switch(Op) {
+    case Arithmetic::Add: asm("fadd %d0,%d1,%d2" : "=w"(Z) : "w"(X),"w"(Y)); break;
+    case Arithmetic::Sub: asm("fsub %d0,%d1,%d2" : "=w"(Z) : "w"(X),"w"(Y)); break;
+    case Arithmetic::Mul: asm("fmul %d0,%d1,%d2" : "=w"(Z) : "w"(X),"w"(Y)); break;
+    case Arithmetic::Div: asm("fdiv %d0,%d1,%d2" : "=w"(Z) : "w"(X),"w"(Y)); break;
+    case Arithmetic::Sqrt: asm("fsqrt %d0,%d1" : "=w"(Z) : "w"(X)); break;
+    }
+    return std::bit_cast<uint64_t>(Z);
+  } else {
+    switch(Op) {
+    case Arithmetic::Add: asm("fadd %s0,%s1,%s2" : "=w"(Z) : "w"(X),"w"(Y)); break;
+    case Arithmetic::Sub: asm("fsub %s0,%s1,%s2" : "=w"(Z) : "w"(X),"w"(Y)); break;
+    case Arithmetic::Mul: asm("fmul %s0,%s1,%s2" : "=w"(Z) : "w"(X),"w"(Y)); break;
+    case Arithmetic::Div: asm("fdiv %s0,%s1,%s2" : "=w"(Z) : "w"(X),"w"(Y)); break;
+    case Arithmetic::Sqrt: asm("fsqrt %s0,%s1" : "=w"(Z) : "w"(X)); break;
+    }
+    return std::bit_cast<uint32_t>(Z);
+  }
+}
+void GuardTest(Format P, Arithmetic Op, unsigned Top, uint64_t A, uint64_t B,
+               unsigned N, unsigned Layout, unsigned Invalid) {
+  CpuStateFrame Frame {};
+  Frame.State.FCW=P==Format::Binary53?0x027f:0x007f;
+  Frame.State.flags[FEXCore::X86State::X87FLAG_TOP_LOC]=Top;
+  Frame.State.flags[FEXCore::X86State::RFLAG_TF_RAW_LOC]=2; // TF clear, FEX block bit set.
+  Frame.State.AbridgedFTW=(1U<<Top)|(1U<<((Top+1)&7));
+  const unsigned SourceB=Layout==2?0:1, Destination=Layout==1?1:0;
+  Raw80 RA {}, RB {}; Widen(A,P,RA); Widen(B,P,RB);
+  Frame.State.mm[Top][0]=RA.Significand;Frame.State.mm[Top][1]=RA.SignExponent;
+  Frame.State.mm[(Top+1)&7][0]=RB.Significand;Frame.State.mm[(Top+1)&7][1]=RB.SignExponent;
+  GuardRequest Request {N,0,Op,0,uint8_t(SourceB),uint8_t(Destination)};
+  switch(Invalid) {
+  case 1: Frame.State.FCW=0x037f; break;
+  case 2: Frame.State.FCW|=0x400; break;
+  case 3: Frame.State.FCW&=~1U; break;
+  case 4: Request.FPCR=1U<<24; break;
