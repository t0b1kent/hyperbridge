+/* Do not consume a real guest guard fault or promote readonly permissions
+ * while preparing the host mapping for a self write. */
+static BOOL prepare_self_write( void *addr, SIZE_T size )
+{
+    size_t idx, end;
+    sigset_t sigset;
+    BOOL valid = TRUE;
+    if (!size) return TRUE;
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    if (!get_page_range( addr, size, &idx, &end )) valid = FALSE;
+    else for (; idx < end; ++idx)
+    {
+        BYTE vprot = get_page_vprot( (void *)(idx << page_shift) );
+        if (!(vprot & VPROT_COMMITTED) || (vprot & VPROT_GUARD) ||
+            !(vprot & (VPROT_WRITE | VPROT_WRITECOPY)))
+        {
+            valid = FALSE;
+            break;
+        }
+    }
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    return valid && virtual_check_buffer_for_write( addr, size );
+}
