index 37eda6aa0..ce56e9df7 100644
--- a/Source/Windows/UnixLib/CMakeLists.txt
+++ b/Source/Windows/UnixLib/CMakeLists.txt
@@ -5,10 +5,17 @@ include(GNUInstallDirs)
 
 function(CreateLib TargetName LibName)
   add_library(${TargetName} SHARED FEXUnixLib.cpp)
-  set_target_properties(${TargetName} PROPERTIES OUTPUT_NAME ${LibName} PREFIX "lib" SUFFIX ".so")
-  target_link_libraries(${TargetName} PRIVATE rt)
+  set_target_properties(${TargetName} PROPERTIES OUTPUT_NAME ${LibName} PREFIX "" SUFFIX ".so")
+  if (NOT APPLE)
+    target_link_libraries(${TargetName} PRIVATE rt)
+  else()
+    # MacRunner N2: клей грузится dlopen'ом внутрь Wine. Исключения и RTTI ему не нужны,
+    # а тянут за собой libc++abi — снимаем, чтобы список импортов остался коротким.
+    target_compile_options(${TargetName} PRIVATE -fno-exceptions -fno-rtti)
+  endif()
   install(TARGETS ${TargetName} LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Runtime)
 endfunction()
 
-CreateLib(wow64fex_unixlib wow64fex)
-CreateLib(arm64ecfex_unixlib arm64ecfex)
+# MacRunner N3 2026-09-07: basename спутника обязан совпадать с PE.
+CreateLib(wow64fex_unixlib xtajit)
+CreateLib(arm64ecfex_unixlib xtajit64)
