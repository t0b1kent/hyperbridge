index 0c9a57a17..1de759a3d 100644
--- a/Source/Windows/ARM64EC/CMakeLists.txt
+++ b/Source/Windows/ARM64EC/CMakeLists.txt
@@ -4,6 +4,10 @@ add_library(arm64ecfex SHARED
   libarm64ecfex.def
   $<TARGET_OBJECTS:FEXCore_object>)
 
+# MacRunner N3 2026-09-07: HKLM\Software\Microsoft\Wow64\amd64 = "xtajit64.dll"
+# (loader/wine.inf.in:396). Имя цели сборки arm64ecfex оставлено как есть.
+set_target_properties(arm64ecfex PROPERTIES OUTPUT_NAME "xtajit64" PREFIX "" SUFFIX ".dll")
+
 patch_library_wine(arm64ecfex)
 
 target_include_directories(arm64ecfex PRIVATE
