diff --git a/FEXCore/Source/Utils/Allocator.cpp b/FEXCore/Source/Utils/Allocator.cpp
index 2060f269c..cabe127bb 100644
--- a/FEXCore/Source/Utils/Allocator.cpp
+++ b/FEXCore/Source/Utils/Allocator.cpp
@@ -314,10 +314,59 @@ void VirtualTHPNOP(const void* Ptr, size_t Size, THPControl Control) {}
 VirtualNamePtr VirtualName {VirtualNameNOP};
 VirtualTHPPtr VirtualTHPControl {VirtualTHPNOP};
 
+// ★ MacRunner N2b: НЕ пустышки, а нулевые указатели. Разница смысловая: пустышка
+// «успешно ничего не сделала» и её невозможно отличить от работающего клея, а nullptr
+// прямо говорит «клей не подключён» — и тогда скобка записи обязана быть НИЧЕМ, потому
+// что на Linux/Proton кодовый буфер и так RWX. Тот самый случай «гейт, активность
+// которого не доказана, считается выключенным».
+MarkJITMemoryPtr MarkJITMemory {};
+EnableJITExecPtr EnableJITExec {};
+
 void SetupHooks(size_t PageSize, HookPtrs Ptrs) {
   VirtualName = Ptrs.VirtualName;
   VirtualTHPControl = Ptrs.VirtualTHPControl;
+  MarkJITMemory = Ptrs.MarkJITMemory;
+  EnableJITExec = Ptrs.EnableJITExec;
 }
 
+#endif
+
+// ★★★ MacRunner N2b 2026-09-07 — состояние скобки записи. ПОТОКОВОЕ.
+//
+// ★★★ ЗДЕСЬ БЫЛ `thread_local`, И ЭТО СТОИЛО ПРОГОНА. РАЗБОР, ДОКАЗАННЫЙ АРТЕФАКТОМ:
+//
+//   Собранный xtajit.dll:  каталог данных TLS (индекс 9) = rva 0, size 0.
+//   То же у чистого upstream libwow64fex.dll — то есть каталога нет НИ У КОГО.
+//
+// PE-модули FEX собираются со СВОЕЙ минимальной CRT (Source/Windows/Common/CRT), которая
+// объявляет `uint64_t _tls_index;` руками и НЕ заводит ни секции `.tls`, ни каталога TLS.
+// Значит загрузчик не выделяет модулю слот, `TEB->ThreadLocalStoragePointer` его не
+// содержит, и ПЕРВОЕ ЖЕ обращение к `thread_local` — отказ доступа.
+//
+// Проверено, что это первое такое обращение вообще: `thread_local` во всём FEXCore есть
+// ровно в трёх файлах, и два из них (AllocatorOverride.cpp, 64BitAllocator.cpp) в PE НЕ
+// компилируются — в каталоге сборки их объектов нет.
+//
+// Замер, показавший это: зонд по шагам BTCpuProcessInit печатал шаги 0..8 и обрывался,
+// а зонд ВНУТРИ обёртки EnableJITExec (`macrunner-fex-call7`) не печатался ни разу —
+// то есть отказ случался ДО вызова, на самом первом операторе JITWriteThreadInit,
+// а он как раз и был обращением к `thread_local`.
+//
+// ПОЭТОМУ состояние живёт в слоте Win32 TLS (`TlsAlloc`), и реализация вынесена в
+// Source/Windows/Common/Allocator.cpp — туда, где Win32 доступен законно. Здесь остаются
+// только линуксовые пустышки.
+//
+// Почему счётчик, а не bool: ExitFunctionLink открывает скобку и внутри неё может позвать
+// CompileBlock, который откроет свою. Bool закрыл бы внешнюю на выходе из внутренней и
+// включил исполнение посреди чужой записи.
+#ifndef _WIN32
+// Linux: кодовый буфер RWX по устройству платформы, переключать нечего.
+void JITWriteThreadInit() {}
+void JITWriteEnter() {}
+void JITWriteLeave() {}
+void JITWriteResetForResume(bool) {}
+uint32_t JITWriteCurrentDepth() {
+  return 0;
+}
 #endif
 } // namespace FEXCore::Allocator
diff --git a/FEXCore/Source/Utils/ArchHelpers/Arm64.cpp b/FEXCore/Source/Utils/ArchHelpers/Arm64.cpp
index 01e5bb22e..3ffd2ffee 100644
--- a/FEXCore/Source/Utils/ArchHelpers/Arm64.cpp
+++ b/FEXCore/Source/Utils/ArchHelpers/Arm64.cpp
@@ -5,6 +5,7 @@
 #include <FEXCore/Utils/SpinWaitLock.h>
 
 #include <FEXCore/Debug/InternalThreadState.h>
+#include <FEXCore/Utils/AllocatorHooks.h>
 #include <FEXCore/Utils/EnumUtils.h>
 #include <FEXCore/Utils/LogManager.h>
 #include <FEXCore/Utils/Telemetry.h>
@@ -2100,6 +2101,15 @@ std::optional<int32_t> HandleUnalignedAccess(FEXCore::Core::InternalThreadState*
     }
   }
 
+  // ★★★ MacRunner N2b — скобка записи открывается ДО захвата SpinLockFutex, не только
+  // перед PC[0]. Причина конкретная: InlineTail (в нём и лежит SpinLockFutex) размещён
+  // ВМЕСТЕ с выпущенным кодом, в том же отображении JIT. Захват замка — это запись в
+  // него, и в режиме «исполнять» она упрётся в W^X раньше, чем дело дойдёт до правки
+  // команды. Объявлена ДО lk, значит разрушается ПОСЛЕ него — режим исполнения
+  // восстанавливается после снятия замка, на ЛЮБОМ выходе из функции, включая все
+  // ветви return ниже (LDAR/LDAPR, STLR, LDAPUR, STLUR и их половинные барьеры).
+  FEXCore::Allocator::ScopedJITWrite JITWrite;
+
   // Lock code mutex during any SIGBUS handling that potentially changes code.
   // Due to code buffer sharing between threads, code must be carefully backpatched from last to first.
   // Multiple threads can be attempting to handle the SIGBUS or even be executing the code being backpatched.
diff --git a/FEXCore/include/FEXCore/Utils/AllocatorHooks.h b/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
index cccce4d56..49c6451b8 100644
--- a/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
+++ b/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
@@ -37,29 +37,91 @@ FEX_DEFAULT_VISIBILITY void SetupHooks(size_t PageSize);
 #else
 using VirtualNamePtr = void (*)(const char*, const void*, size_t);
 using VirtualTHPPtr = void (*)(const void*, size_t, THPControl);
+// MacRunner N2b 2026-09-07 — обработчики 6 и 7 дарвиновского клея.
+// MarkJITMemory  проверяет, что выделение действительно легло в область MAP_JIT.
+// EnableJITExec  переключает режим ВЫЗЫВАЮЩЕГО ПОТОКА: 0 = писать (исполнять нельзя),
+//                1 = исполнять (писать нельзя). Состояние потоковое, не процессное.
+using MarkJITMemoryPtr = bool (*)(void*, size_t);
+using EnableJITExecPtr = bool (*)(int32_t);
 struct HookPtrs {
   VirtualNamePtr VirtualName;
   VirtualTHPPtr VirtualTHPControl;
+  MarkJITMemoryPtr MarkJITMemory;
+  EnableJITExecPtr EnableJITExec;
 };
 FEX_DEFAULT_VISIBILITY void SetupHooks(size_t PageSize, HookPtrs Ptrs);
 #endif
 FEX_DEFAULT_VISIBILITY void ClearHooks();
 
+// ★★★ MacRunner N2b 2026-09-07 — W^X ПОТОКА (обработчик 7).
+//
+// ЗАЧЕМ. Область MAP_JIT на Apple Silicon НЕ бывает одновременно записываемой и
+// исполняемой ДЛЯ ОДНОГО ПОТОКА. Переключает это не mprotect (лейн N2 замерил: область
+// MAP_JIT принимает mprotect ровно один раз, дальше 2000 отказов из 2000), а потоковый
+// pthread_jit_write_protect_np — он и стоит за обработчиком 7.
+//
+// ОТСЮДА КОНСТРУКЦИЯ. Поток FEX живёт в режиме «исполнять» и на время КАЖДОЙ записи в
+// свою кодовую память опускается в режим «писать». Скобка ниже — единственный способ это
