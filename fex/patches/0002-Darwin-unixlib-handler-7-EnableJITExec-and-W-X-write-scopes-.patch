+++ b/CMakeLists.txt
@@ -36,6 +36,15 @@ set_property(CACHE FEXCORE_PROFILER_BACKEND PROPERTY STRINGS gpuvis tracy)
 option(ENABLE_GLIBC_ALLOCATOR_HOOK_FAULT "Enables glibc memory allocation hooking with fault for CI testing")
 option(USE_PDB_DEBUGINFO "Build debug info in PDB format" FALSE)
 option(BUILD_STEAM_SUPPORT "Enable Steam integration" FALSE)
+# ★★★ MacRunner N2b 2026-09-07 — PE-половина собирается ДЛЯ ДАРВИНОВСКОГО КЛЕЯ.
+# Включает вызовы обработчиков 6 и 7 UnixLib (MarkJITMemory / EnableJITExec) и делает
+# клей ОБЯЗАТЕЛЬНЫМ. Без этого гейта вызывать индексы 6/7 НЕЛЬЗЯ: у апстримового
+# спутника таблица шестиместная, а __wine_unix_call_dispatcher индексирует её БЕЗ
+# проверки границ — то есть был бы дикий вызов, а не отказ.
+option(FEX_WINE_DARWIN "MacRunner: PE-половина для дарвиновского клея с восьмиместной таблицей UnixLib" FALSE)
+if (FEX_WINE_DARWIN)
+  add_compile_definitions(FEX_WINE_DARWIN=1)
+endif()
 
