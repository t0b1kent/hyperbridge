+void JITWriteThreadInit() {
+  JITWriteSlotSet(JITWriteReadyBit);
+  if (EnableJITExec) {
+    // Режим «исполнять» назначается ЯВНО на каждом потоке: умолчание ядра для нового
+    // потока мы не мерили, а гейт, активность которого не доказана, считается выключенным.
+    EnableJITExec(1);
+  }
