+    // включило бы исполнение посреди чужой записи, и отказ вылез бы далеко от причины.
+    FEX::Windows::Logging::Raw("macrunner-fex-jitwrite-ДОГОВОР: Leave при глубине 0\n");
+    return;
+  }
+  JITWriteSlotSet(((Depth - 1) << 1) | (Slot & JITWriteReadyBit));
+  if (Depth == 1) {
+    EnableJITExec(1);
+  }
+}
+
+void JITWriteResetForResume(bool WantExec) {
+  if (!EnableJITExec) {
+    return;
+  }
+  const uintptr_t Slot = JITWriteSlotGet();
+  if ((Slot >> 1) != 0) {
