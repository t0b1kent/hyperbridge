+void JITWriteEnter() {
+  if (!EnableJITExec) {
+    return;
+  }
+  uintptr_t Slot = JITWriteSlotGet();
+  if (!(Slot & JITWriteReadyBit)) {
+    // Поток пишет код, ни разу не пройдя JITWriteThreadInit. Это НЕ безобидно: значит есть
+    // вход в JIT мимо ProcessInit/ThreadInit (у ARM64EC такой вход есть прямо в
+    // Module.S:39,52). Сообщаем один раз на поток и лечим здесь же.
+    Slot |= JITWriteReadyBit;
