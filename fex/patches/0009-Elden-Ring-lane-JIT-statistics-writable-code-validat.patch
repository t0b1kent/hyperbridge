 #include <FEXCore/Utils/EnumUtils.h>
 #include <FEXCore/Utils/LogManager.h>
 
+#include <atomic>
 #include <cstdint>
+#include <cstdlib>
 #include <cstring>
 
+// ★ MacRunner Opus 19.09.2026 — «последний блок» без обхода всего списка.
+// CreateNewCodeBlockAfter(nullptr) шёл по Header.Next от текущего блока до конца списка на
+// каждый выход за пределы многоблочной трансляции: O(блоков) на выход, O(N^2) на трансляцию.
+// В профиле загрузки Elden Ring (прогон 085) это 22.8 % занятости главного потока.
+// Все блоки трансляции лежат в одной цепочке (CreateJumpBlocks + CreateNewCodeBlockAfter),
+// поэтому проход от ЛЮБОГО её узла приходит к тому же последнему блоку. Подсказка — узел,
+// последним добавленный в конец; сбрасывается в ResetWorkingList (перед каждой трансляцией).
+// MACRUNNER_FEX_BLOCKWALK_FIX: 0 (по умолчанию) = как было; 1 = идти от подсказки;
+// 2 = считать обоими способами, использовать старый, считать расхождения.
+std::atomic<uint64_t> MacRunnerJitWalkSteps {0};
+std::atomic<uint64_t> MacRunnerJitWalkCalls {0};
+std::atomic<uint64_t> MacRunnerJitWalkMismatch {0};
+int MacRunnerBlockWalkMode() {
+  static const int Mode = [] {
+    const char* Value = getenv("MACRUNNER_FEX_BLOCKWALK_FIX");
+    return (Value && Value[0] >= '0' && Value[0] <= '2' && !Value[1]) ? Value[0] - '0' : 0;
+  }();
+  return Mode;
+}
+
 namespace FEXCore::IR {
+namespace {
+// НЕ thread_local: у PE-модулей FEX нет каталога TLS (_tls_index вручную = 0), и thread_local
+// пишет в TLS-блок ГЛАВНОГО модуля (слот 0). В прогоне 087 это испортило TLS Elden Ring
+// (падение 0x140E649C3, чтение 0x2FEB). См. Utils/Allocator.cpp «ЗДЕСЬ БЫЛ thread_local».
+// Подсказка — НОМЕР блока в собственном CodeBlocks эмиттера (+ метка владельца), одно
+// 64-битное атомарное значение. Номер разыменовывается только в СВОЁМ CodeBlocks, а любой
+// уже связанный блок своей цепочки ведёт к тому же концу — поэтому даже чужая подсказка
+// (совпадение метки) не ломает результат, только удлиняет проход.
+constexpr size_t MacRunnerHintSlots = 1024;
+std::atomic<uint64_t> MacRunnerHint[MacRunnerHintSlots];
+size_t MacRunnerHintSlot(const void* Owner) {
+  return size_t(((reinterpret_cast<uintptr_t>(Owner) >> 4) * 0x9E3779B97F4A7C15ull) >> 54);
+}
+uint64_t MacRunnerHintTag(const void* Owner) {
+  return (uint64_t(uint32_t(reinterpret_cast<uintptr_t>(Owner) >> 4)) | 1) << 32;
+}
+} // namespace
 
