@@ -165,14 +205,43 @@ IREmitter::IRPair<IROp_CodeBlock> IREmitter::CreateNewCodeBlockAfter(Ref insertA
     LOGMAN_THROW_A_FMT(CurrentCodeBlock != nullptr, "CurrentCodeBlock must not be null here");
 
     // Find last block
-    auto LastBlock = CurrentCodeBlock;
+    const int Mode = MacRunnerBlockWalkMode();
+    // CodeBlocks.back() — только что созданный и ещё НЕ связанный узел: его исключаем.
+    const uint64_t Packed = MacRunnerHint[MacRunnerHintSlot(this)].load(std::memory_order_relaxed);
+    const size_t HintIndex = size_t(uint32_t(Packed));
+    Ref HintNode = nullptr;
+    if ((Packed & ~uint64_t {0xffffffff}) == MacRunnerHintTag(this) && HintIndex + 1 < CodeBlocks.size()) {
+      HintNode = CodeBlocks[HintIndex];
+      if (HintNode->Op(DualListData.DataBegin())->Op != OP_CODEBLOCK) {
+        HintNode = nullptr;
+      }
+    }
+    const bool HaveHint = HintNode != nullptr;
+    auto LastBlock = (Mode == 1 && HaveHint) ? HintNode : CurrentCodeBlock;
+    uint64_t Steps = 0;
 
     while (LastBlock->Header.Next.GetNode(DualListData.ListBegin()) != InvalidNode) {
       LastBlock = LastBlock->Header.Next.GetNode(DualListData.ListBegin());
+      ++Steps;
     }
 
+    if (Mode == 2 && HaveHint) {
+      auto FromHint = HintNode;
+      while (FromHint->Header.Next.GetNode(DualListData.ListBegin()) != InvalidNode) {
+        FromHint = FromHint->Header.Next.GetNode(DualListData.ListBegin());
+      }
+      if (FromHint != LastBlock) {
+        MacRunnerJitWalkMismatch.fetch_add(1, std::memory_order_relaxed);
+      }
+    }
+    MacRunnerJitWalkSteps.fetch_add(Steps, std::memory_order_relaxed);
+    MacRunnerJitWalkCalls.fetch_add(1, std::memory_order_relaxed);
+
     // Append it after the last block
     LinkCodeBlocks(LastBlock, CodeNode);
+    if (!CodeBlocks.empty() && CodeBlocks.back() == static_cast<Ref>(CodeNode)) {
+      MacRunnerHint[MacRunnerHintSlot(this)].store(MacRunnerHintTag(this) | uint64_t(CodeBlocks.size() - 1), std::memory_order_relaxed);
+    }
   }
 
   SetWriteCursor(OldCursor);
