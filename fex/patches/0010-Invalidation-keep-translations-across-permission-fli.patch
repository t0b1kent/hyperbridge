+// SPDX-License-Identifier: MIT
+#pragma once
+// ★ MacRunner (Claude, 23.09.2026) — классы страниц для возврата перевода (MACRUNNER_FEX_REVIVE).
+//   Чистые функции: разбор диапазона байтов гостя на куски «интервал исполняемого × страница хоста»
+//   с классом и правило, можно ли вернуть перевод. Вынесены отдельно, чтобы ровно этот код проверялся
+//   тестами на хосте (tests/revive_test.cpp). Запрос прав передаётся функцией: в FEX это
+//   SyscallHandler->QueryGuestExecutableRange, в тесте — модель.
+#include <algorithm>
+#include <cstdint>
+
+namespace FEX::MacRunnerRevive {
+struct Seg {
+  uint64_t Begin, End;
+  uint8_t Class; // 0 — без записи; 1 — запись, страница хоста целиком в интервале (ловушка); 2 — смешанная
+};
+
+// Query(Address) -> {Base, Size, Writable} интервала исполняемого, содержащего Address; Size == 0 — нет.
+// Класс считается так же, как проверка записываемого кода в GenerateIR: страница хоста целиком внутри
+// интервала RWX — ловушка видит запись (1); иначе — только проверка байтов в коде (2).
+template<typename Vector, typename QueryFn>
+bool Segments(QueryFn&& Query, uint64_t Begin, uint64_t End, uint64_t HostPage, Vector& Out) {
+  Out.clear();
+  uint64_t Address = Begin;
+  while (Address < End) {
+    const auto Range = Query(Address);
+    if (!Range.Size || Address < Range.Base || Address >= Range.Base + Range.Size) {
+      return false;
+    }
+    const uint64_t RangeEnd = std::min<uint64_t>(End, Range.Base + Range.Size);
+    while (Address < RangeEnd) {
+      const uint64_t HostFirst = Address & ~(HostPage - 1);
+      const uint64_t ChunkEnd = std::min<uint64_t>(RangeEnd, HostFirst + HostPage);
+      uint8_t Class = 0;
+      if (Range.Writable) {
+        Class = (Range.Base <= HostFirst && HostFirst + HostPage <= Range.Base + Range.Size) ? 1 : 2;
+      }
+      Out.push_back({Address, ChunkEnd, Class});
+      Address = ChunkEnd;
+    }
+  }
+  return true;
+}
+
+// Там, где СЕЙЧАС класс 2 (ловушка слепа), при компиляции тоже должен был быть класс 2 — тогда в коде
+// есть проверка байтов. Класс 0 и 1 сейчас безопасны при любом прошлом: записи нет или её ловит ловушка
+// (при возврате новые страницы блока ставятся под ловушку так же, как при компиляции).
+template<typename Vector>
+bool ClassesAllow(const Vector& Then, const Vector& Now) {
+  size_t I = 0, J = 0;
+  while (I < Then.size() && J < Now.size()) {
+    const uint64_t Begin = std::max(Then[I].Begin, Now[J].Begin);
+    const uint64_t End = std::min(Then[I].End, Now[J].End);
+    if (Begin < End && Now[J].Class == 2 && Then[I].Class != 2) {
+      return false;
+    }
+    if (Then[I].End <= Now[J].End) {
+      ++I;
+    } else {
+      ++J;
+    }
+  }
+  return true;
+}
+} // namespace FEX::MacRunnerRevive
