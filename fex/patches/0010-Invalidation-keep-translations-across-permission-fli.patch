diff --git a/Source/Windows/Common/MacRunnerProtKeep.h b/Source/Windows/Common/MacRunnerProtKeep.h
new file mode 100644
index 000000000..bee679ee8
--- /dev/null
+++ b/Source/Windows/Common/MacRunnerProtKeep.h
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+// ★ MacRunner (Claude, 23.09.2026) — план смены прав для MACRUNNER_FEX_PROT_KEEP.
+//   Чистая функция: на входе XIntervals ДО смены прав и новый диапазон, на выходе — что сбросить,
+//   что поставить под ловушку записи и сколько байт перевода оставить. Вынесена отдельно, чтобы
+//   ровно этот код проверялся тестами на хосте (tests/prot_keep_test.cpp).
+#include <FEXCore/Utils/IntervalList.h>
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+
+namespace FEX::Windows::MacRunnerProtKeep {
+struct Span {
+  uint64_t Begin, End;
+};
+constexpr size_t MaxSpans = 64;
+
+struct Plan {
+  Span Invalidate[MaxSpans];
+  size_t InvalidateCount = 0;
+  Span Trap[MaxSpans];
+  size_t TrapCount = 0;
+  uint64_t KeptBytes = 0;
+  bool Overflow = false; // не хватило места — вызывающий обязан сбросить весь диапазон, как upstream
+};
+
+// Mode 1: уже исполняемое, переходящее в исполняемое БЕЗ записи, — оставить; остальное — сбросить.
+// Mode 2: + уже исполняемое, переходящее в RWX: целые страницы хоста — под ловушку, края — сбросить.
+// Новое исполняемое (не было в XIntervals) сбрасывается всегда: запись туда не отслеживалась.
+inline Plan Compute(const FEXCore::IntervalList<uint64_t>& XIntervals, uint64_t Begin, uint64_t End, bool NewWritable, int Mode,
+                    uint64_t HostPageSize) {
+  Plan Result;
+  const uint64_t HostPageMask = ~(HostPageSize - 1);
+  auto Push = [&](Span* List, size_t& Count, uint64_t SpanBegin, uint64_t SpanEnd) {
+    if (SpanBegin >= SpanEnd) {
+      return;
+    }
+    // Соседние куски сливаем: меньше вызовов сброса и меньше риск переполнения.
+    if (Count && List[Count - 1].End == SpanBegin) {
+      List[Count - 1].End = SpanEnd;
+      return;
+    }
+    if (Count == MaxSpans) {
+      Result.Overflow = true;
+      return;
+    }
+    List[Count++] = {SpanBegin, SpanEnd};
+  };
+
+  uint64_t Cursor = Begin;
+  while (Cursor < End) {
+    const auto Query = XIntervals.Query(Cursor);
+    uint64_t Next;
+    if (Query.Enclosed) {
+      Next = std::min<uint64_t>(End, Cursor + Query.Size);
+      // IntervalList не сливает интервалы стык в стык ([a,b) и [b,c) остаются раздельными), а права
+      // ставят соседними кусками. Продлеваем кусок через стыки — иначе страница хоста на стыке
+      // не получила бы ловушку и сбрасывалась зря (найдено тестом, 907 случаев из 200 000).
+      while (Next < End) {
+        const auto Touching = XIntervals.Query(Next);
+        if (!Touching.Enclosed) {
+          break;
+        }
+        Next = std::min<uint64_t>(End, Next + Touching.Size);
+      }
+      if (!NewWritable) {
+        Result.KeptBytes += Next - Cursor;
+      } else if (Mode >= 2) {
+        const uint64_t InnerBegin = (Cursor + HostPageSize - 1) & HostPageMask;
+        const uint64_t InnerEnd = Next & HostPageMask;
+        if (InnerBegin < InnerEnd) {
+          Push(Result.Invalidate, Result.InvalidateCount, Cursor, InnerBegin);
+          Push(Result.Trap, Result.TrapCount, InnerBegin, InnerEnd);
+          Push(Result.Invalidate, Result.InvalidateCount, InnerEnd, Next);
+        } else {
+          Push(Result.Invalidate, Result.InvalidateCount, Cursor, Next);
+        }
+      } else {
+        Push(Result.Invalidate, Result.InvalidateCount, Cursor, Next);
+      }
+    } else {
+      Next = Query.Size ? std::min<uint64_t>(End, Cursor + Query.Size) : End;
+      Push(Result.Invalidate, Result.InvalidateCount, Cursor, Next);
+    }
+    Cursor = Next;
+  }
+  if (Result.Overflow) {
+    Result.TrapCount = 0;
+  }
+  return Result;
+}
+} // namespace FEX::Windows::MacRunnerProtKeep
