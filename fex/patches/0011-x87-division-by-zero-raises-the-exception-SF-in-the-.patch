           } else {
             auto* OriginalNode = CurrentIR.GetNode(Op->OriginalValue);
-            StackData.push(StackMemberInfo {SourceNode, OriginalNode, Op->LoadSize});
+            StackData.push(StackMemberInfo {PushedNode, OriginalNode, Op->LoadSize});
