From 75037573201d49e7cf521a11604d48ad6a9ec491 Mon Sep 17 00:00:00 2001
From: Timur Ravilov <93673987+t0b1kent@users.noreply.github.com>
Date: Wed, 30 Sep 2026 04:52:27 +1000
Subject: [PATCH 22/80] EXPERIMENT: keep pre-exception PF/AF/DF across an
 exception return (MACRUNNER_FEX_EFLAGS_KEEP)

An ARM64EC context carries only NZCV and SS, so a guest exception handler never
sees PF/AF/DF and cannot change them; that matches Prism on Windows 11 ARM
(eflags_probe.exe, 8 cases). What differed from Prism is the return:
SyncThreadContext merged the flags the context does not carry from the current
JIT state, which the handler's own x64 code had already changed (PF lost),
while Prism restores the values from before the exception.

With the gate, the full guest EFlags are saved at exception delivery on a small
per-thread stack keyed by the guest RSP, and SyncThreadContext takes the
non-EC bits from the entry whose RSP matches the context it restores. Entries
below the restored RSP belong to frames unwound past (longjmp/RtlUnwind) and
are dropped; without a match the old behaviour applies.

Svod-Origin: exp-inv-20260929 b043b3f94 (0039 of fexbuild-0019s)
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../FEXCore/Debug/InternalThreadState.h       | 12 +++++
 Source/Windows/ARM64EC/Module.cpp             | 47 +++++++++++++++++++
 2 files changed, 59 insertions(+)

diff --git a/FEXCore/include/FEXCore/Debug/InternalThreadState.h b/FEXCore/include/FEXCore/Debug/InternalThreadState.h
index 42feabb1c..9dff41e26 100644
--- a/FEXCore/include/FEXCore/Debug/InternalThreadState.h
+++ b/FEXCore/include/FEXCore/Debug/InternalThreadState.h
@@ -123,6 +123,18 @@ struct alignas(FEXCore::Utils::FEX_PAGE_SIZE) InternalThreadState : public FEXCo
 
   // Can be reprotected as RO to trigger an interrupt at generated code block entrypoints
   alignas(FEXCore::Utils::FEX_PAGE_SIZE) uint8_t InterruptFaultPage[FEXCore::Utils::FEX_PAGE_SIZE];
+
+  // ★ MacRunner (MACRUNNER_FEX_EFLAGS_KEEP): полные EFlags гостя на момент доставки исключения — стек по вложенности,
+  //   ключ — RSP гостя; SyncThreadContext возвращает из него PF/AF/DF после обработчика (так делает Prism).
+  struct MRSavedEFlagsEntry {
+    uint64_t Rsp;
+    uint32_t EFlags;
+  };
+  // Стоит ПОСЛЕ InterruptFaultPage: вставка в середину сдвигала смещения полей, которые код читает командами с
+  // масштабированным смещением (ld.lld: misaligned ldr/str offset).
+  alignas(16) MRSavedEFlagsEntry MRSavedEFlags[8] {};
+  uint64_t MRSavedEFlagsCount {};
+  uint64_t MRSavedEFlagsPad {};
 };
 static_assert(std::is_standard_layout_v<FEXCore::Core::InternalThreadState>);
 // Maximum unsigned-offset store range for fault page.
diff --git a/Source/Windows/ARM64EC/Module.cpp b/Source/Windows/ARM64EC/Module.cpp
index 6c28d3537..42f055726 100644
--- a/Source/Windows/ARM64EC/Module.cpp
+++ b/Source/Windows/ARM64EC/Module.cpp
@@ -54,6 +54,7 @@ extern std::atomic<uint64_t> MacRunnerJitSMC; // ★ MacRunner Opus 19.09: оп
 #include "Windows/Common/SHMStats.h"
 
 #include <cstdint>
+#include <cstdlib>
 #include <cstdio>
 #include <type_traits>
 #include <mutex>
@@ -399,6 +400,43 @@ static void LoadStateFromECContext(FEXCore::Core::InternalThreadState* Thread, C
   }
 }
 
+// ★ MacRunner (Claude, 30.09.2026) — MACRUNNER_FEX_EFLAGS_KEEP=1: флаги, которые контекст ARM64EC не несёт (PF/AF/DF и
+//   прочие вне NZCV+SS), после возврата из обработчика исключения — такие, какими были ДО исключения. Так делает Prism
+//   (проба eflags_probe.exe, 8 случаев, ДОЛГ.md EFLAGS-ИСКЛЮЧЕНИЯ); без гейта SyncThreadContext берёт их из текущего
+//   состояния JIT, которое испортил x64-код обработчика (PF теряется). Ключ — RSP гостя: продолжение исключения
+//   возвращается на тот же RSP; записи с RSP ниже текущего остались от раскрученных (longjmp/unwind) кадров.
+static bool MREFlagsKeep() {
+  // Без статической переменной с ленивой инициализацией: её страж в этом модуле не компонуется (ld.lld: misaligned
+  // ldr/str offset). Путь исключений редкий — чтение окружения на каждый вызов ничего не стоит.
+  const char* Value = getenv("MACRUNNER_FEX_EFLAGS_KEEP");
+  return Value && Value[0] == '1' && !Value[1];
+}
+
+static void MRPushSavedEFlags(FEXCore::Core::InternalThreadState* Thread, uint64_t Rsp, uint32_t EFlags) {
+  auto& Count = Thread->MRSavedEFlagsCount;
+  constexpr uint64_t Capacity = sizeof(Thread->MRSavedEFlags) / sizeof(Thread->MRSavedEFlags[0]);
+  if (Count == Capacity) {
+    // Переполнение (очень глубокая вложенность): отбросить самую старую запись.
+    for (uint64_t I = 1; I < Capacity; ++I) {
+      Thread->MRSavedEFlags[I - 1] = Thread->MRSavedEFlags[I];
+    }
+    --Count;
+  }
+  Thread->MRSavedEFlags[Count++] = {Rsp, EFlags};
+}
+
+static bool MRPopSavedEFlags(FEXCore::Core::InternalThreadState* Thread, uint64_t Rsp, uint32_t* Out) {
+  auto& Count = Thread->MRSavedEFlagsCount;
+  while (Count && Thread->MRSavedEFlags[Count - 1].Rsp < Rsp) {
+    --Count;
+  }
+  if (Count && Thread->MRSavedEFlags[Count - 1].Rsp == Rsp) {
+    *Out = Thread->MRSavedEFlags[--Count].EFlags;
+    return true;
+  }
+  return false;
+}
+
 static void ReconstructThreadState(FEXCore::Core::InternalThreadState* Thread, ARM64_NT_CONTEXT& Context) {
   const auto& Config = SignalDelegator->GetConfig();
   auto& State = Thread->CurrentFrame->State;
@@ -561,6 +599,9 @@ static void RethrowGuestException(const EXCEPTION_RECORD& Rec, ARM64_NT_CONTEXT&
   // Current ARM64EC windows can only restore NZCV+SS when returning from an exception and other flags are left untouched from the handler context.
   // TODO: Can extend wine to support this by mapping the remaining EFlags into reserved cpsr members.
   uint32_t EFlags = CTX->ReconstructCompactedEFLAGS(Thread, false, nullptr, 0);
+  if (MREFlagsKeep()) {
+    MRPushSavedEFlags(Thread, GuestSp, EFlags);
+  }
   EFlags &= ~(1 << FEXCore::X86State::RFLAG_TF_RAW_LOC);
   CTX->SetFlagsFromCompactedEFLAGS(Thread, EFlags);
 
@@ -640,6 +681,12 @@ extern "C" void SyncThreadContext(CONTEXT* Context) {
                                                (1U << FEXCore::X86State::RFLAG_TF_RAW_LOC)};
 
   uint32_t StateEFlags = CTX->ReconstructCompactedEFLAGS(Thread, false, nullptr, 0);
+  if (Exception::MREFlagsKeep()) {
+    uint32_t Saved;
+    if (Exception::MRPopSavedEFlags(Thread, Context->Rsp, &Saved)) {
+      StateEFlags = Saved;
+    }
+  }
   Context->EFlags = (Context->EFlags & ECValidEFlagsMask) | (StateEFlags & ~ECValidEFlagsMask);
   Exception::LoadStateFromECContext(Thread, *Context);
 }
