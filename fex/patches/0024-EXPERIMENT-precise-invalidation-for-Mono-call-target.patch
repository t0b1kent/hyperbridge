     CodePages.erase(lower, upper);
+    if (!MRSpans.empty()) {
+      MRSpans.erase(MRSpans.lower_bound(Start >> 12), MRSpans.upper_bound((Start + Length - 1) >> 12));
+    }
+  }
+
+  // ★ MacRunner (Claude, 29.09.2026) — MACRUNNER_FEX_MONO_BP_PRECISE: охват байтов гостя [Begin, End) каждого перевода
+  //   по страницам. Заплатка адреса вызова Mono снимает только переводы, чей охват задевает изменённые байты, а не всю
+  //   страницу 4 КБ (на HK до меню 17 233 заплатки -> 17 тыс. сбросов страниц и ~29 тыс. повторных переводов соседей).
+  struct MRSpan {
+    uint64_t Entry;
+    uint64_t Begin;
+    uint64_t End;
+  };
+  fextl::map<uint64_t, fextl::vector<MRSpan>> MRSpans;
+
+  void MRAddSpans(const std::ranges::input_range auto& Entries, uint64_t Page, uint64_t Begin, uint64_t End, const LookupCacheWriteLockToken&) {
+    auto& Spans = MRSpans[Page >> 12];
+    for (uint64_t Entry : Entries) {
+      Spans.push_back({Entry, Begin, End});
+    }
+  }
+
+  // Снимает точки входа со страниц [Start, Start + Length), если хоть один их перевод задевает эти байты. Точка входа
+  // без записи охвата (кеш кода, перевод до включения гейта) снимается всегда — как при обычном сбросе страницы.
+  void MRInvalidatePrecise(uint64_t Start, uint64_t Length, fextl::vector<uint64_t>& Erased) {
+    auto lk = AcquireWriteLock();
+    const uint64_t End = Start + Length;
+    for (uint64_t Page = Start >> 12, LastPage = (End - 1) >> 12; Page <= LastPage; ++Page) {
+      auto PageIt = CodePages.find(Page);
+      if (PageIt == CodePages.end()) {
+        continue;
+      }
+      fextl::robin_map<uint64_t, bool> Hit;
+      if (auto SpanIt = MRSpans.find(Page); SpanIt != MRSpans.end()) {
+        auto& Spans = SpanIt->second;
+        for (size_t I = 0; I < Spans.size();) {
+          const bool Overlaps = Spans[I].Begin < End && Start < Spans[I].End;
+          auto& Seen = Hit[Spans[I].Entry];
+          Seen = Seen || Overlaps;
+          if (Overlaps) {
+            Spans[I] = Spans.back();
+            Spans.pop_back();
+          } else {
+            ++I;
+          }
+        }
+      }
+      auto& Entries = PageIt->second;
+      for (size_t I = 0; I < Entries.size();) {
+        const uint64_t Entry = Entries[I];
+        if (auto Known = Hit.find(Entry); Known != Hit.end() && !Known->second) {
+          ++I;
+          continue;
+        }
+        if (Erase(Entry, lk)) {
+          Erased.push_back(Entry);
+        }
+        Entries[I] = Entries.back();
+        Entries.pop_back();
+      }
+      if (Entries.empty()) {
+        CodePages.erase(PageIt);
+      }
+    }
   }
 
