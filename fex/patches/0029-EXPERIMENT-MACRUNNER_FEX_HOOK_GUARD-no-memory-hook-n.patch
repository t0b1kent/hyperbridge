 // остальные биты — глубина вложенности.
+extern std::atomic<uint64_t> MacRunnerHookSuppressed[5], MacRunnerHookMaxDepth; // Core.cpp (HookGuard)
+
 namespace {
 constexpr uintptr_t JITWriteReadyBit = 1;
 DWORD JITWriteTlsIndex = TLS_OUT_OF_INDEXES;
+DWORD HookGuardTlsIndex = TLS_OUT_OF_INDEXES; // ★ MacRunner 30.09: глубина областей HookGuard; слот заводится ТОЛЬКО при MACRUNNER_FEX_HOOK_GUARD=1
+// ★ Гейт читается ОДИН раз в SetupHooks (среда CRT к тому времени готова) и хранится простым bool. НЕЛЬЗЯ читать getenv лениво из хука: хук стреляет уже из
+//   rpmalloc_initialize (первая строка InitCRTProcess), а `Env` PE-CRT заполняет InitEnv (.CRT$FEXB) ПОЗЖЕ — getenv тогда разыменует нулевой указатель.
+bool HookGuardOn = false;
 
 uintptr_t JITWriteSlotGet() {
   if (JITWriteTlsIndex == TLS_OUT_OF_INDEXES) {
@@ -67,9 +76,59 @@ void SetupHooks(HMODULE ntdll) {
   SYSTEM_INFO system_info {};
   GetSystemInfo(&system_info);
   FEXCore::Allocator::SetupHooks(system_info.dwPageSize, Ptrs);
+  // Слот HookGuard — ПОСЛЕ слота JITWrite: его индекс не меняется ни при каком значении гейта.
+  {
+    const char* Value = getenv("MACRUNNER_FEX_HOOK_GUARD");
+    HookGuardOn = Value && Value[0] == '1' && !Value[1];
+    if (HookGuardOn && HookGuardTlsIndex == TLS_OUT_OF_INDEXES) {
+      HookGuardTlsIndex = TlsAlloc();
+    }
+  }
 }
 } // namespace FEX::Windows::Allocator
 
+namespace FEX::Windows::HookGuard {
+bool Enabled() {
+  return HookGuardOn;
+}
+
+uintptr_t Depth() {
+  if (HookGuardTlsIndex == TLS_OUT_OF_INDEXES) {
+    return 0;
+  }
+  return reinterpret_cast<uintptr_t>(TlsGetValue(HookGuardTlsIndex));
+}
+
+void Enter() {
+  if (HookGuardTlsIndex == TLS_OUT_OF_INDEXES) {
+    return;
+  }
+  const uintptr_t Value = Depth() + 1;
+  TlsSetValue(HookGuardTlsIndex, reinterpret_cast<LPVOID>(Value));
+  for (uint64_t Max = MacRunnerHookMaxDepth.load(std::memory_order_relaxed);
+       Value > Max && !MacRunnerHookMaxDepth.compare_exchange_weak(Max, Value, std::memory_order_relaxed);) {
+  }
+}
+
+void Leave() {
+  if (HookGuardTlsIndex == TLS_OUT_OF_INDEXES) {
+    return;
+  }
+  const uintptr_t Value = Depth();
+  if (Value) {
+    TlsSetValue(HookGuardTlsIndex, reinterpret_cast<LPVOID>(Value - 1));
+  }
+}
+
+bool Suppress(Kind K) {
+  if (!HookGuardOn || !Depth()) {
+    return false;
+  }
+  MacRunnerHookSuppressed[static_cast<unsigned>(K)].fetch_add(1, std::memory_order_relaxed);
+  return true;
+}
+} // namespace FEX::Windows::HookGuard
+
