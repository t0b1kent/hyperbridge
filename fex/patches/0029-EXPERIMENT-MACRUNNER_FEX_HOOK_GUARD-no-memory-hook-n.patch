+// ★ MacRunner (30.09.2026) — MACRUNNER_FEX_HOOK_GUARD=1 (по умолчанию ВЫКЛЮЧЕН, поведение прежнее).
+//   Дефект (доказан снимком спанов wxh-spans-r3-m1, 30.09): аллокатор FEX (rpmalloc) внутри инвалидации, под ЭКСКЛЮЗИВНЫМ CodeInvalidationMutex,
+//   возвращает ОС кусок памяти (VirtualFree -> NtFreeVirtualMemory). Обёртка NtFreeVirtualMemory в ARM64EC ntdll зовёт хук NotifyMemoryFree, если не выставлен
+//   InSyscallCallback (он защищает только от ВЛОЖЕННЫХ хуков, а вызов из кода эмулятора вне хука проходит) -> InvalidateAlignedInterval(Free=true) ->
+//   InvalidateIntervalInternal -> тот же эксклюзивный замок, который этот же поток уже держит; WritePriorityMutex не рекурсивен -> самоблокировка.
+//   Область Scope увеличивает счётчик глубины в слоте Win32 TLS (thread_local в PE-модулях FEX запрещён: каталог TLS пуст, см. Allocator.cpp) и на её время
+//   хуки Notify* ЭТОГО потока возвращаются сразу: не берут ThreadCreationMutex и не зовут трекер. Пропускается только то, что делает поток внутри области, а он
+//   там исполняет лишь код FEX; память гостя в области не освобождается и не защищается. Другие потоки оповещают как обычно.
+//   Счётчики пропусков по видам хука и наибольшая глубина — в строке macrunner-fex-jit (hs_free/hs_alloc/hs_protect/hs_map/hs_unmap/hs_depth_max).
+namespace FEX::Windows::HookGuard {
+enum class Kind : unsigned { Free, Alloc, Protect, Map, Unmap, Count };
+bool Enabled();              // MACRUNNER_FEX_HOOK_GUARD=1, читается один раз
+uintptr_t Depth();           // глубина областей ЭТОГО потока (0 при выключенном гейте)
+void Enter();
+void Leave();
+bool Suppress(Kind K);       // истина (и счёт по виду), если поток внутри области: оповещение пропустить целиком
+
+class Scope {
+public:
+  Scope() : Active {Enabled()} {
+    if (Active) {
+      Enter();
+    }
+  }
+  ~Scope() {
+    if (Active) {
+      Leave();
+    }
+  }
+  Scope(const Scope&) = delete;
+  Scope& operator=(const Scope&) = delete;
+
+private:
+  bool Active;
+};
+} // namespace FEX::Windows::HookGuard
