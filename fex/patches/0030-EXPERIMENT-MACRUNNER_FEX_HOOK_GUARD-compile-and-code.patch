index ca6e367bb..98eef4034 100644
--- a/Source/Windows/Common/Allocator.h
+++ b/Source/Windows/Common/Allocator.h
@@ -19,22 +19,25 @@ void SetupHooks(HMODULE ntdll);
 //   Счётчики пропусков по видам хука и наибольшая глубина — в строке macrunner-fex-jit (hs_free/hs_alloc/hs_protect/hs_map/hs_unmap/hs_depth_max).
 namespace FEX::Windows::HookGuard {
 enum class Kind : unsigned { Free, Alloc, Protect, Map, Unmap, Count };
-bool Enabled();              // MACRUNNER_FEX_HOOK_GUARD=1, читается один раз
-uintptr_t Depth();           // глубина областей ЭТОГО потока (0 при выключенном гейте)
-void Enter();
-void Leave();
-bool Suppress(Kind K);       // истина (и счёт по виду), если поток внутри области: оповещение пропустить целиком
+// HG2: путь, на котором поднята область (для счётчиков): инвалидация (трекер), компиляция и смена буфера кода (Core.cpp через SyscallHandler::EnterRuntimeSection).
+// Глубина по путям — три байта одного значения слота TLS: биты 0-7 инвалидация, 8-15 компиляция, 16-23 смена буфера кода.
+enum class Path : unsigned { Invalidation, Compile, ClearCodeCache, Count };
+bool Enabled();              // MACRUNNER_FEX_HOOK_GUARD=1, читается ОДИН раз в SetupHooks (не лениво: хук стреляет раньше, чем готова среда CRT)
+uintptr_t Depth();           // суммарная глубина областей ЭТОГО потока (0 при выключенном гейте)
+void Enter(Path P = Path::Invalidation);
+void Leave(Path P = Path::Invalidation);
+bool Suppress(Kind K);       // истина (и счёт по виду и по самому вложенному пути), если поток внутри области: оповещение пропустить целиком
 
 class Scope {
 public:
-  Scope() : Active {Enabled()} {
+  explicit Scope(Path P = Path::Invalidation) : Active {Enabled()}, ScopePath {P} {
     if (Active) {
-      Enter();
+      Enter(ScopePath);
     }
   }
   ~Scope() {
     if (Active) {
-      Leave();
+      Leave(ScopePath);
     }
   }
   Scope(const Scope&) = delete;
@@ -42,5 +45,6 @@ public:
 
 private:
   bool Active;
+  Path ScopePath;
 };
 } // namespace FEX::Windows::HookGuard
