diff --git a/Source/Windows/Common/Allocator.cpp b/Source/Windows/Common/Allocator.cpp
index 014d9974b..dfe812d10 100644
--- a/Source/Windows/Common/Allocator.cpp
+++ b/Source/Windows/Common/Allocator.cpp
@@ -29,7 +29,7 @@
 // Кодирование значения слота выбрано так, чтобы НОЛЬ (что видит новый поток по умолчанию)
 // означал «поток скобку ещё не проходил»: бит 0 — признак пройденного ThreadInit,
