-extern std::atomic<uint64_t> MacRunnerHookSuppressed[5], MacRunnerHookMaxDepth;                         // Core.cpp (HookGuard)
+extern std::atomic<uint64_t> MacRunnerHookSuppressed[7], MacRunnerHookMaxDepth;                         // Core.cpp (HookGuard)
 extern std::atomic<uint64_t> MacRunnerHookGuardScopes[3], MacRunnerHookSuppressedByPath[3];          // Core.cpp (HookGuard, HG2)
 
 namespace {
diff --git a/Source/Windows/Common/Allocator.h b/Source/Windows/Common/Allocator.h
index 98eef4034..c3710a4de 100644
--- a/Source/Windows/Common/Allocator.h
+++ b/Source/Windows/Common/Allocator.h
@@ -18,7 +18,7 @@ void SetupHooks(HMODULE ntdll);
 //   там исполняет лишь код FEX; память гостя в области не освобождается и не защищается. Другие потоки оповещают как обычно.
 //   Счётчики пропусков по видам хука и наибольшая глубина — в строке macrunner-fex-jit (hs_free/hs_alloc/hs_protect/hs_map/hs_unmap/hs_depth_max).
 namespace FEX::Windows::HookGuard {
-enum class Kind : unsigned { Free, Alloc, Protect, Map, Unmap, Count };
+enum class Kind : unsigned { Free, Alloc, Protect, Map, Unmap, Flush, Dirty, Count }; // HG3: Flush (NtFlushInstructionCache) и Dirty (NotifyMemoryDirty) — тоже двери в трекер
 // HG2: путь, на котором поднята область (для счётчиков): инвалидация (трекер), компиляция и смена буфера кода (Core.cpp через SyscallHandler::EnterRuntimeSection).
 // Глубина по путям — три байта одного значения слота TLS: биты 0-7 инвалидация, 8-15 компиляция, 16-23 смена буфера кода.
 enum class Path : unsigned { Invalidation, Compile, ClearCodeCache, Count };
diff --git a/Source/Windows/WOW64/Module.cpp b/Source/Windows/WOW64/Module.cpp
index 5302a7c0f..f6758c6b8 100644
--- a/Source/Windows/WOW64/Module.cpp
+++ b/Source/Windows/WOW64/Module.cpp
@@ -1039,16 +1039,25 @@ NTSTATUS BTCpuResetToConsistentState(EXCEPTION_POINTERS* Ptrs) {
 }
 
 void BTCpuFlushInstructionCache2(const void* Address, SIZE_T Size) {
+  if (FEX::Windows::HookGuard::Suppress(FEX::Windows::HookGuard::Kind::Flush)) { // MACRUNNER_FEX_HOOK_GUARD (HG3)
+    return;
+  }
   std::scoped_lock Lock(ThreadCreationMutex);
   InvalidationTracker->InvalidateAlignedInterval(reinterpret_cast<uint64_t>(Address), static_cast<uint64_t>(Size), false);
 }
 
 void BTCpuFlushInstructionCacheHeavy(const void* Address, SIZE_T Size) {
+  if (FEX::Windows::HookGuard::Suppress(FEX::Windows::HookGuard::Kind::Flush)) { // MACRUNNER_FEX_HOOK_GUARD (HG3)
+    return;
+  }
   std::scoped_lock Lock(ThreadCreationMutex);
   InvalidationTracker->InvalidateAlignedInterval(reinterpret_cast<uint64_t>(Address), static_cast<uint64_t>(Size), false);
 }
 
 void BTCpuNotifyMemoryDirty(void* Address, SIZE_T Size) {
+  if (FEX::Windows::HookGuard::Suppress(FEX::Windows::HookGuard::Kind::Dirty)) { // MACRUNNER_FEX_HOOK_GUARD (HG3)
+    return;
+  }
   std::scoped_lock Lock(ThreadCreationMutex);
   InvalidationTracker->InvalidateAlignedInterval(reinterpret_cast<uint64_t>(Address), static_cast<uint64_t>(Size), false);
 }
