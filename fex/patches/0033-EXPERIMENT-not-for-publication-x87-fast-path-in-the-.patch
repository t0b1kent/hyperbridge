+namespace FEXCore::HBX87 {
+// Per operation: hit53, hit24, input/FCW reject, FPCR reject, range reject.
+// Indices 25..28: cvt32 hit/fallback, cvt64 hit/fallback.
+alignas(64) inline uint64_t Counters[29]{};
+static_assert(std::atomic_ref<uint64_t>::is_always_lock_free);
+inline bool Proof(){static const bool v=Gate("MACRUNNER_HB_X87_FAST_PROOF");return v;}
+inline void Dump(){
+ char s[2048],*p=s;
+ auto text=[&](const char*q){while(*q)*p++=*q++;};
+ auto num=[&](uint64_t n){char t[20];unsigned z=0;do{t[z++]=char('0'+n%10);n/=10;}while(n);while(z)*p++=t[--z];};
+ text("[hb-x87-fast]");
+ for(unsigned i=0;i<29;++i){text(" c");num(i);text("=");num(std::atomic_ref<uint64_t>(Counters[i]).load(std::memory_order_relaxed));}
+ *p++='\n';*p=0;
+#if defined(_WIN32) && defined(FEX_WINE_DARWIN)
+ FEX::Windows::Logging::Raw(s);
+#else
+ LogMan::Msg::DFmt("{}",s);
+#endif
+}
+// Called only on powers of two via the EXISTING F80 binary ABI wrapper.
+// Keep the same preservation attribute as its normal OpHandlers target.
+FEXCORE_PRESERVE_ALL_ATTR inline VectorRegType Report(uint16_t, VectorRegType a, VectorRegType,
+                                                     FEXCore::Core::CpuStateFrame*) { Dump();return a; }
+}
