@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: MIT
+// Portions derived from FEX-Emu, Copyright (c) 2019 Ryan Houdek and FEX contributors, MIT License
+// Modifications (c) 2026 MacRunner contributors, MIT
+#pragma once
+#include "Interface/IR/IREmitter.h"
+#include "Interface/Core/HBX87Guard.h"
+#include <FEXCore/Core/CoreState.h>
+#include <cstdlib>
+namespace FEXCore::HBX87 {
+inline bool Gate(const char* name) { const char* p=std::getenv(name);return p&&p[0]=='1'&&!p[1]; }
+inline bool Enabled() {
+#ifdef VIXL_SIMULATOR
+ return false;
+#else
+ static const bool v=Gate("MACRUNNER_HB_X87_FAST");return v;
+#endif
+}
+inline bool PC24() { static const bool v=Gate("MACRUNNER_HB_X87_FAST_PC24");return v; }
+inline bool Supports(IR::IROps op) {
+  return op==IR::OP_F80ADD||op==IR::OP_F80SUB||op==IR::OP_F80MUL||op==IR::OP_F80DIV||op==IR::OP_F80SQRT;
+}
+template<class Builder> struct GuardIR {
+  Builder& B; using V=IR::Ref; static constexpr auto S=IR::OpSize::i64Bit;
+  V C(uint64_t x){return B._Constant(static_cast<int64_t>(x));}
+  V And(V a,V d){return B._And(S,a,d);} V Or(V a,V d){return B._Or(S,a,d);}
+  V Xor(V a,V d){return B._Xor(S,a,d);} V Sub(V a,V d){return B._Sub(S,a,d);}
+  V Shl(V a,V n){return B._Lshl(S,a,n);} V Shr(V a,V n){return B._Lshr(S,a,n);}
+  V Clz(V a){return B._CountLeadingZeroes(S,a);}
+};
+template<class Builder>
+IR::Ref Emit(Builder& B,IR::IROps op,IR::Ref a,IR::Ref d) {
+  const Kind k=op==IR::OP_F80ADD?Add:op==IR::OP_F80SUB?Sub:op==IR::OP_F80MUL?Mul:op==IR::OP_F80DIV?Div:Sqrt;
+  const auto Q=IR::OpSize::i128Bit, D=IR::OpSize::i64Bit;
+  GuardIR<Builder> g{B};
+  IR::Ref cw=B._LoadContextGPR(IR::OpSize::i16Bit,offsetof(FEXCore::Core::CPUState,FCW));
+  IR::Ref as=B._VExtractToGPR(Q,D,a,0),ae=B._VExtractToGPR(Q,D,a,1);
+  IR::Ref ds=k==Sqrt?as:B._VExtractToGPR(Q,D,d,0);
+  IR::Ref de=k==Sqrt?ae:B._VExtractToGPR(Q,D,d,1);
+  auto cls=Guard(g,cw,as,ae,ds,de,k,PC24());
+  return B._HBX87Fast(a,d,cls,uint8_t(k));
+}
