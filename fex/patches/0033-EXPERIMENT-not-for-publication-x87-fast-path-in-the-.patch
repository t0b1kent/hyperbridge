diff --git a/FEXCore/Source/Interface/Core/HBX87Emit.inl b/FEXCore/Source/Interface/Core/HBX87Emit.inl
new file mode 100644
index 000000000..7334f0b82
--- /dev/null
+++ b/FEXCore/Source/Interface/Core/HBX87Emit.inl
@@ -0,0 +1,205 @@
+// SPDX-License-Identifier: MIT
+// Portions derived from FEX-Emu, Copyright (c) 2019 Ryan Houdek and FEX contributors, MIT License
+// Modifications (c) 2026 MacRunner contributors, MIT
+// Included at the BEGINNING of Arm64JITCore::Op_Unhandled.
+// Full FEX integration NOT BUILT. Uses only TMP1..TMP4, VTMP1..VTMP2.
+using namespace ARMEmitter;
+auto HBCount = [&](unsigned id, ARMEmitter::VRegister Value) {
+  if (!FEXCore::HBX87::Proof()) return;
+  LOGMAN_THROW_A_FMT(CTX->HostFeatures.SupportsAtomics, "HB x87 proof requires LSE");
+  ForwardLabel Skip;
+  LoadConstant(Size::i64Bit,TMP1,reinterpret_cast<uintptr_t>(&FEXCore::HBX87::Counters[id]));
+  LoadConstant(Size::i64Bit,TMP2,1);
+  ldaddal(SubRegSize::i64Bit,TMP2,TMP2,TMP1); // old count in TMP2
+  add(Size::i64Bit,TMP3,TMP2,1);
+  and_(Size::i64Bit,TMP3,TMP3,TMP2); // n & (n-1), preserves NZCV
+  (void)cbnz(Size::i64Bit,TMP3,&Skip);
+  IR::IROp_F80Add Dummy{}; Dummy.Header.Op=IR::OP_F80ADD;Dummy.Header.Size=IR::OpSize::i128Bit;
+  FallbackInfo ProofInfo{};
+  LOGMAN_THROW_A_FMT(InterpreterOps::GetFallbackHandler(&Dummy.Header,&ProofInfo),"No F80 ABI for proof");
+  LOGMAN_THROW_A_FMT(ProofInfo.ABI==FABI_F80_I16_F80_F80_PTR,"Unexpected F80 proof ABI");
+  // Preserve FPSR across the diagnostic wrapper as well as across speculative FP.
+  mrs(TMP1,SystemRegister::FPSR);
+  stp<IndexType::PRE>(XReg::lr,TMP1,Reg::rsp,-16);
+  mov(VTMP1.Q(),Value.Q());
+  mov(VTMP2.Q(),VTMP1.Q());
+  ldr(TMP1,FALLBACK_HANDLER_OFFSET(ProofInfo.HandlerIndex,ABIHandler));
+  LoadConstant(Size::i64Bit,TMP4,reinterpret_cast<uintptr_t>(&FEXCore::HBX87::Report));
+  blr(TMP1);
+  ldp<IndexType::POST>(XReg::lr,TMP1,Reg::rsp,16);
+  msr(SystemRegister::FPSR,TMP1);
+  mov(Value.Q(),VTMP1.Q());
+  (void)Bind(&Skip);
+};
+// Exact binary32/64 -> F80 for normal or signed-zero inputs. Specials/subnormals
+// retain the original converter. No additional guest memory read.
+if (FEXCore::HBX87::Enabled() && IROp->Op==IR::OP_F80CVTTO) {
+  const auto Cvt=IROp->C<IR::IROp_F80CVTTo>();
+  if(Cvt->SrcSize==IR::OpSize::i32Bit || Cvt->SrcSize==IR::OpSize::i64Bit) {
+    const bool D=Cvt->SrcSize==IR::OpSize::i64Bit;
+    const unsigned f=D?52:23,shift=D?11:40,bias=D?1023:127,expmax=D?2047:255;
+    const uint64_t frac=(UINT64_C(1)<<f)-1;
+    ForwardLabel Slow,Zero,Pack,Done;
+    umov<SubRegSize::i64Bit>(TMP2,GetVReg(Cvt->X80Src),0);
+    if(!D)uxtw(TMP2,TMP2);
+    and_(Size::i64Bit,TMP3,TMP2,D?UINT64_C(0x7fffffffffffffff):UINT64_C(0x7fffffff));
+    (void)cbz(Size::i64Bit,TMP3,&Zero);
+    lsr(Size::i64Bit,TMP3,TMP3,f);
+    (void)cbz(Size::i64Bit,TMP3,&Slow);
+    sub(Size::i64Bit,TMP4,TMP3,expmax);
+    (void)cbz(Size::i64Bit,TMP4,&Slow);
+    LoadConstant(Size::i64Bit,TMP4,16383-bias);
+    add(Size::i64Bit,TMP3,TMP3,TMP4);
+    lsr(Size::i64Bit,TMP4,TMP2,D?48:16);
+    and_(Size::i64Bit,TMP4,TMP4,0x8000);
+    orr(Size::i64Bit,TMP3,TMP3,TMP4);
+    and_(Size::i64Bit,TMP2,TMP2,frac);
+    orr(Size::i64Bit,TMP2,TMP2,UINT64_C(1)<<f);
+    lsl(Size::i64Bit,TMP2,TMP2,shift);
+    (void)b(&Pack);
+    (void)Bind(&Zero);
+    lsr(Size::i64Bit,TMP3,TMP2,D?48:16);
+    and_(Size::i64Bit,TMP3,TMP3,0x8000);
+    LoadConstant(Size::i64Bit,TMP2,0);
+    (void)Bind(&Pack);
+    fmov(Size::i64Bit,VTMP1.D(),TMP2);
+    fmov(Size::i64Bit,VTMP1.D(),TMP3,true);
+    mov(GetVReg(Node).Q(),VTMP1.Q());
+    HBCount(D?27:25,GetVReg(Node));
+    (void)b(&Done);
+    (void)Bind(&Slow);
+    HBCount(D?28:26,GetVReg(Cvt->X80Src));
+    // Same call protocol as the original F32/F64 -> F80 case; no recursive
+    // re-entry through this enrichment and no second guest-memory load.
+    FallbackInfo OriginalInfo{};
+    LOGMAN_THROW_A_FMT(InterpreterOps::GetFallbackHandler(IROp,&OriginalInfo),"Missing F80 conversion");
+    str<IndexType::PRE>(XReg::lr,Reg::rsp,-16);
+    if(D)fmov(VTMP1.D(),GetVReg(Cvt->X80Src).D());
+    else fmov(VTMP1.S(),GetVReg(Cvt->X80Src).S());
+    ldr(TMP1,FALLBACK_HANDLER_OFFSET(OriginalInfo.HandlerIndex,ABIHandler));
+    ldr(TMP4,FALLBACK_HANDLER_OFFSET(OriginalInfo.HandlerIndex,Func));
+    blr(TMP1);
+    ldr<IndexType::POST>(XReg::lr,Reg::rsp,16);
+    mov(GetVReg(Node).Q(),VTMP1.Q());
+    (void)Bind(&Done);
+    return;
+  }
+}
+if(IROp->Op==IR::OP_HBX87FAST) {
+ const auto Op=IROp->C<IR::IROp_HBX87Fast>();
+ const auto A=GetVReg(Op->X80Src1),D=GetVReg(Op->X80Src2),Dst=GetVReg(Node);
+ const auto Class=GetReg(Op->Class);
+ const auto kind=static_cast<FEXCore::HBX87::Kind>(Op->Kind);
+ LOGMAN_THROW_A_FMT(kind<=FEXCore::HBX87::Sqrt,"Invalid HB x87 opcode");
+ ForwardLabel PreSlow,FPCRSlow,RangeSlow,Path24,Done;
+ and_(Size::i64Bit,TMP1,Class,3);
+ (void)cbz(Size::i64Bit,TMP1,&PreSlow);
+ mrs(TMP1,SystemRegister::FPCR);
+ LoadConstant(Size::i64Bit,TMP2,UINT64_C(0x00c09f03));
+ and_(Size::i64Bit,TMP1,TMP1,TMP2);
+ (void)cbnz(Size::i64Bit,TMP1,&FPCRSlow);
+ (void)tbnz(Class,1,&Path24);
+ auto EmitPrecision=[&](bool isDouble) {
+   unsigned f=isDouble?52:23,shift=isDouble?11:40,bias=isDouble?1023:127;
+   unsigned maxNormalExp=isDouble?2046:254;
+   uint64_t absMask=isDouble?UINT64_C(0x7fffffffffffffff):UINT64_C(0x7fffffff);
+   auto PackInput=[&](auto Src,auto VDst) {
+     ForwardLabel Zero,Finish;
+     umov<SubRegSize::i64Bit>(TMP3,Src,1);
+     and_(Size::i64Bit,TMP4,TMP3,0x8000);
+     lsl(Size::i64Bit,TMP4,TMP4,isDouble?48:16);
+     and_(Size::i64Bit,TMP3,TMP3,0x7fff);
+     (void)cbz(Size::i64Bit,TMP3,&Zero);
+     LoadConstant(Size::i64Bit,TMP2,16383-bias);
+     sub(Size::i64Bit,TMP3,TMP3,TMP2);
+     lsl(Size::i64Bit,TMP3,TMP3,f);
+     orr(Size::i64Bit,TMP4,TMP4,TMP3);
+     umov<SubRegSize::i64Bit>(TMP2,Src,0);
+     lsr(Size::i64Bit,TMP2,TMP2,shift);
+     and_(Size::i64Bit,TMP2,TMP2,(UINT64_C(1)<<f)-1);
+     orr(Size::i64Bit,TMP4,TMP4,TMP2);
+     (void)b(&Finish);
+     (void)Bind(&Zero);
+     (void)Bind(&Finish);
+     if(isDouble)fmov(Size::i64Bit,VDst.D(),TMP4);
+     else fmov(Size::i32Bit,VDst.S(),TMP4);
+   };
+   PackInput(A,VTMP1);
+   if(kind!=FEXCore::HBX87::Sqrt)PackInput(D,VTMP2);
+   mrs(TMP1,SystemRegister::FPSR);
+   if(isDouble) {
+     switch(kind){
+      case FEXCore::HBX87::Add:fadd(VTMP1.D(),VTMP1.D(),VTMP2.D());break;
+      case FEXCore::HBX87::Sub:fsub(VTMP1.D(),VTMP1.D(),VTMP2.D());break;
+      case FEXCore::HBX87::Mul:fmul(VTMP1.D(),VTMP1.D(),VTMP2.D());break;
+      case FEXCore::HBX87::Div:fdiv(VTMP1.D(),VTMP1.D(),VTMP2.D());break;
+      case FEXCore::HBX87::Sqrt:fsqrt(VTMP1.D(),VTMP1.D());break;
+     }
+   } else {
+     switch(kind){
+      case FEXCore::HBX87::Add:fadd(VTMP1.S(),VTMP1.S(),VTMP2.S());break;
+      case FEXCore::HBX87::Sub:fsub(VTMP1.S(),VTMP1.S(),VTMP2.S());break;
+      case FEXCore::HBX87::Mul:fmul(VTMP1.S(),VTMP1.S(),VTMP2.S());break;
+      case FEXCore::HBX87::Div:fdiv(VTMP1.S(),VTMP1.S(),VTMP2.S());break;
+      case FEXCore::HBX87::Sqrt:fsqrt(VTMP1.S(),VTMP1.S());break;
+     }
+   }
+   msr(SystemRegister::FPSR,TMP1); // restored before EVERY post-operation branch
+   umov<SubRegSize::i64Bit>(TMP2,VTMP1,0);
+   if(!isDouble)uxtw(TMP2,TMP2);
+   ForwardLabel ZeroResult,PackResult;
+   and_(Size::i64Bit,TMP3,TMP2,absMask);
+   (void)cbz(Size::i64Bit,TMP3,&ZeroResult);
+   lsr(Size::i64Bit,TMP3,TMP3,f);
+   sub(Size::i64Bit,TMP3,TMP3,2);
+   (void)tbnz(TMP3,63,&RangeSlow);
+   sub(Size::i64Bit,TMP4,TMP3,maxNormalExp-2);
+   (void)tbz(TMP4,63,&RangeSlow);
+   // Recover F80 exponent + sign. No FPR/GPR source is overwritten before acceptance.
+   add(Size::i64Bit,TMP3,TMP3,2);
+   LoadConstant(Size::i64Bit,TMP4,16383-bias);
+   add(Size::i64Bit,TMP3,TMP3,TMP4);
+   lsr(Size::i64Bit,TMP4,TMP2,isDouble?48:16);
+   and_(Size::i64Bit,TMP4,TMP4,0x8000);
+   orr(Size::i64Bit,TMP3,TMP3,TMP4);
+   and_(Size::i64Bit,TMP2,TMP2,(UINT64_C(1)<<f)-1);
+   orr(Size::i64Bit,TMP2,TMP2,UINT64_C(1)<<f);
+   lsl(Size::i64Bit,TMP2,TMP2,shift);
+   (void)b(&PackResult);
+   (void)Bind(&ZeroResult);
+   (void)tbz(Class,2,&RangeSlow); // zero from underflow is NEVER automatically accepted
+   lsr(Size::i64Bit,TMP3,TMP2,isDouble?48:16);
+   and_(Size::i64Bit,TMP3,TMP3,0x8000);
+   LoadConstant(Size::i64Bit,TMP2,0);
+   (void)Bind(&PackResult);
+   fmov(Size::i64Bit,VTMP1.D(),TMP2);
+   fmov(Size::i64Bit,VTMP1.D(),TMP3,true);
+   mov(Dst.Q(),VTMP1.Q());
+   HBCount(unsigned(kind)*5+(isDouble?0:1),Dst);
+   (void)b(&Done);
+ };
+ EmitPrecision(true);
+ (void)Bind(&Path24);
+ EmitPrecision(false);
+ auto EmitOriginal=[&](unsigned reason) {
+   HBCount(unsigned(kind)*5+reason,A);
+   if(kind==FEXCore::HBX87::Sqrt) {
+     IR::IROp_F80SQRT Original{};
+     Original.Header=*IROp;Original.Header.Op=IR::OP_F80SQRT;
+     Original.X80Src=Op->X80Src1;
+     Op_Unhandled(&Original.Header,Node);
+   } else {
+     IR::IROp_F80Add Original{};
+     Original.Header=*IROp;
+     Original.Header.Op=kind==FEXCore::HBX87::Add?IR::OP_F80ADD:kind==FEXCore::HBX87::Sub?IR::OP_F80SUB:kind==FEXCore::HBX87::Mul?IR::OP_F80MUL:IR::OP_F80DIV;
+     Original.X80Src1=Op->X80Src1;Original.X80Src2=Op->X80Src2;
+     Op_Unhandled(&Original.Header,Node);
+   }
+   (void)b(&Done);
+ };
+ (void)Bind(&PreSlow); EmitOriginal(2);
+ (void)Bind(&FPCRSlow); EmitOriginal(3);
+ (void)Bind(&RangeSlow); EmitOriginal(4);
+ (void)Bind(&Done);
+ return;
+}
diff --git a/FEXCore/Source/Interface/Core/HBX87Guard.h b/FEXCore/Source/Interface/Core/HBX87Guard.h
new file mode 100644
index 000000000..bc4030ad3
--- /dev/null
+++ b/FEXCore/Source/Interface/Core/HBX87Guard.h
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: MIT
+// Modifications (c) 2026 MacRunner contributors, MIT
+#pragma once
+#include <cstdint>
+namespace FEXCore::HBX87 {
+enum Kind : uint8_t { Add, Sub, Mul, Div, Sqrt };
+// E exposes only integer operations, no flags and no speculative floating-point.
+// All values are uint64 quantities or i64 FEX SSA references. Result bits:
+// 0..1 = 0 reject, 1 binary64, 2 binary32; bit 2 = exact zero is possible.
+template<class E, class V>
+V Guard(E& b, V cw, V as, V ae, V ds, V de, Kind op, bool pc24) {
+  auto c=[&](uint64_t x){return b.C(x);};
+  auto eq0=[&](V x){return b.Shr(b.Clz(x),c(6));};
+  auto eq=[&](V x,V y){return eq0(b.Xor(x,y));};
+  auto nz=[&](V x){return b.Xor(eq0(x),c(1));};
+  ae=b.And(ae,c(0xffff)); de=b.And(de,c(0xffff));
+  V ax=b.And(ae,c(0x7fff)), dx=b.And(de,c(0x7fff));
+  V az=eq0(b.Or(as,ax)), dz=eq0(b.Or(ds,dx));
+  auto operand=[&](V sig,V exp,V zero,unsigned p,int lo,int hi) {
+    V lower=b.Xor(b.Shr(b.Sub(exp,c(16383+lo)),c(63)),c(1));
+    V upper=b.Xor(b.Shr(b.Sub(c(16383+hi),exp),c(63)),c(1));
+    V exact=eq0(b.And(sig,c((UINT64_C(1)<<(64-p))-1)));
+    V normal=b.And(b.Shr(sig,c(63)),b.And(exact,b.And(lower,upper)));
+    return b.Or(zero,normal);
+  };
+  V env=b.And(cw,c(0x0f3f)); // PC, RC, six exception masks. IC ignored.
+  V a53=operand(as,ax,az,53,-1022,1023);
+  V d53=op==Sqrt ? c(1):operand(ds,dx,dz,53,-1022,1023);
+  V ok53=b.And(eq(env,c(0x023f)),b.And(a53,d53));
+  V ok24=c(0);
+  if(pc24) {
+    V a24=operand(as,ax,az,24,-126,127);
+    V d24=op==Sqrt?c(1):operand(ds,dx,dz,24,-126,127);
+    ok24=b.And(eq(env,c(0x003f)),b.And(a24,d24));
+  }
+  V domain=c(1), zero=c(0);
+  switch(op) {
+  case Add: case Sub: {
+    V same=b.And(eq(as,ds),eq(ax,dx));
+    V signs=b.Shr(b.Xor(ae,de),c(15));
+    V cancel=b.And(same,op==Add?signs:b.Xor(signs,c(1)));
+    zero=b.Or(b.And(az,dz),cancel); break;
+  }
+  case Mul: zero=b.Or(az,dz); break;
+  case Div: domain=b.Xor(dz,c(1)); zero=az; break;
+  case Sqrt:
+    domain=b.Xor(b.And(b.Shr(ae,c(15)),nz(b.Or(as,ax))),c(1));
+    zero=az; break;
+  }
+  V cls=b.And(b.Or(ok53,b.Shl(ok24,c(1))),b.Sub(c(0),domain));
+  return b.Or(cls,b.Shl(b.And(zero,nz(cls)),c(2)));
+}
+struct Numeric {
+  using V=uint64_t;
+  V C(V x){return x;} V And(V a,V b){return a&b;} V Or(V a,V b){return a|b;}
+  V Xor(V a,V b){return a^b;} V Sub(V a,V b){return a-b;}
+  V Shl(V a,V n){return a<<(n&63);} V Shr(V a,V n){return a>>(n&63);}
+  V Clz(V a){return a?__builtin_clzll(a):64;}
+};
+struct F80 { uint64_t sig=0; uint16_t se=0; uint16_t pad[3]={}; };
+static_assert(sizeof(F80)==16);
+inline uint64_t Pack(const F80& x,unsigned p) {
+  const unsigned f=p-1, bias=p==53?1023:127;
+  const uint64_t sign=uint64_t(x.se>>15)<<(p==53?63:31);
+  if(!(x.se&0x7fff)) return sign; // only called after canonical input guard
+  return sign | (uint64_t((x.se&0x7fff)-16383+bias)<<f)
+       | ((x.sig>>(64-p))&((UINT64_C(1)<<f)-1));
+}
+inline F80 Unpack(uint64_t bits,unsigned p) {
+  const unsigned f=p-1, bias=p==53?1023:127, eb=p==53?11:8;
+  const uint64_t frac=bits&((UINT64_C(1)<<f)-1);
+  const unsigned ex=(bits>>f)&((1u<<eb)-1);
+  F80 r; r.se=uint16_t(((bits>>(p==53?63:31))&1)<<15);
+  if(ex) { r.se|=ex+16383-bias; r.sig=(UINT64_C(1)<<63)|(frac<<(64-p)); }
+  return r;
+}
+inline bool ResultOK(uint64_t bits,unsigned p,bool exact_zero) {
+  const unsigned f=p-1,eb=p==53?11:8;
+  const uint64_t abs=bits&((UINT64_C(1)<<(p==53?63:31))-1);
+  const unsigned ex=(abs>>f)&((1u<<eb)-1);
+  return (exact_zero && !abs) || (ex>=2 && ex<((1u<<eb)-2));
+}
+inline bool FPCR_OK(uint64_t fpcr) { return !(fpcr&UINT64_C(0x00c09f03)); }
+}
diff --git a/FEXCore/Source/Interface/Core/HBX87IR.h b/FEXCore/Source/Interface/Core/HBX87IR.h
