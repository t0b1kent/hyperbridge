@@ -31,6 +31,7 @@ auto HBCount = [&](unsigned id, ARMEmitter::VRegister Value) {
   mov(Value.Q(),VTMP1.Q());
   (void)Bind(&Skip);
 };
+#include "Interface/Core/HBX87FPSR.inl"
 // Exact binary32/64 -> F80 for normal or signed-zero inputs. Specials/subnormals
 // retain the original converter. No additional guest memory read.
 if (FEXCore::HBX87::Enabled() && IROp->Op==IR::OP_F80CVTTO) {
@@ -85,6 +86,7 @@ if (FEXCore::HBX87::Enabled() && IROp->Op==IR::OP_F80CVTTO) {
     return;
   }
 }
+#include "Interface/Core/HBX87EarlyEmit.inl"
 if(IROp->Op==IR::OP_HBX87FAST) {
  const auto Op=IROp->C<IR::IROp_HBX87Fast>();
  const auto A=GetVReg(Op->X80Src1),D=GetVReg(Op->X80Src2),Dst=GetVReg(Node);
@@ -144,7 +146,7 @@ if(IROp->Op==IR::OP_HBX87FAST) {
       case FEXCore::HBX87::Sqrt:fsqrt(VTMP1.S(),VTMP1.S());break;
      }
    }
-   msr(SystemRegister::FPSR,TMP1); // restored before EVERY post-operation branch
+   HBRestoreFPSR(); // original FPSR restored if changed
    umov<SubRegSize::i64Bit>(TMP2,VTMP1,0);
    if(!isDouble)uxtw(Size::i64Bit,TMP2,TMP2);
    ForwardLabel ZeroResult,PackResult;
diff --git a/FEXCore/Source/Interface/Core/HBX87FPSR.inl b/FEXCore/Source/Interface/Core/HBX87FPSR.inl
new file mode 100644
index 000000000..d2a897d7e
--- /dev/null
+++ b/FEXCore/Source/Interface/Core/HBX87FPSR.inl
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: MIT
+// Modifications (c) 2026 MacRunner contributors, MIT
+// TMP1 contains the saved FPSR. Called immediately after speculative FP.
+auto HBRestoreFPSR = [&]() {
+  static const bool conditional=FEXCore::HBX87::Gate("MACRUNNER_HB_X87_CONDITIONAL_FPSR");
+  if(conditional) {
+    ARMEmitter::ForwardLabel Unchanged;
+    mrs(TMP3,ARMEmitter::SystemRegister::FPSR);
+    eor(ARMEmitter::Size::i64Bit,TMP3,TMP3,TMP1);
+    (void)cbz(ARMEmitter::Size::i64Bit,TMP3,&Unchanged);
+    msr(ARMEmitter::SystemRegister::FPSR,TMP1);
+    (void)Bind(&Unchanged);
+  } else {
+    msr(ARMEmitter::SystemRegister::FPSR,TMP1);
+  }
+};
