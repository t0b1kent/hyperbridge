 FEXCore/Source/Interface/Core/HBX87Emit.inl   |   4 +-
 FEXCore/Source/Interface/Core/HBX87FPSR.inl   |  16 ++
 FEXCore/Source/Interface/Core/HBX87IR.h       |   2 +
 FEXCore/Source/Interface/IR/IR.json           |   5 +
 5 files changed, 221 insertions(+), 1 deletion(-)
