@@ -0,0 +1,15 @@
+# Run from an empty lane-owned build directory: nice -n 20 make -f <this> -j2
+FEX_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
+SF := $(FEX_ROOT)/External/SoftFloat-3e
+SF_SOURCES := $(shell python3 $(FEX_ROOT)/unittests/x87_guarded_sources.py $(SF)/CMakeLists.txt)
+OBJECTS := $(patsubst src/%.c,sf-%.o,$(SF_SOURCES))
+DEFS := -DFEXCORE_PRESERVE_ALL_ATTR= -DFEXCORE_HAS_PRESERVE_ALL_ATTR=0 -DSOFTFLOAT_BUILTIN_CLZ=1 -DINLINE='static inline' -DINLINE_LEVEL=4 -DSOFTFLOAT_FAST_INT64=1 -DSOFTFLOAT_FAST_DIV32TO16=1 -DSOFTFLOAT_FAST_DIV64TO32=1
+INCLUDES := -I$(SF)/include -I$(SF)/include/SoftFloat-3e
+.PHONY: all
+all: x87_guarded_native
+sf-%.o: $(SF)/src/%.c
+	xcrun clang -O2 $(DEFS) $(INCLUDES) -c $< -o $@
+libsoftfloat_x87.a: $(OBJECTS)
+	xcrun ar rcs $@ $(OBJECTS)
+x87_guarded_native: $(FEX_ROOT)/unittests/x87_guarded_native.cpp libsoftfloat_x87.a
+	xcrun clang++ -std=c++20 -O2 -ffp-contract=off -fno-fast-math $(DEFS) $(INCLUDES) -I$(FEX_ROOT)/FEXCore/Source $< libsoftfloat_x87.a -o $@
