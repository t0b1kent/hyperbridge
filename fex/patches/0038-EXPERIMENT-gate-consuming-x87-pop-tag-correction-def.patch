 .../Source/Interface/Core/HBX87StateGates.h   | 23 +++++++++++++++++++
 .../IR/Passes/x87StackOptimizationPass.cpp    |  6 +++++
 2 files changed, 29 insertions(+)
 create mode 100644 FEXCore/Source/Interface/Core/HBX87StateGates.h

