@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: MIT
+// Modifications (c) 2026 MacRunner contributors, MIT
+#pragma once
+#include <cstdlib>
+
+namespace FEXCore::HBX87::StateFix {
+inline bool ReadGate(const char* Name) {
+  const char* Value = std::getenv(Name);
+  return Value && Value[0] == '1' && Value[1] == '\0';
+}
+inline bool PopTag() {
+  static const bool Enabled = ReadGate("MACRUNNER_HB_X87_FIX_POP_TAG");
+  return Enabled;
+}
+inline bool StickyIE() {
+  static const bool Enabled = ReadGate("MACRUNNER_HB_X87_FIX_STICKY_IE");
+  return Enabled;
+}
+inline bool EnvTags() {
+  static const bool Enabled = ReadGate("MACRUNNER_HB_X87_FIX_ENV_TAGS");
+  return Enabled;
+}
+}
