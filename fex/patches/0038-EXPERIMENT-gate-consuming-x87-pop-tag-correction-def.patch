 #include "Interface/IR/IR.h"
@@ -612,6 +613,11 @@ inline void X87StackOptimization::StoreStackValue(Ref Value, uint8_t Offset, boo
 
 inline void X87StackOptimization::StackPop() {
   if (SlowPath) {
+    // Every consuming pop destroys the old ST0. FINCSTP uses
+    // UpdateTopForPop_Slow directly and must preserve the physical tag.
+    if (FEXCore::HBX87::StateFix::PopTag()) {
+      SetX87ValidTag(0, false);
+    }
     UpdateTopForPop_Slow();
   } else {
     StackData.pop();
