diff --git a/FEXCore/Source/Interface/Core/HBX87Coverage.h b/FEXCore/Source/Interface/Core/HBX87Coverage.h
new file mode 100644
index 000000000..0c1974779
--- /dev/null
+++ b/FEXCore/Source/Interface/Core/HBX87Coverage.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: MIT
+// Diagnostic only: native shared counters, never enabled in timing runs.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include "HBX87Stats.h"
+
+namespace FEXCore::HBX87::Coverage {
+constexpr uint64_t Magic = UINT64_C(0x31564f4337385848); // HX87COV1, little endian
+constexpr unsigned Opcodes = 2048, Classes = 8, Outcomes = 12;
+// FCW classes, in priority order: PC64, RC, unmasked, reserved PC,
+// disabled PC24; otherwise PC53 or PC24. Class 7 is reserved.
+enum FCWClass : unsigned { PC53, PC24, PC64, RC, Unmasked, ReservedPC, DisabledPC24, Reserved };
+enum Outcome : unsigned {
+ Hit53, Hit24, RejectPC64, RejectRC, RejectUnmasked, RejectReservedPC,
+ RejectDisabledPC24, RejectInputDomain, RejectFPCR, RejectRange, CvtHit, CvtReject
+};
+struct alignas(64) Storage {
+ uint64_t magic, version, pid, bytes;
+ uint64_t backend; // 0 native/synthetic, 1 WOW64, 2 ARM64EC
+ uint64_t reserved[3];
+ alignas(64) uint64_t instructions[Opcodes][Classes];
+ alignas(64) uint64_t outcomes[Outcomes];
+ alignas(64) uint64_t stats[Stats::Count];
+};
+static_assert(offsetof(Storage, instructions) == 64);
+inline Storage* Shared {};
+inline bool Enabled() {
+ static const bool enabled = [] {
+  const char* p = std::getenv("MACRUNNER_HB_X87_COVERAGE");
+  return p && p[0] == '1' && p[1] == 0;
+ }();
+ return enabled;
+}
+}
diff --git a/FEXCore/Source/Interface/Core/HBX87CoverageIR.h b/FEXCore/Source/Interface/Core/HBX87CoverageIR.h
new file mode 100644
index 000000000..626d7579d
--- /dev/null
+++ b/FEXCore/Source/Interface/Core/HBX87CoverageIR.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "Interface/Core/HBX87Coverage.h"
+#include "Interface/IR/IREmitter.h"
+#include <FEXCore/Utils/LogManager.h>
+
+namespace FEXCore::HBX87::Coverage {
+// Emit AFTER the x87 instruction's effects: a faulting guest memory access
+// cannot inflate the completed-instruction denominator on a retry. CW was
+// loaded before dispatch, so control-word-changing instructions classify
+// against their actual incoming state.
+template<class Builder>
+void Emit(Builder& B, unsigned opcode, FEXCore::IR::Ref cw, bool pc24) {
+ if (!Enabled()) return;
+ LOGMAN_THROW_A_FMT(Shared != nullptr, "HB x87 coverage storage unavailable");
+ using namespace FEXCore::IR;
+ auto C = [&](uint64_t n) { return B._Constant(static_cast<int64_t>(n)); };
+ auto pc = B._And(OpSize::i64Bit, cw, C(0x300));
+ auto select = [&](Ref value, uint64_t equal, unsigned yes, Ref no) {
+  return B._Select(OpSize::i64Bit, OpSize::i64Bit, CondClass::EQ, value, C(equal), C(yes), no);
+ };
+ auto cls = select(pc, 0, pc24 ? PC24 : DisabledPC24, C(PC53));
+ cls = select(pc, 0x100, ReservedPC, cls);
+ auto masked = B._And(OpSize::i64Bit, cw, C(0x3f));
+ cls = B._Select(OpSize::i64Bit, OpSize::i64Bit, CondClass::NEQ, masked, C(0x3f), C(Unmasked), cls);
+ auto rc = B._And(OpSize::i64Bit, cw, C(0xc00));
+ cls = B._Select(OpSize::i64Bit, OpSize::i64Bit, CondClass::NEQ, rc, C(0), C(RC), cls);
+ cls = select(pc, 0x300, PC64, cls);
+ auto offset = B._Lshl(OpSize::i64Bit, cls, C(3));
+ auto base = C(reinterpret_cast<uintptr_t>(&Shared->instructions[opcode][0]));
+ B._AtomicFetchAdd(OpSize::i64Bit, C(1), B._Add(OpSize::i64Bit, base, offset));
+}
+}
