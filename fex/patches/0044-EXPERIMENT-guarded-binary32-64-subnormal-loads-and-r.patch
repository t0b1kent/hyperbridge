+// SPDX-License-Identifier: MIT
+// Process-local retired converter/arithmetic outcomes; diagnostic gate only.
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#if !defined(_WIN32)
+#include <cstdio>
+#else
+namespace FEX::Windows::Logging { void Raw(const char*); }
+#endif
+
+namespace FEXCore::HBX87::Stats {
+enum Outcome : unsigned {
+ Hit53, Hit24, RejectPC64, RejectRC, RejectUnmasked, RejectReservedPC,
+ RejectDisabledPC24, RejectInputDomain, RejectFPCR, RejectRange, LoadHit, LoadReject,
+ Store32Hit, Store64Hit, StorePC64, StoreRC, StoreUnmasked, StorePC,
+ StoreDomain, StoreRange, StoreRounding, Load32Subnormal, Load64Subnormal,
+ LoadCWChanged, LoadCWRemoved, ClearChanged, ClearRemoved, Count
+};
+inline constexpr const char* Names[Count] = {
+ "arith53", "arith24", "arith_pc64", "arith_rc", "arith_unmasked", "arith_reserved_pc",
+ "arith_pc24_disabled", "arith_domain", "arith_fpcr", "arith_range", "load_hit", "load_reject",
+ "store32_hit", "store64_hit", "store_pc64", "store_rc", "store_unmasked", "store_pc",
+ "store_domain", "store_range", "store_rounding", "load32_subnormal", "load64_subnormal",
+ "fldcw_changed", "fldcw_store_removed", "ie_sf_byte_changed", "ie_sf_byte_store_removed"
+};
+alignas(64) inline uint64_t LocalValues[Count] {};
+inline uint64_t* Values = LocalValues;
+inline std::atomic<bool> Printed {};
+inline bool Gate() {
+ const char* p = std::getenv("MACRUNNER_HB_X87_STATS");
+ return p && p[0] == '1' && !p[1];
+}
+inline void Dump(bool Final = true) {
+ if (!Gate() || (Final && Printed.exchange(true, std::memory_order_relaxed))) return;
+ char line[2048], *p = line;
+ auto Text = [&](const char* q) { while (*q) *p++ = *q++; };
+ auto Num = [&](uint64_t n) {
+  char t[20]; unsigned z = 0;
+  do { t[z++] = char('0' + n % 10); n /= 10; } while (n);
+  while (z) *p++ = t[--z];
+ };
+ Text("[hb-x87-stats-v1]");
+ Text(Final ? " final=1" : " final=0");
+ for (unsigned i = 0; i < Count; ++i) {
+  Text(" "); Text(Names[i]); Text("=");
+  Num(std::atomic_ref<uint64_t>(Values[i]).load(std::memory_order_relaxed));
+ }
+ *p++ = '\n'; *p = 0;
+#if defined(_WIN32)
+ FEX::Windows::Logging::Raw(line);
+#else
+ std::fputs(line, stderr);
+#endif
+}
+inline void ExitDump() { Dump(); }
+inline bool Enabled() {
+ static const bool enabled = [] {
+  if (!Gate()) return false;
+#if !defined(_WIN32)
+  // Called during normal JIT construction, never first initialized in a handler.
+  std::atexit(ExitDump);
+#endif
+  return true;
+ }();
+ return enabled;
+}
