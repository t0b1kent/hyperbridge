+Ref OpDispatchBuilder::SSEIndefiniteResult(IROps IROp, OpSize Size, OpSize ElementSize, Ref Result, Ref Src1, Ref Src2,
+                                          bool Scalar, bool Unary) {
+  switch (IROp) {
+  case OP_VFADD: case OP_VFSUB: case OP_VFMUL: case OP_VFDIV:
+  case OP_VFADDSCALARINSERT: case OP_VFSUBSCALARINSERT: case OP_VFMULSCALARINSERT: case OP_VFDIVSCALARINSERT:
+  case OP_VFSQRT: case OP_VFRSQRT: case OP_VFSQRTSCALARINSERT: case OP_VFRSQRTSCALARINSERT: break;
+  default: return Result;
+  }
+  // MMX/3DNow! and half precision have separate ISA semantics. The scalar
+  // insertion paths carry a full architectural vector, including preserved bits.
+  if (IR::OpSizeAsBits(Size) < 128 || (ElementSize != OpSize::i32Bit && ElementSize != OpSize::i64Bit)) {
+    return Result;
+  }
+  const char* Value = std::getenv("MACRUNNER_FEX_SSE_INDEFINITE");
+  if (!Value || Value[0] != '1' || Value[1]) {
+    return Result;
+  }
+  const bool Single = ElementSize == OpSize::i32Bit;
+  auto AbsMask = _VDupFromGPR(Size, ElementSize, Constant(Single ? 0x7FFFFFFFULL : 0x7FFFFFFFFFFFFFFFULL));
+  auto Infinity = _VDupFromGPR(Size, ElementSize, Constant(Single ? 0x7F800000ULL : 0x7FF0000000000000ULL));
+  auto IsNaN = [&](Ref Input) {
+    return _VCMPGT(Size, ElementSize, _VAnd(Size, Input, AbsMask), Infinity);
+  };
+  // Input NaN payload/sign/priority is a different policy. Only an invalid
+  // arithmetic result from numeric operands selects x86 default indefinite.
+  auto InputsNaN = Unary ? IsNaN(Src2) : _VOr(Size, IsNaN(Src1), IsNaN(Src2));
+  auto Invalid = _VAnd(Size, IsNaN(Result), _VNot(Size, InputsNaN));
+  auto Indefinite = _VDupFromGPR(Size, ElementSize, Constant(Single ? 0xFFC00000ULL : 0xFFF8000000000000ULL));
+  auto Corrected = _VBSL(Size, Invalid, Indefinite, Result);
+  // An inactive scalar lane can contain any bits, including inherited NaNs.
+  // Preserve exactly the merge and VEX zeroing already produced by the ALU op.
+  return Scalar ? _VInsElement(Size, ElementSize, 0, 0, Result, Corrected) : Corrected;
+}
