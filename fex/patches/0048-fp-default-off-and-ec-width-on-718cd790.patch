+Ref OpDispatchBuilder::SSEApplyDAZ(OpSize Size, OpSize ElementSize, Ref Src, Ref MXCSR) {
+  const bool Single = ElementSize == OpSize::i32Bit;
+  auto AbsMask = _VDupFromGPR(Size, ElementSize, Constant(Single ? 0x7FFFFFFFULL : 0x7FFFFFFFFFFFFFFFULL));
+  auto SignMask = _VDupFromGPR(Size, ElementSize, Constant(Single ? 0x80000000ULL : 0x8000000000000000ULL));
+  auto MinNormal = _VDupFromGPR(Size, ElementSize, Constant(Single ? 0x00800000ULL : 0x0010000000000000ULL));
+  auto Tiny = _VCMPGT(Size, ElementSize, MinNormal, _VAnd(Size, Src, AbsMask));
+  auto DAZ = _Bfe(OpSize::i32Bit, 1, 6, MXCSR);
+  auto DAZMask = _VDupFromGPR(Size, ElementSize, _Sub(OpSize::i64Bit, Constant(0), DAZ));
+  return _VBSL(Size, _VAnd(Size, Tiny, DAZMask), _VAnd(Size, Src, SignMask), Src);
+}
+
+Ref OpDispatchBuilder::SSEApplyFTZ(OpSize Size, OpSize ElementSize, Ref Result, Ref MXCSR) {
+  const bool Single = ElementSize == OpSize::i32Bit;
+  auto AbsMask = _VDupFromGPR(Size, ElementSize, Constant(Single ? 0x7FFFFFFFULL : 0x7FFFFFFFFFFFFFFFULL));
+  auto SignMask = _VDupFromGPR(Size, ElementSize, Constant(Single ? 0x80000000ULL : 0x8000000000000000ULL));
+  auto MinNormal = _VDupFromGPR(Size, ElementSize, Constant(Single ? 0x00800000ULL : 0x0010000000000000ULL));
+  auto Tiny = _VCMPGT(Size, ElementSize, MinNormal, _VAnd(Size, Result, AbsMask));
+  auto FTZ = _Bfe(OpSize::i32Bit, 1, 15, MXCSR);
+  auto FTZMask = _VDupFromGPR(Size, ElementSize, _Sub(OpSize::i64Bit, Constant(0), FTZ));
+  return _VBSL(Size, _VAnd(Size, Tiny, FTZMask), _VAnd(Size, Result, SignMask), Result);
+}
