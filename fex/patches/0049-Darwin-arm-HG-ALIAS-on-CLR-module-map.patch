+#ifdef FEX_WINE_DARWIN
+  return FEX::Windows::AliasPolicy::Armed();
+#else
   static const bool On = [] {
     if (!MRAliasViewsOn()) {
       return false;
@@ -65,6 +72,7 @@ bool MRAliasValidateOn() {
     return !(Value && Value[0] == '0' && !Value[1]);
   }();
   return On;
+#endif
 }
 } // namespace
 
