--- a/Source/Windows/Common/Allocator.h
+++ b/Source/Windows/Common/Allocator.h
@@ -7,6 +7,12 @@ void SetupHooks(HMODULE ntdll);
 }
 
 #include <cstdint>
+#include <string_view>
+
+namespace FEX::Windows::AliasPolicy {
+bool Armed();
+void ImageMapped(std::string_view Name);
+}
 
