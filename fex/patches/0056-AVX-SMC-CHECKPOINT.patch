diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
index 4fa1fa855..11f40e155 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
@@ -1182,7 +1182,7 @@ public:
     _StoreContext(Size, Class, Value, Offset);
   }
 
-  void FlushRegisterCache(bool SRAOnly = false, bool MMXOnly = false) {
+  void FlushRegisterCache(bool SRAOnly = false, bool MMXOnly = false, bool FaultBoundary = false) {
     // At block boundaries, fix up the carry flag.
     if (!SRAOnly) {
       RectifyCarryInvert(CFInvertedABI);
@@ -1209,6 +1209,13 @@ public:
       const uint64_t FPRMask = ((1ull << (FPR15Index - FPR0Index + 1)) - 1) << FPR0Index;
 
       Mask &= (GPRMask | FPRMask);
+      if (FaultBoundary) {
+        // Split AVX upper halves have no SRA host-register mapping. An inline
+        // SMC fault restarts the guest instruction from CPUState, so pending
+        // upper halves must reach memory before a faultable instruction.
+        const uint64_t AVXHighMask = ((1ull << (AVXHigh15Index - AVXHigh0Index + 1)) - 1) << AVXHigh0Index;
+        Mask |= AVXHighMask;
+      }
       Bits &= Mask;
     }
 
