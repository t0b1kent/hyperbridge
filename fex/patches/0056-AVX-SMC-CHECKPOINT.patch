+++ b/FEXCore/Source/Interface/Core/Core.cpp
@@ -1025,9 +1025,10 @@ ContextImpl::GenerateIR(FEXCore::Core::InternalThreadState* Thread, uint64_t Gue
         // It is potentially correctness bearing in that sense, but that is a
