+void Arm64Emitter::LoadQPair(ARMEmitter::QRegister First, ARMEmitter::QRegister Second, ARMEmitter::Register Base,
+                           int32_t Offset, bool PostIndex) {
+  if (!EmitterCTX->HasHardwareTSOSupport()) {
+    if (PostIndex) {
+      ldp<ARMEmitter::IndexType::POST>(First, Second, Base, Offset);
+    } else {
+      ldp<ARMEmitter::IndexType::OFFSET>(First, Second, Base, Offset);
+    }
+    return;
+  }
+
+  if (PostIndex) {
+    // Load both values before writeback, including backwards REP copies.
+    ldr(First, Base, 0);
+    ldr(Second, Base, 16);
+    if (Offset >= 0) {
+      add(ARMEmitter::Size::i64Bit, Base, Base, Offset);
+    } else {
+      sub(ARMEmitter::Size::i64Bit, Base, Base, -Offset);
+    }
+  } else if (Offset >= 0) {
+    ldr(First, Base, Offset);
+    ldr(Second, Base, Offset + 16);
+  } else if (Offset >= -256) {
+    ldur(First, Base, Offset);
+    ldur(Second, Base, Offset + 16);
+  } else {
+    // A Q-pair's signed immediate has a wider negative range than LDUR.
+    // These registers are emitter temporaries, never allocated guest GPRs.
+    const auto Address = Base == TMP1.R() ? TMP2 : TMP1;
+    sub(ARMEmitter::Size::i64Bit, Address.R(), Base, -Offset);
+    ldr(First, Address.R(), 0);
+    ldr(Second, Address.R(), 16);
+  }
+}
