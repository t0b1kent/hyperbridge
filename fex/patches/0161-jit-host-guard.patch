 namespace FEXCore::Utils {
 // FEX assumes an operating page size of 4096
@@ -9,4 +10,20 @@ namespace FEXCore::Utils {
 constexpr size_t FEX_PAGE_SIZE = 4096;
 constexpr size_t FEX_PAGE_SHIFT = 12;
 constexpr size_t FEX_PAGE_MASK = ~(FEX_PAGE_SIZE - 1);
+
+// Guest pages stay 4 KiB. A JIT overflow guard must occupy a complete host
+// protection page: Wine cannot make one 4 KiB subpage inaccessible while its
+// 16 KiB Darwin neighbours remain writable. The gate is initialized by buffer
+// allocation, before the signal path can read it; no signal-time getenv/init.
+inline size_t JITGuardPageSize() {
+#if defined(FEX_WINE_DARWIN) || (defined(__APPLE__) && defined(ARCHITECTURE_arm64))
+  static const bool HostGuard = [] {
+    const char* Value = std::getenv("MACRUNNER_HB_JIT_HOST_GUARD");
+    return Value && Value[0] == '1' && !Value[1];
+  }();
+  return HostGuard ? 16384 : FEX_PAGE_SIZE;
+#else
+  return FEX_PAGE_SIZE;
+#endif
+}
 } // namespace FEXCore::Utils
