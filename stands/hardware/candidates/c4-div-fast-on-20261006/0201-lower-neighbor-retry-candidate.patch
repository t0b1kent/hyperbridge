+// Once upper is committed, retry only lower on nonoperand container conflicts.
+// Does not establish atomicity against accesses to guest operand bits.
+template<typename T>
+static bool StoreLowerPreservingNeighbors(T& Expected, T Desired, uint64_t Addr, T GuestMask,
+                                          bool (*Store)(T&, T, uint64_t)) {
+  const T OriginalGuestBits = Expected & GuestMask;
+  while (true) {
+    if (Store(Expected, Desired, Addr)) return true;
+    if ((Expected & GuestMask) != OriginalGuestBits) return false;
+    Desired = (Desired & GuestMask) | (Expected & static_cast<T>(~GuestMask));
+  }
+}
