diff --git a/FEXCore/Source/Interface/Core/ArchHelpers/HardwareScalarMerge.h b/FEXCore/Source/Interface/Core/ArchHelpers/HardwareScalarMerge.h
new file mode 100644
--- /dev/null
+++ b/FEXCore/Source/Interface/Core/ArchHelpers/HardwareScalarMerge.h
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: MIT
+// Modifications (c) 2026 MacRunner contributors, MIT
+#pragma once
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+namespace FEXCore::CPU {
+inline bool HardwareScalarMergeRequested() {
+  const auto Value = std::getenv("MACRUNNER_FEX_HW_SCALAR_MERGE");
+  return Value && std::strcmp(Value, "1") == 0;
+}
+
+#if defined(__aarch64__) || defined(__arm64ec__) || defined(_M_ARM64) || defined(_M_ARM64EC)
+struct alignas(16) ScalarMergeProbeVector { uint64_t Lo, Hi; };
+
+#define MR_SCALAR_MERGE_PROBE(Op, Type, D) \
+  asm volatile("ldr q0, [%1]\n\tldr q1, [%2]\n\t" Op " " Type #D ", " Type "0, " Type "1\n\tstr q" #D ", [%0]" \
+    : : "r"(&Result), "r"(&A), "r"(&B) : "v0", "v1", "v2", "memory")
+#define MR_SCALAR_MERGE_OPERATION(Name, Op) \
+  inline void Name(bool Wide, unsigned Alias, const ScalarMergeProbeVector& A, \
+                   const ScalarMergeProbeVector& B, ScalarMergeProbeVector& Result) { \
+    if (Wide) { \
+      if (Alias == 0) { MR_SCALAR_MERGE_PROBE(Op, "d", 2); } \
+      else if (Alias == 1) { MR_SCALAR_MERGE_PROBE(Op, "d", 0); } \
+      else { MR_SCALAR_MERGE_PROBE(Op, "d", 1); } \
+    } else { \
+      if (Alias == 0) { MR_SCALAR_MERGE_PROBE(Op, "s", 2); } \
+      else if (Alias == 1) { MR_SCALAR_MERGE_PROBE(Op, "s", 0); } \
+      else { MR_SCALAR_MERGE_PROBE(Op, "s", 1); } \
+    } \
+  }
+MR_SCALAR_MERGE_OPERATION(ProbeScalarMergeAdd, "fadd")
+MR_SCALAR_MERGE_OPERATION(ProbeScalarMergeSub, "fsub")
+MR_SCALAR_MERGE_OPERATION(ProbeScalarMergeMul, "fmul")
+MR_SCALAR_MERGE_OPERATION(ProbeScalarMergeDiv, "fdiv")
+#undef MR_SCALAR_MERGE_OPERATION
+#undef MR_SCALAR_MERGE_PROBE
+#endif
+
+// Does not enable a host mode or change FPCR/AFPCR. Called on the newly created
+// backend's thread, after Wine's HardwareTSOThreadEnter, before guest execution.
+// Check all four operations, both widths and all destination aliases. Ordinary
+// AArch64/AFP semantics fail this test and retain the existing emitter path.
+inline bool ProbeHardwareScalarMerge() {
+#if defined(__aarch64__) || defined(__arm64ec__) || defined(_M_ARM64) || defined(_M_ARM64EC)
+  uint64_t SavedFPSR;
+  asm volatile("mrs %0, fpsr" : "=r"(SavedFPSR));
+  using Probe = void (*)(bool, unsigned, const ScalarMergeProbeVector&, const ScalarMergeProbeVector&, ScalarMergeProbeVector&);
+  constexpr Probe Operations[] = {ProbeScalarMergeAdd, ProbeScalarMergeSub, ProbeScalarMergeMul, ProbeScalarMergeDiv};
+  constexpr uint64_t Finite32[] = {0x40400000, 0x3f800000, 0x40000000, 0x40000000};
+  constexpr uint64_t Finite64[] = {0x4008000000000000ULL, 0x3ff0000000000000ULL, 0x4000000000000000ULL, 0x4000000000000000ULL};
+  bool Passed = true;
+  for (unsigned Width = 0; Width != 2; ++Width) {
+    const bool Wide = Width != 0;
+    const uint64_t Mask = Wide ? ~0ULL : 0xffffffffULL;
+    const uint64_t Quiet = Wide ? 0x0008000000000000ULL : 0x00400000;
+    for (unsigned Case = 0; Case != 3; ++Case) {
+      const uint64_t AScalar = Case == 0 ? (Wide ? 0x4000000000000000ULL : 0x40000000) :
+        Case == 1 ? (Wide ? 0x7ff8000000001234ULL : 0x7fc01234) : (Wide ? 0xfff0000000005678ULL : 0xff805678);
+      const uint64_t BScalar = Case == 0 ? (Wide ? 0x3ff0000000000000ULL : 0x3f800000) :
+        Case == 1 ? (Wide ? 0xfff0000000009abcULL : 0xff809abc) : (Wide ? 0x7ff800000000def0ULL : 0x7fc0def0);
+      const ScalarMergeProbeVector A {AScalar | (Wide ? 0 : 0xa1a2a3a400000000ULL), 0xa5a6a7a8a9aaabacULL};
+      const ScalarMergeProbeVector B {BScalar | (Wide ? 0 : 0xb1b2b3b400000000ULL), 0xb5b6b7b8b9babbbcULL};
+      for (unsigned Op = 0; Op != 4; ++Op) {
+        const uint64_t Low = Case == 0 ? (Wide ? Finite64[Op] : Finite32[Op]) : (AScalar | Quiet);
+        const uint64_t Expected = (A.Lo & ~Mask) | Low;
+        for (unsigned Alias = 0; Alias != 3; ++Alias) {
+          ScalarMergeProbeVector Result {};
+          Operations[Op](Wide, Alias, A, B, Result);
+          Passed &= Result.Lo == Expected && Result.Hi == A.Hi;
+        }
+      }
+    }
+  }
+  asm volatile("msr fpsr, %0" : : "r"(SavedFPSR));
+  return Passed;
+#else
+  return false;
+#endif
+}
+}
