diff --git a/FEXCore/include/FEXCore/Core/X87Region.h b/FEXCore/include/FEXCore/Core/X87Region.h
--- /dev/null
+++ b/FEXCore/include/FEXCore/Core/X87Region.h
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: MIT
+// Modifications (c) 2026 MacRunner contributors, MIT
+#pragma once
+#include <bit>
+#include <cstdint>
+#include <FEXCore/Utils/CompilerDefs.h>
+
+namespace FEXCore::Core {
+struct CpuStateFrame;
+namespace X87Region {
+enum class Format : uint8_t { Binary53 = 1, Binary24 = 2 };
+enum class Status : uint8_t { Empty, Present, Failed };
+inline constexpr uint32_t Magic = 0x52373858; // X87R, immutable JIT-tail extension.
+inline constexpr uint16_t Version = 2;
+inline constexpr uint8_t TailMarker = 0x87;
+inline constexpr uint32_t MaxRecipes = 256;
+enum Control : uint8_t { CompleteDec32 = 1, CounterCommitted = 2, KeepEntryFlagsIfInitial = 4 };
+struct Header {
+  uint32_t MagicValue;
+  uint16_t VersionValue;
+  uint16_t RecordBytes;
+  uint32_t Count;
+  uint32_t Bytes;
+};
+struct Recipe {
+  uint32_t HostBegin;
+  uint32_t HostEnd;
+  uint64_t GuestRIP;
+  uint8_t LogicalSlotMask;
+  Format Precision;
+  uint8_t HostQForSlot[8];
+  uint8_t CounterGuest;
+  uint8_t CounterHost;
+  uint8_t CarryHost; // NZCVSelect(UGE), the inverted guest CF, before DEC.
+  uint8_t Controls;
+  uint8_t InitialCounterHost;
+  uint8_t Reserved;
+};
+static_assert(sizeof(Header) == 16 && sizeof(Recipe) == 32);
+struct Raw80 { uint64_t Significand, SignExponent; };
+enum class Arithmetic : uint8_t { Add, Sub, Mul, Div, Sqrt };
+struct GuardRequest {
+  uint32_t Iterations;
+  uint32_t FPCR;
+  Arithmetic Op;
+  uint8_t SourceA, SourceB, Destination;
+};
+struct GuardValues {
+  uint64_t BitsA, BitsB;
+  Format Precision;
+};
+// Entry-only integer proof for every remaining iteration of a register loop.
+// Failure leaves both canonical state and output unchanged.
+FEX_DEFAULT_VISIBILITY bool Guard(const CpuStateFrame* Frame, const GuardRequest* Request,
+    GuardValues* Values) noexcept;
+struct Recovery {
+  Status State {Status::Empty};
+  uint64_t GuestRIP {};
+  uint32_t EFlagsMask {};
+  uint32_t EFlagsValue {};
+  bool CanonicalResume {};
+};
+
+// Integer-only exact widening, including signed zero and every finite subnormal.
+// No host FP operation, allocation, rounding, logger, or lazy initialization.
+inline bool Widen(uint64_t Bits, Format Precision, Raw80& Out) noexcept {
+  if (Precision != Format::Binary53 && Precision != Format::Binary24) return false;
+  const bool Wide = Precision == Format::Binary53;
+  const unsigned FractionBits = Wide ? 52 : 23;
+  const unsigned ExponentBits = Wide ? 11 : 8;
+  const unsigned Bias = Wide ? 1023 : 127;
+  if (!Wide) Bits &= 0xffffffffULL;
+  const uint64_t Fraction = Bits & ((uint64_t {1} << FractionBits) - 1);
+  const uint64_t Exponent = (Bits >> FractionBits) & ((uint64_t {1} << ExponentBits) - 1);
+  const uint64_t Sign = ((Bits >> (FractionBits + ExponentBits)) & 1) << 15;
+  if (Exponent == ((uint64_t {1} << ExponentBits) - 1)) return false;
+  if (Exponent) {
+    Out = {((uint64_t {1} << FractionBits) | Fraction) << (63 - FractionBits),
+           Sign | (Exponent + 16383 - Bias)};
+  } else if (Fraction) {
+    const unsigned TopBit = 63 - std::countl_zero(Fraction);
+    Out = {Fraction << (63 - TopBit), Sign | uint64_t(16383 + 1 - int(Bias) - int(FractionBits) + int(TopBit))};
+  } else {
+    Out = {0, Sign};
+  }
+  return true;
+}
+
+// Called after ordinary SRA/EFLAGS reconstruction and before exporting context.
+// PRESENT requires resumption through canonical dispatcher state, never HostPC.
+FEX_DEFAULT_VISIBILITY Recovery Materialize(CpuStateFrame* Frame, uint64_t HostPC,
+    const uint64_t* HostGPRs, const __uint128_t* HostQ) noexcept;
+}
+}
