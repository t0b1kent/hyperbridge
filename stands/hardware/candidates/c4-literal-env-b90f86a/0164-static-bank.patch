+// SPDX-License-Identifier: MIT
+// Persistent PE32 approximation is separate from the exact x87 region.
+#pragma once
+#include <FEXCore/Core/X87Region.h>
+
+namespace FEXCore::Core::X87Static {
+using X87Region::Format;
+using X87Region::Raw80;
+// Exact admission of a stored 80-bit value to a binary format. FILD m64 and
+// m80 values with additional significand bits remain on the precise path.
+inline bool Narrow(Raw80 In, Format Precision, uint64_t& Out) noexcept {
+  if ((Precision != Format::Binary53 && Precision != Format::Binary24) || In.SignExponent > 0xffff) return false;
+  const unsigned F = Precision == Format::Binary53 ? 52 : 23;
+  const unsigned Bias = Precision == Format::Binary53 ? 1023 : 127;
+  const unsigned E = In.SignExponent & 0x7fff;
+  const uint64_t Sign = (In.SignExponent >> 15) << (F + (F == 52 ? 11 : 8));
+  if (!E && !In.Significand) { Out = Sign; return true; }
+  if (!E || E == 0x7fff || !(In.Significand >> 63)) return false;
+  const int Power = int(E) - 16383;
+  if (Power > int(Bias) || Power < 1 - int(Bias) - int(F)) return false;
+  const unsigned Shift = Power >= 1 - int(Bias) ? 63 - F : unsigned(63 - F + 1 - int(Bias) - Power);
+  if (Shift >= 64 || (In.Significand & ((uint64_t{1} << Shift) - 1))) return false;
+  const uint64_t Sig = In.Significand >> Shift;
+  Out = Sign | (Power >= 1 - int(Bias) ? (uint64_t(Power + int(Bias)) << F) | (Sig & ((uint64_t{1} << F) - 1)) : Sig);
+  return true;
+}
+// Unlike the exact region, approximation must export IEEE overflow/NaN.
+// This is representation conversion, without any host FP or rounding.
+inline bool WidenIEEE(uint64_t Bits, Format Precision, Raw80& Out) noexcept {
+  if (Precision != Format::Binary53 && Precision != Format::Binary24) return false;
+  const unsigned F = Precision == Format::Binary53 ? 52 : 23;
+  const unsigned E = F == 52 ? 11 : 8;
+  const uint64_t MaxE = (uint64_t{1} << E) - 1;
+  if (((Bits >> F) & MaxE) != MaxE) return X87Region::Widen(Bits, Precision, Out);
+  const uint64_t Fraction = Bits & ((uint64_t{1} << F) - 1);
+  Out = {(uint64_t{1} << 63) | (Fraction << (63 - F)), 0x7fff | (((Bits >> (F + E)) & 1) << 15)};
+  return true;
+}
+FEX_DEFAULT_VISIBILITY bool Prepare(CpuStateFrame* Frame, const X87Region::GuardRequest* Request,
+    X87Region::GuardValues* Values) noexcept;
+// HostQ is an exception snapshot, not an assumed live ABI register bank.
+// All validation completes before any state is committed.
+FEX_DEFAULT_VISIBILITY bool MaterializeHost(CpuStateFrame* Frame, const __uint128_t* HostQ) noexcept;
+}
