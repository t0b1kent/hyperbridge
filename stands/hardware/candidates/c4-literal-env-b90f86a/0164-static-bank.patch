+  ldr(TMP2.W(), TMP1, offsetof(Thread::X87StaticCache, SavedFPSR)); msr(ARMEmitter::SystemRegister::FPSR, TMP2);
+  ldr(TMP2, ARMEmitter::Reg::rsp, 32); str(TMP2, TMP1, offsetof(Thread::X87StaticCache, SavedNZCV));
+  mov(Size::i64Bit, TMP2, 1); strb(TMP2, TMP1, offsetof(Thread::X87StaticCache, FlushActive));
+  for (unsigned Slot = 0; Slot < 8; ++Slot) str(ARMEmitter::VRegister(24 + Slot).D(), TMP1, Slot * 8);
+  ldrb(TMP2, TMP1, offsetof(Thread::X87StaticCache, Precision));
