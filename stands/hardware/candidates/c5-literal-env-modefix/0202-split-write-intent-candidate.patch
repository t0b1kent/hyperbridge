+// 0202: establish host write intent on both split containers before committing
+// any guest bits, including a compare mismatch. Each CAS writes its observed
+// value only; a fault handler or competing writer changing it forces a reload.
+// This covers stable host permissions and native-PC continuation. Guest 4KiB
+// permission accounting and concurrent permission revocation belong to frontend.
+template<typename T>
+static void ValidateSplitWriteIntent(uint64_t Lower, uint64_t Upper, T (*Load)(uint64_t), bool (*Store)(T&, T, uint64_t)) {
+  while (true) {
+    T ActualUpper = Load(Upper);
+    T ActualLower = Load(Lower);
+    T ExpectedUpper = ActualUpper;
+    if (!Store(ExpectedUpper, ActualUpper, Upper)) continue;
+    T ExpectedLower = ActualLower;
+    if (!Store(ExpectedLower, ActualLower, Lower)) continue;
+    return;
+  }
+}
