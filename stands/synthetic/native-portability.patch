-#ifndef _WIN32
+#if defined(__APPLE__)
+// macOS oracle: родной путь W^X Apple Silicon. Поток живёт в режиме «исполнять»,
+// запись в MAP_JIT открывается только внутри скобки. Глубина — потоковый счётчик
+// (вложенные скобки ExitFunctionLink -> CompileBlock не закрывают внешнюю).
+static thread_local uint32_t MacJITWriteDepth = 0;
+void JITWriteThreadInit() {
+  MacJITWriteDepth = 0;
+  pthread_jit_write_protect_np(1);
+}
+void JITWriteEnter() {
+  if (MacJITWriteDepth++ == 0) {
+    pthread_jit_write_protect_np(0);
+  }
+}
+void JITWriteLeave() {
+  if (MacJITWriteDepth == 0) {
+    ERROR_AND_DIE_FMT("JITWriteLeave at depth 0");
+  }
+  if (--MacJITWriteDepth == 0) {
+    pthread_jit_write_protect_np(1);
+  }
+}
+void JITWriteResetForResume(bool WantExec) {
+  if (WantExec) {
+    MacJITWriteDepth = 0;
+    pthread_jit_write_protect_np(1);
+  } else {
+    pthread_jit_write_protect_np(0);
+  }
+}
+uint32_t JITWriteCurrentDepth() {
+  return MacJITWriteDepth;
+}
+#elif !defined(_WIN32)
