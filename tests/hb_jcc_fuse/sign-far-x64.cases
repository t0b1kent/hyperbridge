# ДАЛЬНИЕ знаковые переходы — лейн ФЛАГИ-ЖИВОСТЬ, 07.09.2026.
#
# ЗАЧЕМ ОТДЕЛЬНО. Все семь прежних корпусов используют КОРОТКИЙ Jcc (rel8), то есть
# смещение всегда укладывается в ±4095 и длинный путь `emit_reg_sign_set_pc` (отложенный
# TBZ/TBNZ + заплата) ими НЕ ПРОХОДИТСЯ ВООБЩЕ. Именно там живёт единственная опасность
# формы: у TBZ/TBNZ поле imm14 (−32 768 … +32 764), в тридцать два раза короче, чем у
# B.cond. Корпус без дальних переходов на этот класс слеп.
#
# Здесь `0f 8x rel32` — БЛИЖНИЙ Jcc x86 с 32-битным смещением, вперёд и назад,
# на 64 КиБ и на 1 МиБ, все четыре ширины производителя, JS и JNS.
# Формат: <зерно> <байты-hex>
#
# cmp rax,rcx ; js  +0x10000
0x1 4839c80f8800000100
0xdeadbeef 4839c80f8800000100
# cmp rax,rcx ; jns +0x10000
0x1 4839c80f8900000100
0xdeadbeef 4839c80f8900000100
# cmp rax,rcx ; js  -0x10000
0x1 4839c80f8800000fff
0xdeadbeef 4839c80f8800000fff
# cmp rax,rcx ; jns -0x10000
0x1 4839c80f8900000fff
0xdeadbeef 4839c80f8900000fff
# cmp eax,ecx ; js  +0x100000
0x1 39c80f8800001000
0xdeadbeef 39c80f8800001000
# cmp eax,ecx ; jns +0x100000
0x1 39c80f8900001000
0xdeadbeef 39c80f8900001000
# cmp al,cl ; js +0x10000
0x1 38c80f8800000100
0xdeadbeef 38c80f8800000100
# cmp al,cl ; jns +0x10000
0x1 38c80f8900000100
0xdeadbeef 38c80f8900000100
# test rax,rcx ; js +0x10000
0x1 4885c80f8800000100
0xdeadbeef 4885c80f8800000100
# test rax,rcx ; jns +0x10000
0x1 4885c80f8900000100
0xdeadbeef 4885c80f8900000100
# test eax,eax ; js +0x10000
0x1 85c00f8800000100
0xdeadbeef 85c00f8800000100
